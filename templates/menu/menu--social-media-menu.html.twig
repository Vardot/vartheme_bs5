{#
/**
 * Template for the main menu.
 */
#}
{# Core strips hx-* from menu link content, so the copy-link handler is added here. #}
{% set copied = 'Link copied'|t|e('js') %}
{% set menu_items = {} %}
{% for key, item in items %}
  {% if 'copy-link' in (item.url.options.attributes.class ?? []) %}
    {{ attach_library('core/drupal.htmx') }}
    {{ attach_library('core/drupal.announce') }}
    {% set item = item|merge({link_attributes: {
      'hx-on:click': "event.preventDefault(); navigator.clipboard.writeText(window.location.href).then(() => { this.classList.add('is-copied'); Drupal.announce('" ~ copied ~ "'); })",
      'hx-on:keydown': "if (event.key === ' ') { event.preventDefault(); this.click(); }",
    }}) %}
  {% endif %}
  {% set menu_items = menu_items|merge({(key): item}) %}
{% endfor %}
{% include 'vartheme_bs5:nav-menu' with {items: menu_items} %}
