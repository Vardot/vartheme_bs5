{% apply spaceless %}
{% if rows is iterable %}
  {% if title %}
    {{
      include('vartheme_bs5:heading', {
        html_tag: 'h3',
        content: title
      }, with_context = false)
    }}
  {% endif %}

  {{
    include('vartheme_bs5:list', {
      type: type,
      attributes: attributes,
      items: rows,
      list_utility_classes: list_utility_classes,
      list_item_utility_classes: list_item_utility_classes
    }, with_context = false)
  }}
{% endif %}
{% endapply %}
