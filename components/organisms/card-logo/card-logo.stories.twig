{% stories CardLogo with {
  title: 'Card/Card Logo',
  parameters: {
    componentSubtitle: 'Bootstrap logo card with optional full-card link',
    docs: {
      description: {
        component: 'Use this component to render a logo inside a simple card with an optional stretched link.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    media: {
      name: 'Logo image',
      control: 'object',
    },
    url: {
      name: 'Link URL',
      control: 'text',
    },
    shadow: {
      name: 'Shadow',
      control: 'select',
      options: {
        "'No shadow'": 'shadow-none',
        "'Small shadow'": 'shadow-sm',
        "'Default shadow'": 'shadow',
        "'Large shadow'": 'shadow-lg',
      },
    },
  },
} %}

{% story DefaultLogoCard with {
  name: 'Default logo card',
  args: {
    media: {
      src: 'assets/logo-placeholder.svg',
      alt: 'Placeholder brand logo',
      width: '600',
      height: '240',
    },
    url: '',
    shadow: 'shadow',
  },
} %}
{{ include('vartheme_bs5:card-logo') }}
{% endstory %}

{% story LinkedLogoCard with {
  name: 'Linked logo card',
  args: {
    media: {
      src: 'assets/logo-placeholder.svg',
      alt: 'Partner logo',
      width: '600',
      height: '240',
    },
    url: 'https://example.com',
    shadow: 'shadow-sm',
  },
} %}
{{ include('vartheme_bs5:card-logo') }}
{% endstory %}

{% story LargeShadowCard with {
  name: 'Large shadow',
  args: {
    media: {
      src: 'assets/logo-placeholder.svg',
      alt: 'Featured brand logo',
      width: '600',
      height: '240',
    },
    url: '',
    shadow: 'shadow-lg',
  },
} %}
{{ include('vartheme_bs5:card-logo') }}
{% endstory %}

{% endstories %}
