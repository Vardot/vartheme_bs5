{% stories CardLogo with {
  title: 'Cards/Card Logo',
  parameters: {
    componentSubtitle: 'Bootstrap logo card with optional full-card link and shadow variants.',
    docs: {
      description: {
        component: 'A simple logo card component for brand, partner, sponsor, and client logos with optional full-card link behavior.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    media: {
      name: 'Logo image',
      description: 'Logo image displayed in the card.',
      control: 'object',
    },
    url: {
      name: 'Link URL',
      description: 'If provided, the whole card becomes clickable.',
      control: 'text',
    },
    shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility class.',
      control: 'select',
      options: {
        "'No shadow'": 'shadow-none',
        "'Small shadow'": 'shadow-sm',
        Default: 'shadow',
        "'Large shadow'": 'shadow-lg',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    media: {
      src: '/components/organisms/card-logo/assets/logo-placeholder.svg',
      alt: 'Placeholder brand logo',
      width: 600,
      height: 240,
    },
    url: '',
    shadow: 'shadow',
  },
} %}
  {{ include('vartheme_bs5:card-logo') }}
{% endstory %}

