{% stories CardLogo with {
  title: 'Cards/Card Logo',
  parameters: {
    componentSubtitle: 'Bootstrap logo card with optional full-card link, shadow, and alignment options.',
    docs: {
      description: {
        component: 'A simple logo card component for brand, partner, sponsor, and client logos with optional full-card link behavior.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    media: {
      name: 'Logo image',
      description: 'Logo image displayed in the card.',
      control: 'object',
    },
    url: {
      name: 'Link URL',
      description: 'If provided, the whole card becomes clickable.',
      control: 'text',
    },
    shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility class.',
      control: 'select',
      options: {
        "'No shadow'": 'shadow-none',
        "'Small shadow'": 'shadow-sm',
        Default: 'shadow',
        "'Large shadow'": 'shadow-lg',
      },
    },
    alignment: {
      name: 'Alignment',
      description: 'Horizontal alignment of the logo.',
      control: 'select',
      options: {
        Left: 'left',
        Center: 'center',
        Right: 'right',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    media: {
      src: '/components/foundation/images/assets/full-logo-dark.svg',
      alt: 'Placeholder brand logo',
      width: 600,
      height: 240,
    },
    url: '',
    shadow: 'shadow-none',
    alignment: 'left',
  },
} %}
  {{ include('vartheme_bs5:card-logo') }}
{% endstory %}

