{#
  Bootstrap 5 Logo Card
#}

{% set has_url = url is defined and url is not empty and url != 'No URL' %}
{% set shadow_class = shadow|default('shadow-none') %}

{% set alignment_map = { left: 'justify-content-start', center: 'justify-content-center', right: 'justify-content-end' } %}
{% set alignment_class = alignment_map[alignment|default('left')]|default('justify-content-start') %}

{% set src_value = '' %}
{% if media is defined and media %}
  {% if media.src is defined and media.src %}
    {% if media.src is iterable %}
      {% set src_value = media.src.url|default(media.src.uri|default(media.src.value|default(''))) %}
    {% else %}
      {% set src_value = media.src %}
    {% endif %}
  {% elseif media.url is defined and media.url %}
    {% set src_value = media.url %}
  {% endif %}
{% endif %}
{% set media_ok = src_value is not empty %}

{% set image_media = {
  src: src_value,
  alt: media.alt|default(''),
  width: media.width is defined and media.width is not empty ? media.width : null,
  height: media.height is defined and media.height is not empty ? media.height : null,
} %}

{% set card_classes = ['card', 'overflow-hidden', 'border-0', 'bg-transparent'] %}
{% if shadow_class and shadow_class != 'shadow-none' %}
  {% set card_classes = card_classes|merge([shadow_class]) %}
{% endif %}
{% if has_url %}
  {% set card_classes = card_classes|merge(['position-relative']) %}
{% endif %}

{% set body_classes = ['card-body', 'd-flex', 'align-items-center', alignment_class, 'p-0'] %}
{% set image_wrapper_classes = ['d-flex', alignment_class, 'align-items-center'] %}
{% set link_classes = ['stretched-link', 'text-decoration-none'] %}

{% set card_attributes = create_attribute().addClass(card_classes) %}
{% set body_attributes = create_attribute().addClass(body_classes) %}
{% set image_wrapper_attributes = create_attribute().addClass(image_wrapper_classes) %}

<div{{ card_attributes }}>
  <div{{ body_attributes }}>
    {% if has_url %}
      {% set _link_accessible_label = image_media.alt|default('')|trim %}
      {{ include('vartheme_bs5:link', {
        url: url,
        attributes: create_attribute().addClass(link_classes).setAttribute('aria-label', _link_accessible_label),
        content: '',
      }, with_context: false) }}
    {% endif %}

    {% if media_ok %}
      <div{{ image_wrapper_attributes }}>
        {{ include('vartheme_bs5:image', {
          media: image_media,
          ratio: 'ratio-auto',
          fit: 'object-fit-contain',
          width: 'w-100',
        }, false, true) }}
      </div>
    {% endif %}
  </div>
</div>
