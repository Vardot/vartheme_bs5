{#
  Impressed Card
  - Stacked layout (media top/bottom)
  - Two drag & drop slots: overlay (image overlay), content
  - Media uses the "media_image" prop
#}

{% set media_position = media_position ?? 'top' %}
{% set card_border = card_border|default(false) %}
{% set padded = padded|default(false) %}
{% set equal_height = equal_height|default(false) %}
{% set box_shadow = box_shadow|default('shadow-none') %}
{% set background_color = background_color|default('bg-transparent') %}
{% set corner_style = corner_style|default('rounded-0') %}

{% set stretched_link = stretched_link|default(false) %}

{% set link_url = link_url|default('')|trim %}
{% set link_target_raw = link_target|default('default') %}
{% set link_target = (link_target_raw == 'default') ? '_self' : link_target_raw %}

{% set media_image = media_image|default({}) %}
{% set ratio = ratio|default('ratio-16x9') %}
{% set fit = fit|default('object-fit-cover') %}
{% set has_media = (media_image.src|default('')|trim) is not empty %}

{% set card_impressed_media_utility_classes = card_impressed_media_utility_classes|default([]) %}
{% set overlay_slot %}{% block overlay %}{% endblock %}{% endset %}
{% set content_slot %}{% block content %}{% endblock %}{% endset %}
{% set has_overlay_slot = overlay_slot|render|trim is not empty %}
{% set has_content_slot = content_slot|render|trim is not empty %}

{% set placeholder_src = (component_metadata.path is defined)
  ? (base_path|default('/') ~ component_metadata.path ~ '/assets/impressed-card-image-placeholder.svg')
  : (base_path|default('/') ~ 'themes/contrib/vartheme_bs5/components/organisms/card-impressed/assets/impressed-card-image-placeholder.svg')
%}

{% set render_media = has_media or has_overlay_slot %}
{% set media_image_render = has_media
  ? media_image
  : {
    src: placeholder_src,
    alt: '',
    width: 800,
    height: 600,
  }
%}

{% set use_stretched_link = stretched_link and (link_url is not empty) %}
{% set media_position_classes = (media_position == 'bottom') ? ['flex-column-reverse'] : [] %}

{% set card_attributes = create_attribute().addClass([
  'card',
  'd-flex',
  'flex-column',
  'overflow-hidden',
  'position-relative',
  background_color,
  (card_border ? corner_style : ''),
  (card_border ? 'border' : 'border-0'),
  box_shadow,
  (use_stretched_link ? 'position-relative' : ''),
  (equal_height ? 'h-100' : ''),
]|merge(media_position_classes)|filter(v => v is not empty)) %}

{% set media_attributes = create_attribute().addClass([
  'card-img',
  'card-img-' ~ media_position,
  'position-relative',
  (not card_border ? corner_style : ''),
  (not card_border ? 'overflow-hidden' : ''),
]|merge(card_impressed_media_utility_classes)|filter(v => v is not empty)) %}

{% set card_body_attributes = create_attribute().addClass([
  'card-body',
  'd-flex',
  'flex-column',
  'gap-3',
  (padded ? 'p-4' : 'py-3 px-0'),
]|filter(v => v is not empty)) %}

{% set overlay_slot_attributes = create_attribute().addClass([
  'position-absolute',
  'top-0',
  'start-0',
  'z-3',
  'm-3',
  'd-flex',
  'align-items-center',
  'w-25',
  'mw-100',
]|filter(v => v is not empty)) %}

{% set image_payload = {
  media: {
    src: media_image_render.src|default(''),
    alt: media_image_render.alt|default(''),
    width: media_image_render.width|default(null),
    height: media_image_render.height|default(null),
  },
  ratio: ratio,
  width: 'w-100',
  fit: fit,
  extra_classes: ['d-block', 'img-fluid', 'w-100', ('card-img-' ~ media_position)]|join(' '),
  loading: media_image_render.loading|default('lazy'),
  sizes: media_image_render.sizes|default(''),
} %}

{% set media_markup %}
  {% if render_media %}
    <div{{ media_attributes }}>
      {{ include('vartheme_bs5:image', image_payload, false, true) }}
      {% if has_overlay_slot %}
        <div{{ overlay_slot_attributes }}>
          {{ overlay_slot }}
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endset %}

{% set content_markup %}
  <div{{ card_body_attributes }}>
    {% if has_content_slot %}
      {{ content_slot }}
    {% else %}
      <div class="text-muted small py-3 pe-none">Drop content here</div>
    {% endif %}
  </div>
{% endset %}

<div{{ card_attributes }}>
  {{ media_markup }}
  {{ content_markup }}

  {% if use_stretched_link %}
    {% set _link_accessible_label = content_slot|striptags|trim %}
    {{ include('vartheme_bs5:link', {
      url: link_url,
      target: link_target,
      attributes: create_attribute().setAttribute('aria-label', _link_accessible_label),
      content: '',
      link_utility_classes: ['stretched-link'],
    }) }}
  {% endif %}
</div>
