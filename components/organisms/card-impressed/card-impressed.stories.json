{
  "title": "Cards/Impressed Card",
  "parameters": {
    "componentSubtitle": "Stacked card with optional media (top/bottom) and a single content slot.",
    "docs": {
      "description": {
        "component": "Impressed Card is a Bootstrap 5 card layout with an optional media area rendered through the image component. Use utility-class props to control border, padding, background, rounding, and shadows."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "media_position": {
      "control": {
        "type": "select"
      },
      "options": [
        "top",
        "bottom"
      ]
    },
    "media_image": {
      "control": {
        "type": "object"
      }
    },
    "ratio": {
      "control": {
        "type": "select"
      },
      "options": [
        "ratio-auto",
        "ratio-16x9",
        "ratio-4x3",
        "ratio-1x1",
        "ratio-21x9"
      ]
    },
    "fit": {
      "control": {
        "type": "select"
      },
      "options": [
        "object-fit-cover",
        "object-fit-contain"
      ]
    },
    "card_border": {
      "control": {
        "type": "boolean"
      }
    },
    "background_color": {
      "control": {
        "type": "select"
      },
      "options": [
        "bg-transparent",
        "bg-body",
        "bg-body-tertiary",
        "bg-white",
        "bg-light",
        "bg-dark",
        "bg-primary",
        "bg-secondary",
        "bg-success",
        "bg-danger",
        "bg-warning",
        "bg-info"
      ]
    },
    "padded": {
      "control": {
        "type": "boolean"
      }
    },
    "box_shadow": {
      "control": {
        "type": "select"
      },
      "options": [
        "shadow-none",
        "shadow-sm",
        "shadow",
        "shadow-lg"
      ]
    },
    "corner_style": {
      "control": {
        "type": "select"
      },
      "options": [
        "rounded-0",
        "rounded-1",
        "rounded-3",
        "rounded-pill"
      ]
    },
    "equal_height": {
      "control": {
        "type": "boolean"
      }
    },
    "stretched_link": {
      "control": {
        "type": "boolean"
      }
    },
    "link_url": {
      "control": {
        "type": "text"
      }
    },
    "link_target": {
      "control": {
        "type": "select"
      },
      "options": [
        "default",
        "_self",
        "_blank"
      ]
    }
  },
  "stories": [
    {
      "name": "Default",
      "args": {
        "media_position": "top",
        "ratio": "ratio-16x9",
        "fit": "object-fit-cover",
        "card_border": true,
        "background_color": "bg-white",
        "padded": false,
        "box_shadow": "shadow-sm",
        "corner_style": "rounded-3",
        "equal_height": false,
        "stretched_link": false,
        "link_url": "",
        "link_target": "default"
      }
    },
    {
      "name": "Padded content",
      "args": {
        "media_position": "top",
        "ratio": "ratio-16x9",
        "fit": "object-fit-cover",
        "card_border": true,
        "background_color": "bg-body",
        "padded": true,
        "box_shadow": "shadow",
        "corner_style": "rounded-3",
        "equal_height": false,
        "stretched_link": false,
        "link_url": "",
        "link_target": "default"
      }
    },
    {
      "name": "Media bottom",
      "args": {
        "media_position": "bottom",
        "ratio": "ratio-4x3",
        "fit": "object-fit-cover",
        "card_border": true,
        "background_color": "bg-white",
        "padded": true,
        "box_shadow": "shadow-sm",
        "corner_style": "rounded-3",
        "equal_height": false,
        "stretched_link": false,
        "link_url": "",
        "link_target": "default"
      }
    },
    {
      "name": "Contain fit",
      "args": {
        "media_position": "top",
        "ratio": "ratio-1x1",
        "fit": "object-fit-contain",
        "card_border": true,
        "background_color": "bg-white",
        "padded": true,
        "box_shadow": "shadow-none",
        "corner_style": "rounded-0",
        "equal_height": false,
        "stretched_link": false,
        "link_url": "",
        "link_target": "default"
      }
    },
    {
      "name": "Linked card",
      "args": {
        "media_position": "top",
        "ratio": "ratio-21x9",
        "fit": "object-fit-cover",
        "card_border": true,
        "background_color": "bg-white",
        "padded": true,
        "box_shadow": "shadow-lg",
        "corner_style": "rounded-3",
        "equal_height": false,
        "stretched_link": true,
        "link_url": "https://example.com",
        "link_target": "_blank"
      }
    }
  ]
}
