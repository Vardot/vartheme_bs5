{% story 'Linked card' with {
  "args": {
    "media_position": "top",
    "ratio": "ratio-21x9",
    "fit": "object-fit-cover",
    "card_border": true,
    "background_color": "bg-white",
    "padded": true,
    "box_shadow": "shadow-lg",
    "corner_style": "rounded-3",
    "equal_height": false,
    "stretched_link": true,
    "link_url": "https://example.com",
    "link_target": "_blank"
  }
} %}
{% embed 'vartheme_bs5:card-impressed' %}
  {% block content %}
    <h3 class="h5 mb-2">Linked card</h3>
    <p class="mb-0">Enable <code>stretched_link</code> and set <code>link_url</code> to make the whole card clickable.</p>
  {% endblock %}
{% endembed %}
{% endstory %}

{% endstories %}
