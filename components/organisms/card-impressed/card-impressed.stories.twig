{% stories ImpressedCard with {
  title: 'Cards/Impressed Card',
  parameters: {
    componentSubtitle: 'Stacked card with optional media (top or bottom), a media overlay slot, and a content slot.',
    docs: {
      description: {
        component: 'Impressed Card is a stacked Bootstrap 5 card with an optional media area, a media overlay slot, and a content slot. Use utility-class props to control border, padding, background, rounding, shadows, and full-card link behavior.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    media_position: {
      name: 'Media position',
      description: 'Choose whether the image appears above or below the content.',
      defaultValue: 'top',
      control: 'select',
      options: {
        Top: 'top',
        Bottom: 'bottom',
      },
    },
    media_image: {
      name: 'Media upload',
      description: 'Optional image shown in the media area.',
      control: 'object',
    },
    ratio: {
      name: 'Image ratio (crop)',
      description: 'Keeps consistent image shapes.',
      defaultValue: 'ratio-16x9',
      control: 'select',
      options: {
        "'Auto (no crop)'": 'ratio-auto',
        "'Wide (16:9)'": 'ratio-16x9',
        "'Standard (4:3)'": 'ratio-4x3',
        "'Square (1:1)'": 'ratio-1x1',
        "'Ultra-wide (21:9)'": 'ratio-21x9',
      },
    },
    fit: {
      name: 'Image fit',
      description: 'How the image behaves inside a fixed ratio.',
      defaultValue: 'object-fit-cover',
      control: 'select',
      options: {
        "'Fill (crop)'": 'object-fit-cover',
        "'Fit (no crop)'": 'object-fit-contain',
      },
    },
    card_border: {
      name: 'Card border',
      description: 'Adds the default Bootstrap border.',
      defaultValue: true,
      control: 'boolean',
    },
    background_color: {
      name: 'Background',
      description: 'Bootstrap background utility applied to the card.',
      defaultValue: 'bg-white',
      control: 'select',
      options: {
        Transparent: 'bg-transparent',
        Body: 'bg-body',
        "'Body tertiary'": 'bg-body-tertiary',
        White: 'bg-white',
        Light: 'bg-light',
        Dark: 'bg-dark',
        Primary: 'bg-primary',
        Secondary: 'bg-secondary',
        Success: 'bg-success',
        Danger: 'bg-danger',
        Warning: 'bg-warning',
        Info: 'bg-info',
      },
    },
    padded: {
      name: 'Padded',
      description: 'Adds p-4 to the content area.',
      defaultValue: false,
      control: 'boolean',
    },
    box_shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility applied to the card.',
      defaultValue: 'shadow-sm',
      control: 'select',
      options: {
        None: 'shadow-none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    corner_style: {
      name: 'Corner style',
      description: 'Bootstrap rounded utility applied to the card.',
      defaultValue: 'rounded-3',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Large: 'rounded-3',
        Pill: 'rounded-pill',
      },
    },
    equal_height: {
      name: 'Equal height',
      description: 'Apply h-100 to the card wrapper.',
      defaultValue: false,
      control: 'boolean',
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'Makes the full card clickable when Link URL is provided.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Link URL',
      description: 'Optional URL for the card link.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute for the card link.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    media_position: 'top',
    media_image: {
      src: '/components/foundation/images/assets/teaser-2.jpg',
      alt: 'Impressed image',
      width: 800,
      height: 600,
    },
    ratio: 'ratio-16x9',
    fit: 'object-fit-cover',
    card_border: true,
    background_color: 'bg-white',
    padded: true,
    box_shadow: 'shadow-sm',
    corner_style: 'rounded-3',
    equal_height: false,
    stretched_link: false,
    link_url: '',
    link_target: 'default',
  },
} %}
{% embed 'vartheme_bs5:card-impressed' with _context %}
  {% block content %}
    <div class="d-flex flex-column gap-2">
      <h3 class="h5 m-0">Impressed Card</h3>
      <p class="m-0 text-muted">A stacked card with an optional media area, media overlay slot, and content slot.</p>
      <div class="d-flex gap-2">
        <span class="badge text-bg-primary">Badge</span>
        <span class="badge text-bg-secondary">Tag</span>
      </div>
    </div>
  {% endblock %}
{% endembed %}
{% endstory %}

