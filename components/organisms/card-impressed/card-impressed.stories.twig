{% story 'Contain fit' with {
  "args": {
    "media_position": "top",
    "ratio": "ratio-1x1",
    "fit": "object-fit-contain",
    "card_border": true,
    "background_color": "bg-white",
    "padded": true,
    "box_shadow": "shadow-none",
    "corner_style": "rounded-0",
    "equal_height": false,
    "link_url": "",
    "link_target": "default"
  }
} %}
{% embed 'vartheme_bs5:card-impressed' %}
  {% block content %}
    <h3 class="h5 mb-2">Contain fit</h3>
    <p class="mb-0">Use <code>object-fit-contain</code> to avoid cropping inside fixed ratios.</p>
