{% stories CardText with {
  title: 'Cards/Card Text',
  parameters: {
    componentSubtitle: 'Simple text-based card with flexible content slot and utility styling options.',
    docs: {
      description: {
        component: 'A lightweight text-focused card component for titles, descriptions, and actions. Supports padding, background, borders, shadows, and full-card link behavior.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    icon_image: {
      name: 'Icon image',
      description: 'Upload an icon image (SVG, PNG, or WebP). Leave empty to show no icon.',
      control: 'object',
    },
    icon_alignment: {
      name: 'Icon alignment',
      description: 'Horizontal alignment of the icon within the card.',
      defaultValue: 'start',
      control: 'select',
      options: {
        Left: 'start',
        Center: 'center',
        Right: 'end',
      },
    },
    card_border: {
      name: 'Card border',
      description: 'Adds default Bootstrap border.',
      defaultValue: true,
      control: 'boolean',
    },
    background_color: {
      name: 'Background',
      description: 'Brand background color applied to the card.',
      defaultValue: 'none',
      control: 'select',
      options: {
        None: 'none',
        "'Body tertiary'": 'bg-body-tertiary',
        Tertiary: 'bg-tertiary',
        Accent: 'bg-accent',
        Primary: 'bg-primary',
        "'Primary subtle'": 'bg-primary-subtle',
        Secondary: 'bg-secondary',
        "'Secondary subtle'": 'bg-secondary-subtle',
        Dark: 'bg-dark',
      },
    },
    padded: {
      name: 'Padded',
      description: 'Adds p-4 spacing to content.',
      defaultValue: true,
      control: 'boolean',
    },
    box_shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility.',
      defaultValue: 'shadow-sm',
      control: 'select',
      options: {
        None: 'shadow-none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    corner_style: {
      name: 'Border radius',
      description: 'Rounded utility for the card.',
      defaultValue: 'rounded-3',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Large: 'rounded-3',
        Pill: 'rounded-pill',
      },
    },
    equal_height: {
      name: 'Equal height',
      description: 'Apply h-100 for grid alignment.',
      defaultValue: false,
      control: 'boolean',
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'Make entire card clickable.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Link URL',
      description: 'Optional card link.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    card_border: true,
    background_color: 'none',
    padded: true,
    box_shadow: 'shadow-sm',
    corner_style: 'rounded-3',
    equal_height: false,
    stretched_link: false,
    link_url: '',
    link_target: 'default',
  },
} %}
{% embed 'vartheme_bs5:card-text' with _context %}
  {% block content %}
    <h3 class="h5 mb-2">Card text title</h3>
    <p class="mb-3">This is a simple text card used for descriptions, highlights, or small content blocks.</p>
    <a href="#" class="btn btn-primary">Action</a>
  {% endblock %}
{% endembed %}
{% endstory %}

