{% stories HeroSideBySide with {
  title: 'Hero/Hero Side by Side',
  parameters: {
    componentSubtitle: 'Split hero section with image, content, optional background image, and CTA button.',
    docs: {
      description: {
        component: 'Hero side-by-side layout with configurable alignment, colors, overlay, image position, and CTA button.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    heading: {
      name: 'Heading',
      defaultValue: 'Build better digital experiences',
      control: 'text',
    },
    heading_level: {
      name: 'Heading level',
      defaultValue: 2,
      control: 'select',
      options: {
        H2: 2,
        H3: 3,
        H4: 4,
        H5: 5,
        H6: 6,
      },
    },
    text: {
      name: 'Text',
      control: 'text',
    },
    image: {
      name: 'Image',
      control: 'object',
    },
    image_position: {
      name: 'Image position',
      defaultValue: 'right',
      control: 'select',
      options: {
        Right: 'right',
        Left: 'left',
      },
    },
    bg_edge2edge: {
      name: 'Edge-to-edge background',
      defaultValue: false,
      control: 'boolean',
    },
    align: {
      name: 'Content alignment',
      defaultValue: 'text-start',
      control: 'select',
      options: {
        Left: 'text-start',
        Center: 'text-center',
      },
    },
    background_color: {
      name: 'Background color',
      defaultValue: 'bg-white',
      control: 'select',
      options: {
        None: 'bg-none',
        White: 'bg-white',
        Primary: 'bg-primary',
        Secondary: 'bg-secondary',
        Success: 'bg-success',
        Danger: 'bg-danger',
        Warning: 'bg-warning',
        Info: 'bg-info',
        Light: 'bg-light',
        Dark: 'bg-dark',
      },
    },
    content_color: {
      name: 'Content color',
      defaultValue: 'text-dark',
      control: 'select',
      options: {
        "'Dark text'": 'text-dark',
        "'Light text'": 'text-white',
      },
    },
    background_overlay_color: {
      name: 'Background overlay color',
      defaultValue: 'bg-none',
      control: 'select',
      options: {
        None: 'bg-none',
        Dark: 'bg-dark',
        Light: 'bg-light',
        Primary: 'bg-primary',
        Secondary: 'bg-secondary',
      },
    },
    background_overlay_opacity: {
      name: 'Overlay opacity',
      defaultValue: 50,
      control: 'select',
      options: {
        "'0%'": 0,
        "'25%'": 25,
        "'50%'": 50,
        "'75%'": 75,
        "'100%'": 100,
      },
    },
    vertical_padding: {
      name: 'Vertical padding',
      defaultValue: 'py-4',
      control: 'select',
      options: {
        None: 'py-0',
        Small: 'py-3',
        Medium: 'py-4',
        Large: 'py-5',
      },
    },
    button_label: {
      name: 'Button label',
      control: 'text',
    },
    button_url: {
      name: 'Button URL',
      control: 'text',
    },
    button_variant: {
      name: 'Button variant',
      defaultValue: 'btn-primary',
      control: 'select',
      options: {
        Primary: 'btn-primary',
        Secondary: 'btn-secondary',
        Success: 'btn-success',
        Danger: 'btn-danger',
        Warning: 'btn-warning',
        Info: 'btn-info',
        Light: 'btn-light',
        Dark: 'btn-dark',
        Link: 'btn-link',
      },
    },
    button_outline: {
      name: 'Button outline',
      defaultValue: false,
      control: 'boolean',
    },
    button_size: {
      name: 'Button size',
      defaultValue: 'btn-md',
      control: 'select',
      options: {
        "'Medium (default)'": 'btn-md',
        Small: 'btn-sm',
        Large: 'btn-lg',
      },
    },
    button_target: {
      name: 'Button target',
      defaultValue: 'self',
      control: 'select',
      options: {
        "'Same tab'": 'self',
        "'New tab'": 'blank',
      },
    },
  },
} %}

