{% stories HeroCard with {
  title: 'Hero/Hero Card',
  parameters: {
    componentSubtitle: 'Hero card with configurable media positions',
    docs: {
      description: {
        component: 'Displays a hero-style card with configurable media placement and content.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    title: {
      name: 'Title',
      defaultValue: 'Hero card title',
      control: 'text',
    },
    description: {
      name: 'Description',
      defaultValue: 'Short supporting text for the hero card.',
      control: 'text',
    },
    media: {
      name: 'Media',
      control: 'object',
    },
    media_position: {
      name: 'Media position',
      description: 'Controls the media placement in the hero card.',
      defaultValue: 'overlay',
      control: 'select',
      options: {
        Overlay: 'overlay',
        Start: 'start',
        End: 'end',
        Top: 'top',
        Bottom: 'bottom',
        Content: 'content',
        None: 'none',
      },
    },
    button_text: {
      name: 'Button text',
      defaultValue: 'Learn more',
      control: 'text',
    },
    button_url: {
      name: 'Button URL',
      defaultValue: '#',
      control: 'text',
    },
  },
} %}

{% story Overlay with {
  name: 'Overlay',
  args: {
    title: 'Overlay media position',
    description: 'Media displayed as a background overlay.',
    media: {
      src: '/components/organisms/hero-card/assets/hero-card-image-placeholder.svg',
      alt: 'Overlay media',
      width: 1200,
      height: 800,
    },
    media_position: 'overlay',
    overlay_bg: 'bg-black',
    overlay_opacity: 'opacity-50',
    content_color: 'text-white',
    button_text: 'Learn more',
    bg_edge2edge: true,
    button_url: '/learn-more',
  },
} %}
{{ include('vartheme_bs5:hero-card', {
  title: title,
  description: description,
  media: media,
  media_position: media_position,
  button_text: button_text,
  button_url: button_url,
  bg_edge2edge: bg_edge2edge,
  overlay_bg: overlay_bg,
  content_color: content_color,
  overlay_opacity: overlay_opacity,
}, with_context: false) }}
{% endstory %}

