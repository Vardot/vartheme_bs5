{
  "title": "Organisms/Card Overlay",
  "parameters": {
    "componentSubtitle": "Bootstrap overlay card component",
    "docs": {
      "description": {
        "component": "Card component with background media, overlay controls, and a single content slot."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "media_image": {
      "name": "Media image",
      "description": "Background media image object.",
      "control": "object",
      "defaultValue": {
        "src": "assets/overlay-card-image-placeholder.svg",
        "alt": "Overlay card placeholder image",
        "width": 1200,
        "height": 675
      }
    },
    "ratio": {
      "name": "Image ratio (crop)",
      "description": "Keeps consistent image shapes.",
      "defaultValue": "ratio-16x9",
      "control": "select",
      "options": {
        "Auto (no crop)": "ratio-auto",
        "Wide (16:9)": "ratio-16x9",
        "Standard (4:3)": "ratio-4x3",
        "Square (1:1)": "ratio-1x1",
        "Ultra-wide (21:9)": "ratio-21x9"
      }
    },
    "fit": {
      "name": "Image fit",
      "description": "How the image behaves inside a fixed ratio.",
      "defaultValue": "object-fit-cover",
      "control": "select",
      "options": {
        "Fill (crop)": "object-fit-cover",
        "Fit (no crop)": "object-fit-contain"
      }
    },
    "padded": {
      "name": "Padded",
      "description": "Adds p-4 to the content area.",
      "defaultValue": false,
      "control": "boolean"
    },
    "box_shadow": {
      "name": "Shadow",
      "defaultValue": "shadow-none",
      "control": "select",
      "options": {
        "None": "shadow-none",
        "Small": "shadow-sm",
        "Medium": "shadow",
        "Large": "shadow-lg"
      }
    },
    "overlay_color": {
      "name": "Overlay color",
      "defaultValue": "bg-transparent",
      "control": "select",
      "options": {
        "None": "bg-transparent",
        "Dark": "bg-dark",
        "Light": "bg-light",
        "Primary": "bg-primary",
        "Secondary": "bg-secondary",
        "Success": "bg-success",
        "Danger": "bg-danger",
        "Warning": "bg-warning",
        "Info": "bg-info",
        "Body": "bg-body",
        "Body tertiary": "bg-body-tertiary",
        "White": "bg-white"
      }
    },
    "overlay_opacity": {
      "name": "Overlay opacity",
      "defaultValue": "bg-opacity-50",
      "control": "select",
      "options": {
        "10%": "bg-opacity-10",
        "25%": "bg-opacity-25",
        "50%": "bg-opacity-50",
        "75%": "bg-opacity-75",
        "100%": "bg-opacity-100"
      }
    },
    "equal_height": {
      "name": "Equal height",
      "description": "Applies h-100 to the card wrapper.",
      "defaultValue": false,
      "control": "boolean"
    },
    "h_align": {
      "name": "Horizontal alignment",
      "defaultValue": "text-start",
      "control": "select",
      "options": {
        "Start": "text-start",
        "Center": "text-center",
        "End": "text-end"
      }
    },
    "v_align": {
      "name": "Vertical alignment",
      "defaultValue": "align-items-center",
      "control": "select",
      "options": {
        "Start": "align-items-start",
        "Center": "align-items-center",
        "End": "align-items-end"
      }
    },
    "stretched_link": {
      "name": "Stretched link",
      "description": "Makes the full card clickable when link_url is provided.",
      "defaultValue": false,
      "control": "boolean"
    },
    "link_url": {
      "name": "Card link URL",
      "defaultValue": "",
      "control": "text"
    },
    "link_target": {
      "name": "Link target",
      "defaultValue": "default",
      "control": "select",
      "options": {
        "Default (same tab)": "default",
        "Same tab": "_self",
        "New tab": "_blank"
      }
    }
  },
