{% stories CardOverlay with {
  title: 'Cards/Card Overlay',
  parameters: {
    componentSubtitle: 'Bootstrap overlay card with background media and a single content slot.',
    docs: {
      description: {
        component: 'Card component with background media, overlay controls, alignment options, and a single content slot.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    media_image: {
      name: 'Media image',
      description: 'Background media image object.',
      control: 'object',
      defaultValue: {
        src: '/components/foundation/images/assets/banner-1.jpg',
        alt: 'Overlay card placeholder image',
        width: 1200,
        height: 675,
      },
    },
    ratio: {
      name: 'Image ratio (crop)',
      description: 'Keeps consistent image shapes.',
      defaultValue: 'ratio-16x9',
      control: 'select',
      options: {
        "'Auto (no crop)'": 'ratio-auto',
        "'Wide (16:9)'": 'ratio-16x9',
        "'Standard (4:3)'": 'ratio-4x3',
        "'Square (1:1)'": 'ratio-1x1',
        "'Ultra-wide (21:9)'": 'ratio-21x9',
      },
    },
    fit: {
      name: 'Image fit',
      description: 'How the image behaves inside a fixed ratio.',
      defaultValue: 'object-fit-cover',
      control: 'select',
      options: {
        "'Fill (crop)'": 'object-fit-cover',
        "'Fit (no crop)'": 'object-fit-contain',
      },
    },
    padded: {
      name: 'Padded',
      description: 'Adds p-4 to the content area.',
      defaultValue: true,
      control: 'boolean',
    },
    box_shadow: {
      name: 'Shadow',
      description: 'Bootstrap shadow utility applied to the card.',
      defaultValue: 'shadow',
      control: 'select',
      options: {
        None: 'shadow-none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    overlay_color: {
      name: 'Overlay color',
      description: 'Bootstrap background utility applied to the overlay layer.',
      defaultValue: 'bg-dark',
      control: 'select',
      options: {
        None: 'bg-transparent',
        Dark: 'bg-dark',
        Light: 'bg-light',
        Primary: 'bg-primary',
        Secondary: 'bg-secondary',
        Success: 'bg-success',
        Danger: 'bg-danger',
        Warning: 'bg-warning',
        Info: 'bg-info',
        Body: 'bg-body',
        "'Body tertiary'": 'bg-body-tertiary',
        White: 'bg-white',
      },
    },
    overlay_opacity: {
      name: 'Overlay opacity',
      description: 'Bootstrap background opacity utility applied to the overlay layer.',
      defaultValue: 'bg-opacity-50',
      control: 'select',
      options: {
        "'10%'": 'bg-opacity-10',
        "'25%'": 'bg-opacity-25',
        "'50%'": 'bg-opacity-50',
        "'75%'": 'bg-opacity-75',
        "'100%'": 'bg-opacity-100',
      },
    },
    equal_height: {
      name: 'Equal height',
      description: 'Applies h-100 to the card wrapper.',
      defaultValue: false,
      control: 'boolean',
    },
    h_align: {
      name: 'Horizontal alignment',
      description: 'Text alignment for content.',
      defaultValue: 'text-start',
      control: 'select',
      options: {
        Start: 'text-start',
        Center: 'text-center',
        End: 'text-end',
      },
    },
    v_align: {
      name: 'Vertical alignment',
      description: 'Vertical alignment for the overlay content.',
      defaultValue: 'align-items-end',
      control: 'select',
      options: {
        Start: 'align-items-start',
        Center: 'align-items-center',
        End: 'align-items-end',
      },
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'Makes the full card clickable when Card link URL is provided.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Card link URL',
      description: 'Optional URL for the card link.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute for the card link.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Default (same tab)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    media_image: {
      src: '/components/foundation/images/assets/banner-1.jpg',
      alt: 'Overlay card placeholder image',
      width: 1200,
      height: 675,
    },
    ratio: 'ratio-16x9',
    fit: 'object-fit-cover',
    padded: true,
    box_shadow: 'shadow',
    overlay_color: 'bg-dark',
    overlay_opacity: 'bg-opacity-50',
    equal_height: false,
    h_align: 'text-start',
    v_align: 'align-items-end',
    stretched_link: false,
    link_url: '',
    link_target: 'default',
  },
} %}
{% embed 'vartheme_bs5:card-overlay' with _context %}
  {% block content %}
    <h3 class="card-title mb-2">Overlay card title</h3>
    <p class="card-text mb-3">Use this component for featured content with text layered on top of media.</p>
    {{ include('vartheme_bs5:link', {
      url: 'https://drupal.org',
      content: 'Read more',
      color: 'light',
    }) }}
  {% endblock %}
{% endembed %}
{% endstory %}

