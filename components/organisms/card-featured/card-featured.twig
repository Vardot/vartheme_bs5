{#
  Featured Card
  - Bootstrap utility classes only (no custom classes)
  - Responsive grid ratios per breakpoint
  - One slot: content (media is a prop)
#}

{% set card_border = card_border|default(false) %}
{% set corner_style = corner_style|default('rounded-0') %}
{% set padded = padded|default(false) %}
{% set content_padding_class = padded ? 'p-4' : 'p-0' %}

{% set equal_height = equal_height|default(false) %}
{% set stretched_link = stretched_link|default(false) %}
{% set media_position = media_position|default('start') %}
{% set has_media = media_position != 'no-media' %}
{% set content_vertical_alignment = content_vertical_alignment|default('align-items-center') %}
{% set gutters_between = gutters_between|default('g-2 g-lg-3') %}

{% set media_image = media_image|default({}) %}
{% set has_media_prop = (media_image.src|default('')|trim) is not empty %}

{% set ratio = ratio|default('ratio-16x9') %}
{% set fit = fit|default('object-fit-cover') %}

{% set link_url = link_url|default('')|trim %}
{% set link_target_raw = link_target|default('default') %}
{% set link_target = (link_target_raw == 'default') ? '_self' : link_target_raw %}

{% set content_slot %}{% block content %}{% endblock %}{% endset %}
{% set has_content_slot = content_slot|render|trim is not empty %}
{% set empty_slot_classes = not has_content_slot ? 'd-flex align-items-center justify-content-center text-center' : '' %}

{% set placeholder_src = (component_metadata.path is defined)
  ? (component_metadata.path ~ '/assets/featured-card-image-placeholder.svg')
  : 'assets/featured-card-image-placeholder.svg'
%}

{#
  Breakpoint ratios
  - Canvas often sends an empty string ("") when "Default (auto)" is selected.
  - Use default(..., true) so empty strings also fall back to XS.
#}
{% set columns_xs_size = columns_xs_size|default('06_06', true) %}
{% set columns_sm_size = columns_sm_size|default(columns_xs_size, true) %}
{% set columns_md_size = columns_md_size|default(columns_xs_size, true) %}
{% set columns_lg_size = columns_lg_size|default(columns_xs_size, true) %}
{% set columns_xl_size = columns_xl_size|default(columns_xs_size, true) %}
{% set columns_xxl_size = columns_xxl_size|default(columns_xs_size, true) %}

{# Mapping for the start (media) column with selected column sizes on each breakpoint #}
{% set start_column_xs_size = columns_xs_size ? ['col-' ~ columns_xs_size|split('_')[0]|trim('0', 'left')] : [] %}
{% set start_column_sm_size = columns_sm_size ? ['col-sm-' ~ columns_sm_size|split('_')[0]|trim('0', 'left')] : [] %}
{% set start_column_md_size = columns_md_size ? ['col-md-' ~ columns_md_size|split('_')[0]|trim('0', 'left')] : [] %}
{% set start_column_lg_size = columns_lg_size ? ['col-lg-' ~ columns_lg_size|split('_')[0]|trim('0', 'left')] : [] %}
{% set start_column_xl_size = columns_xl_size ? ['col-xl-' ~ columns_xl_size|split('_')[0]|trim('0', 'left')] : [] %}
{% set start_column_xxl_size = columns_xxl_size ? ['col-xxl-' ~ columns_xxl_size|split('_')[0]|trim('0', 'left')] : [] %}

{# Mapping for the end (content) column with selected column sizes on each breakpoint #}
{% set end_column_xs_size = columns_xs_size ? ['col-' ~ columns_xs_size|split('_')[1]|trim('0', 'left')] : [] %}
{% set end_column_sm_size = columns_sm_size ? ['col-sm-' ~ columns_sm_size|split('_')[1]|trim('0', 'left')] : [] %}
{% set end_column_md_size = columns_md_size ? ['col-md-' ~ columns_md_size|split('_')[1]|trim('0', 'left')] : [] %}
{% set end_column_lg_size = columns_lg_size ? ['col-lg-' ~ columns_lg_size|split('_')[1]|trim('0', 'left')] : [] %}
{% set end_column_xl_size = columns_xl_size ? ['col-xl-' ~ columns_xl_size|split('_')[1]|trim('0', 'left')] : [] %}
{% set end_column_xxl_size = columns_xxl_size ? ['col-xxl-' ~ columns_xxl_size|split('_')[1]|trim('0', 'left')] : [] %}

{% set use_stretched_link = stretched_link and (link_url is not empty) %}
{% set row_order_class = (media_position == 'end') ? 'flex-row-reverse' : '' %}

{% set card_class_list = [
  'card',
  'overflow-hidden',
  (equal_height ? 'h-100' : ''),
  (card_border ? 'border' : 'border-0'),
  (card_border ? corner_style : ''),
  (use_stretched_link ? 'position-relative' : '')
]|filter(v => v is not empty) %}

{% set row_class_list = [
  'row',
  'gx-0',
  gutters_between,
  row_order_class,
  content_vertical_alignment,
  (equal_height ? 'h-100' : '')
]|filter(v => v is not empty) %}

{% set media_col_class_list = (
  [
    'col-12',
    'd-flex',
    (equal_height ? 'h-100' : '')
  ]
  |merge(start_column_xs_size)
  |merge(start_column_sm_size)
  |merge(start_column_md_size)
  |merge(start_column_lg_size)
  |merge(start_column_xl_size)
  |merge(start_column_xxl_size)
)|filter(v => v is not empty) %}

{% set content_col_class_list = (
  (has_media and has_media_prop)
    ? (
      [
        'col-12',
        'd-flex',
        (equal_height ? 'h-100' : '')
      ]
      |merge(end_column_xs_size)
      |merge(end_column_sm_size)
      |merge(end_column_md_size)
      |merge(end_column_lg_size)
      |merge(end_column_xl_size)
      |merge(end_column_xxl_size)
    )
    : [
      'col-12',
      'd-flex',
      (equal_height ? 'h-100' : '')
    ]
)|filter(v => v is not empty) %}

{% set media_wrap_class_list = [
  'w-100',
  'h-100',
  (not card_border ? corner_style : ''),
  (not card_border ? 'overflow-hidden' : ''),
]|filter(v => v is not empty) %}

{% set placeholder_wrap_class_list = [
  'w-100',
  'bg-body-tertiary',
  (equal_height ? 'h-100' : '')
]|filter(v => v is not empty) %}

{% set content_stack_class_list = [
  'd-flex',
  'flex-column',
  'w-100',
  'flex-grow-1'
]|filter(v => v is not empty) %}

{% set content_body_class_list = [
  'card-body',
  'w-100',
  'flex-grow-0',
  content_padding_class,
  empty_slot_classes,
  (card_border ? '' : 'border-0')
]|filter(v => v is not empty) %}

{% set placeholder_inner_base_class_list = [
  'd-flex',
  'align-items-center',
  'justify-content-center',
  'text-body-secondary'
] %}

{% set placeholder_inner_base = placeholder_inner_base_class_list|join(' ') %}

{% set image_include_props = {
  media: {
    src: media_image.src|default(''),
    alt: media_image.alt|default(''),
    width: media_image.width|default(null),
    height: media_image.height|default(null),
  },
  ratio: ratio,
  fit: fit,
  width: 'w-100',
  height: 'h-100',
  loading: media_image.loading|default('lazy'),
  sizes: media_image.sizes|default(''),
} %}

{% set placeholder_include_props = {
  media: {
    src: placeholder_src,
    alt: ''
  },
  width: 'w-100',
  fit: 'object-fit-contain',
  loading: 'lazy'
} %}

{% set card_attributes = create_attribute().addClass(card_class_list) %}
{% set row_attributes = create_attribute().addClass(row_class_list) %}
{% set media_col_attributes = create_attribute().addClass(media_col_class_list) %}
{% set content_col_attributes = create_attribute().addClass(content_col_class_list) %}
{% set media_wrap_attributes = create_attribute().addClass(media_wrap_class_list) %}
{% set placeholder_wrap_attributes = create_attribute().addClass(placeholder_wrap_class_list) %}

<div{{ card_attributes }}>
  <div{{ row_attributes }}>

    {% if has_media and has_media_prop %}
      <div{{ media_col_attributes }}>
        <div{{ media_wrap_attributes }}>
          {% include 'vartheme_bs5:image' ignore missing with image_include_props only %}
        </div>
      </div>
    {% endif %}

    <div{{ content_col_attributes }}>
      <div class="{{ content_stack_class_list|join(' ') }}">
        <div class="{{ content_body_class_list|join(' ') }}">
          {{ content_slot }}
          {% if not has_content_slot %}
            <div class="text-body-secondary fst-italic mt-2">Drop content here</div>
          {% endif %}
        </div>
      </div>
    </div>

  </div>

  {% if use_stretched_link %}
    {% set _link_accessible_label = content_slot|striptags|trim %}
    {% include 'vartheme_bs5:link' with {
      url: link_url,
      target: link_target,
      attributes: create_attribute().setAttribute('aria-label', _link_accessible_label),
      content: '',
      link_utility_classes: ['stretched-link']
    } %}
  {% endif %}
</div>