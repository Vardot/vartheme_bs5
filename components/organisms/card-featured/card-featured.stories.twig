{% stories FeaturedCard with {
  title: 'Organisms/Featured Card',
  parameters: {
    componentSubtitle: 'Featured card (media + content) with responsive Bootstrap grid ratios.',
    docs: {
      description: {
        component: 'A responsive featured card layout with an optional media image column and a flexible content slot. Includes controls for padding, borders, gutters, alignment, and breakpoint-based column ratios.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    card_border: {
      name: 'Card Border',
      description: 'Add a default border for the card.',
      defaultValue: true,
      control: 'boolean',
    },
    padded: {
      name: 'Padded',
      description: 'When enabled, adds p-4 padding to the content area.',
      defaultValue: false,
      control: 'boolean',
    },
    equal_height: {
      name: 'Equal height',
      defaultValue: false,
      control: 'boolean',
    },
    stretched_link: {
      name: 'Stretched link',
      defaultValue: true,
      control: 'boolean',
    },
    link_url: {
      name: 'Card link URL',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Same tab (default)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
    media_position: {
      name: 'Media position',
      description: 'Choose the location of the media from (start|end).',
      defaultValue: 'start',
      control: 'select',
      options: {
        Start: 'start',
        End: 'end',
      },
    },
    content_vertical_alignment: {
      name: 'Content Vertical alignment',
      description: 'Vertical alignment of the content.',
      defaultValue: 'justify-content-center',
      control: 'select',
      options: {
        Start: 'justify-content-start',
        Center: 'justify-content-center',
        End: 'justify-content-end',
      },
    },
    gutters_between: {
      name: 'Gutters Between',
      description: 'Bootstrap gutter utility classes applied to the inner row.',
      defaultValue: 'g-2 g-lg-3',
      control: 'select',
      options: {
        "'None (g-0)'": 'g-0',
        "'Small (g-2 g-lg-3)'": 'g-2 g-lg-3',
        "'Medium (g-4)'": 'g-4',
        "'Large (g-4 g-lg-5)'": 'g-4 g-lg-5',
      },
    },
    columns_xs_size: {
      name: 'All Breakpoints',
      description: 'Size of two columns for this breakpoint.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'60% - 40%'": '08_04',
        "'40% - 60%'": '04_08',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 66%'": '04_08',
        "'66% - 33%'": '08_04',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    columns_sm_size: {
      name: 'Small Breakpoint size (sm)',
      description: 'Size of two columns for this breakpoint.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'60% - 40%'": '08_04',
        "'40% - 60%'": '04_08',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 66%'": '04_08',
        "'66% - 33%'": '08_04',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    columns_md_size: {
      name: 'Medium Breakpoint size (md)',
      description: 'Size of two columns for this breakpoint.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'60% - 40%'": '08_04',
        "'40% - 60%'": '04_08',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 66%'": '04_08',
        "'66% - 33%'": '08_04',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    columns_lg_size: {
      name: 'Large Breakpoint size (lg)',
      description: 'Size of two columns for this breakpoint.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'60% - 40%'": '08_04',
        "'40% - 60%'": '04_08',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 66%'": '04_08',
        "'66% - 33%'": '08_04',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    columns_xl_size: {
      name: 'Extra Large Breakpoint size (xl)',
      description: 'Size of two columns for this breakpoint.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'60% - 40%'": '08_04',
        "'40% - 60%'": '04_08',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 66%'": '04_08',
        "'66% - 33%'": '08_04',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    columns_xxl_size: {
      name: 'Extra Extra Large Breakpoint size (xxl)',
      description: 'Size of two columns for this breakpoint.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'60% - 40%'": '08_04',
        "'40% - 60%'": '04_08',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 66%'": '04_08',
        "'66% - 33%'": '08_04',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    media_image: {
      name: 'Media upload',
      description: 'Optional image used when no media slot content is provided.',
      control: 'object',
    },
    ratio: {
      name: 'Image ratio (crop)',
      description: 'Keeps consistent image shapes.',
      defaultValue: 'ratio-16x9',
      control: 'select',
      options: {
        "'Auto (no crop)'": 'ratio-auto',
        "'Wide (16:9)'": 'ratio-16x9',
        "'Standard (4:3)'": 'ratio-4x3',
        "'Square (1:1)'": 'ratio-1x1',
        "'Ultra-wide (21:9)'": 'ratio-21x9',
      },
    },
    fit: {
      name: 'Image fit',
      description: 'How the image behaves inside a fixed ratio.',
      defaultValue: 'object-fit-cover',
      control: 'select',
      options: {
        "'Fill (crop)'": 'object-fit-cover',
        "'Fit (no crop)'": 'object-fit-contain',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    card_border: true,
    padded: false,
    equal_height: false,
    stretched_link: true,
    link_url: 'https://example.com',
    link_target: 'default',
    media_position: 'start',
    content_vertical_alignment: 'justify-content-center',
    gutters_between: 'g-2 g-lg-3',
    columns_xs_size: '06_06',
    columns_sm_size: '06_06',
    columns_md_size: '08_04',
    columns_lg_size: '08_04',
    columns_xl_size: '08_04',
    columns_xxl_size: '08_04',
    media_image: {
      src: 'assets/featured-card-image-placeholder.svg',
      alt: 'Featured image',
      width: 800,
      height: 600,
    },
    ratio: 'ratio-16x9',
    fit: 'object-fit-cover',
  },
} %}
{% embed 'vartheme_bs5:card-featured' %}
  {% block content %}
    <h3 class="h5 mb-2">Featured card title</h3>
    <p class="mb-3">A short description that demonstrates the content slot area.</p>
    <a class="btn btn-primary" href="#">Call to action</a>
  {% endblock %}
{% endembed %}
{% endstory %}

