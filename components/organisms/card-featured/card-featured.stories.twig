{% stories FeaturedCard with {
  title: 'Cards/Featured Card',
  parameters: {
    componentSubtitle: 'Featured card with optional media, responsive Bootstrap grid ratios, and flexible content alignment.',
    docs: {
      description: {
        component: 'A responsive featured card layout with an optional media image column and a flexible content slot. Includes controls for padding, borders, gutters, alignment, and breakpoint-based column ratios.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    card_border: {
      name: 'Card Border',
      description: 'Add a default border for the card.',
      defaultValue: true,
      control: 'boolean',
    },
    corner_style: {
      name: 'Border radius',
      description: 'Applied to the whole card when border is enabled, or to the image only when border is disabled.',
      defaultValue: 'rounded-3',
      control: 'select',
      options: {
        "'None (square)'": 'rounded-0',
        Small: 'rounded-1',
        Medium: 'rounded-2',
        Large: 'rounded-3',
        "'Extra Large'": 'rounded-4',
        Pill: 'rounded-pill',
      },
    },
    padded: {
      name: 'Padded',
      description: 'When enabled, adds p-4 padding to the content area.',
      defaultValue: false,
      control: 'boolean',
    },
    equal_height: {
      name: 'Equal height',
      description: 'Makes both columns stretch to the same height.',
      defaultValue: false,
      control: 'boolean',
    },
    stretched_link: {
      name: 'Stretched link',
      description: 'Makes the whole card clickable using Bootstrap stretched-link.',
      defaultValue: false,
      control: 'boolean',
    },
    link_url: {
      name: 'Card link URL',
      description: 'Optional URL for the card link.',
      defaultValue: '',
      control: 'text',
    },
    link_target: {
      name: 'Link target',
      description: 'Target attribute for the card link.',
      defaultValue: 'default',
      control: 'select',
      options: {
        "'Same tab (default)'": 'default',
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
    media_position: {
      name: 'Media position',
      description: 'Choose where the media column appears.',
      defaultValue: 'start',
      control: 'select',
      options: {
        Start: 'start',
        End: 'end',
        "'No media'": 'no-media',
      },
    },
    content_vertical_alignment: {
      name: 'Content vertical alignment',
      description: 'Vertical alignment of the content column.',
      defaultValue: 'align-items-center',
      control: 'select',
      options: {
        Start: 'align-items-start',
        Center: 'align-items-center',
        End: 'align-items-end',
      },
    },
    gutters_between: {
      name: 'Gutters Between',
      description: 'Bootstrap gutter utility classes applied to the inner row.',
      defaultValue: 'g-2 g-lg-3',
      control: 'select',
      options: {
        "'None (g-0)'": 'g-0',
        "'Small (g-2 g-lg-3)'": 'g-2 g-lg-3',
        "'Medium (g-4)'": 'g-4',
        "'Large (g-4 g-lg-5)'": 'g-4 g-lg-5',
      },
    },
    columns_xs_size: {
      name: 'All Breakpoints',
      description: 'Base size of the two columns.',
      defaultValue: '06_06',
      control: 'select',
      options: {
        "'17% - 83%'": '02_10',
        "'83% - 17%'": '10_02',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 67%'": '04_08',
        "'67% - 33%'": '08_04',
        "'42% - 58%'": '05_07',
        "'58% - 42%'": '07_05',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    columns_md_size: {
      name: 'Medium Breakpoint size (md)',
      description: 'Column size starting from medium screens.',
      defaultValue: '08_04',
      control: 'select',
      options: {
        "'17% - 83%'": '02_10',
        "'83% - 17%'": '10_02',
        "'25% - 75%'": '03_09',
        "'75% - 25%'": '09_03',
        "'33% - 67%'": '04_08',
        "'67% - 33%'": '08_04',
        "'42% - 58%'": '05_07',
        "'58% - 42%'": '07_05',
        "'50% - 50%'": '06_06',
        "'100% - 100%'": '12_12',
      },
    },
    media_image: {
      name: 'Media upload',
      description: 'Optional image used when no media slot content is provided.',
      control: 'object',
    },
    ratio: {
      name: 'Image ratio (crop)',
      description: 'Keeps consistent image shapes.',
      defaultValue: 'ratio-16x9',
      control: 'select',
      options: {
        "'Auto (no crop)'": 'ratio-auto',
        "'Wide (16:9)'": 'ratio-16x9',
        "'Standard (4:3)'": 'ratio-4x3',
        "'Square (1:1)'": 'ratio-1x1',
        "'Ultra-wide (21:9)'": 'ratio-21x9',
      },
    },
    fit: {
      name: 'Image fit',
      description: 'How the image behaves inside a fixed ratio.',
      defaultValue: 'object-fit-cover',
      control: 'select',
      options: {
        "'Fill (crop)'": 'object-fit-cover',
        "'Fit (no crop)'": 'object-fit-contain',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    card_border: true,
    corner_style: 'rounded-3',
    padded: true,
    equal_height: false,
    stretched_link: false,
    link_url: '',
    link_target: 'default',
    media_position: 'start',
    content_vertical_alignment: 'align-items-center',
    gutters_between: 'g-2 g-lg-3',
    columns_xs_size: '06_06',
    columns_md_size: '08_04',
    media_image: {
      src: '/components/organisms/card-featured/assets/featured-card-image-placeholder.svg',
      alt: 'Featured image',
      width: 800,
      height: 600,
    },
    ratio: 'ratio-16x9',
    fit: 'object-fit-cover',
  },
} %}
{% embed 'vartheme_bs5:card-featured' with _context %}
  {% block content %}
    <h3 class="h5 mb-2">Featured card title</h3>
    <p class="mb-3">A short description that demonstrates the content slot area.</p>
    <a class="btn btn-primary" href="#">Call to action</a>
  {% endblock %}
{% endembed %}
{% endstory %}

