{#
  Bootstrap 5 Card (SDC / Canvas compatible)
  - Heading is always rendered as H3
  - Uses Bootstrap utility classes only
  - Supports image top / left / right / bottom layouts
#}

{% set card_layout = orientation|default(layout|default('image-top')) %}
{% set card_background = background|default('bg-body') %}
{% set card_shadow = shadow|default('shadow') %}
{% set body_padding = has_padding is defined ? (has_padding ? 'p-4' : '') : 'p-4' %}
{% set has_media = media is defined and media and media.src is defined and media.src is not empty %}

{% set has_link = url is defined and url is not empty and url != 'No URL' %}
{% set button_label_value = button_label|default('')|trim %}

{# Normalize button variant #}
{% set button_variant_value = button_variant|default('')|trim %}
{% set has_button_variant = button_variant_value != '' and button_variant_value != 'NULL' and button_variant_value != 'none' %}
{% set show_button = has_link and button_label_value != '' and has_button_variant %}

{% set is_horizontal = card_layout in ['image-left', 'image-right'] %}
{% set is_vertical = not is_horizontal %}
{% set media_order = card_layout == 'image-bottom' or card_layout == 'image-right' ? 'order-md-2 order-2' : 'order-md-1 order-1' %}
{% set body_order = card_layout == 'image-bottom' or card_layout == 'image-right' ? 'order-md-1 order-1' : 'order-md-2 order-2' %}

{% set media_col_class = is_horizontal ? 'col-12 col-md-5' : 'col-12' %}
{% set body_col_class = is_horizontal ? 'col-12 col-md-7 d-flex' : 'col-12 d-flex' %}
{% set media_ratio_class = media_ratio|default('ratio-16x9') %}
{% set use_ratio = is_vertical and media_ratio_class != 'auto' %}
{% set content_vertical_class = is_horizontal ? content_vertical|default('justify-content-center') : '' %}

{% set classes = ['card', 'h-100', 'overflow-hidden'] %}
{% if card_background|trim %}
  {% set classes = classes|merge(card_background|split(' ')) %}
{% endif %}
{% if card_shadow|trim %}
  {% set classes = classes|merge(card_shadow|split(' ')) %}
{% endif %}
{% if has_link and not show_button %}
  {% set classes = classes|merge(['position-relative']) %}
{% endif %}

{% set row_classes = ['row', 'g-0', 'h-100', 'align-items-stretch'] %}
{% set media_classes = [media_col_class, media_order] %}
{% set body_wrapper_classes = [body_col_class, body_order] %}
{% set card_body_classes = ['card-body', 'd-flex', 'flex-column', 'w-100'] %}
{% if body_padding %}
  {% set card_body_classes = card_body_classes|merge([body_padding]) %}
{% endif %}
{% if content_vertical_class %}
  {% set card_body_classes = card_body_classes|merge([content_vertical_class]) %}
{% endif %}

{% set vertical_ratio_classes = ['ratio', media_ratio_class] %}
{% set heading_classes = ['card-title', 'h5', 'mb-2'] %}
{% set text_classes = ['card-text', 'mb-0'] %}
{% set button_wrapper_classes = ['mt-3'] %}
{% set link_classes = ['stretched-link'] %}

<div{{ create_attribute().addClass(classes) }}>
  <div{{ create_attribute().addClass(row_classes) }}>
    {% if has_media %}
      <div{{ create_attribute().addClass(media_classes) }}>
        {% if is_vertical %}
          {% if use_ratio %}
            <div{{ create_attribute().addClass(vertical_ratio_classes) }}>
              {% include 'vartheme_bs5:image' ignore missing with {
                media: media,
                ratio: media_ratio_class,
                fit: 'object-fit-cover',
                width: 'w-100'
              } only %}
            </div>
          {% else %}
            {% include 'vartheme_bs5:image' ignore missing with {
              media: media,
              ratio: media_ratio_class,
              fit: 'object-fit-cover',
              width: 'w-100'
            } only %}
          {% endif %}
        {% else %}
          {% include 'vartheme_bs5:image' ignore missing with {
            media: media,
            ratio: 'ratio-auto',
            fit: 'object-fit-cover',
            width: 'w-100'
          } only %}
        {% endif %}
      </div>
    {% endif %}

    <div{{ create_attribute().addClass(body_wrapper_classes) }}>
      <div{{ create_attribute().addClass(card_body_classes) }}>
        {% if heading_text is not empty %}
          <h3{{ create_attribute().addClass(heading_classes) }}>{{ heading_text }}</h3>
        {% endif %}

        {% if text is not empty %}
          <p{{ create_attribute().addClass(text_classes) }}>{{ text }}</p>
        {% endif %}

        {% if show_button %}
          <div{{ create_attribute().addClass(button_wrapper_classes) }}>
            {{ include('vartheme_bs5:button', {
              href: url,
              label: button_label_value,
              variant: button_variant_value,
              size: 'btn-sm'
            }, with_context: false) }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>