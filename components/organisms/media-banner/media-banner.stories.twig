{% stories MediaBanner with {
    title: 'Organisms/Media Banner',
    parameters: {
        componentSubtitle: 'Bootstrap media banner with background image, overlay, and flexible content positioning.',
        docs: {
            description: {
                component: 'Media banner with configurable container, alignment, overlay, and a rich media_banner_slot content area.',
            },
            story: {
                inline: true,
            },
        },
    },
    argTypes: {
        container_type: {
            name: 'Container style',
            description: 'Choose how the content is wrapped.',
            defaultValue: 'container',
            control: 'select',
            options: {
                "'Container (default)'": 'container',
                "'Full width'": 'container-fluid',
                "'Small container'": 'container-sm',
                "'Medium container'": 'container-md',
                "'Large container'": 'container-lg',
                "'Extra large container'": 'container-xl',
                "'Extra extra large container'": 'container-xxl',
                "'No container'": 'none',
            },
        },
        bg_edge2edge: {
            name: 'Background edge-to-edge',
            description: 'If enabled, adds the bg-edge2edge class to the outer section so the background image can extend full width.',
            defaultValue: false,
            control: 'boolean',
        },
        height: {
            name: 'Banner height',
            description: 'Choose the vertical size of the banner.',
            defaultValue: 'ribbon',
            control: 'select',
            options: {
                "'Ribbon (default)'": 'ribbon',
                Large: 'large',
            },
        },
        flex_position: {
            name: 'Content position',
            description: 'Controls vertical placement and horizontal alignment of the content.',
            defaultValue: 'center-left',
            control: 'select',
            options: {
                "'Top left'": 'top-left',
                "'Center left'": 'center-left',
                "'Bottom left'": 'bottom-left',
                Center: 'hero-center',
            },
        },
        overlay_bg: {
            name: 'Overlay background',
            description: 'Bootstrap background utility class.',
            defaultValue: 'bg-transparent',
            control: 'select',
            options: {
                Transparent: 'bg-transparent',
                Dark: 'bg-dark',
                Black: 'bg-black',
                Primary: 'bg-primary',
                Secondary: 'bg-secondary',
                Success: 'bg-success',
                Danger: 'bg-danger',
                Warning: 'bg-warning',
                Info: 'bg-info',
                White: 'bg-white',
            },
        },
        overlay_opacity: {
            name: 'Overlay opacity',
            description: 'Bootstrap opacity utility class.',
            defaultValue: 'opacity-50',
            control: 'select',
            options: {
                "'0% (none)'": 'opacity-0',
                "'25%'": 'opacity-25',
                "'50%'": 'opacity-50',
                "'75%'": 'opacity-75',
                "'100% (solid)'": 'opacity-100',
            },
        },
        content_width: {
            name: 'Content width',
            description: 'Bootstrap width utility class.',
            defaultValue: 'w-100',
            control: 'select',
            options: {
                "'100% (full)'": 'w-100',
                "'75%'": 'w-75',
                "'50%'": 'w-50',
                "'25%'": 'w-25',
            },
        },
        object_position: {
            name: 'Background image position',
            description: 'Controls the background image position.',
            defaultValue: 'center',
            control: 'select',
            options: {
                Top: 'top',
                Center: 'center',
                Bottom: 'bottom',
            },
        },
        media: {
            name: 'Background image',
            description: 'Background image object.',
            control: 'object',
        },
        padding_inline_start: {
            name: 'Padding start',
            description: 'Space inside the banner at the start side.',
            defaultValue: 'none',
            control: 'select',
            options: {
                None: 'none',
                Remove: 'ps-0',
                Small: 'ps-1',
                Medium: 'ps-2',
                Large: 'ps-3',
                "'Extra large'": 'ps-4',
                "'XX-Large'": 'ps-5',
            },
        },
        padding_inline_end: {
            name: 'Padding end',
            description: 'Space inside the banner at the end side.',
            defaultValue: 'none',
            control: 'select',
            options: {
                None: 'none',
                Remove: 'pe-0',
                Small: 'pe-1',
                Medium: 'pe-2',
                Large: 'pe-3',
                "'Extra large'": 'pe-4',
                "'XX-Large'": 'pe-5',
            },
        },
        radius: {
            name: 'Border radius',
            description: 'Bootstrap border-radius utility class.',
            defaultValue: 'none',
            control: 'select',
            options: {
                None: 'none',
                Default: 'rounded',
                Square: 'rounded-0',
                Small: 'rounded-1',
                Medium: 'rounded-2',
                Large: 'rounded-3',
                "'Extra Large'": 'rounded-4',
                Round: 'rounded-pill',
            },
        },
    },
} %}

{% story Default with {
    name: 'Default',
    args: {
        container_type: 'container',
        bg_edge2edge: false,
        height: 'ribbon',
        flex_position: 'center-left',
        overlay_bg: 'bg-dark',
        overlay_opacity: 'opacity-50',
        content_width: 'w-100',
        object_position: 'center',
        media: {
            src: '/components/foundation/images/assets/banner-2.jpg',
            alt: 'Varbase media banner background',
            width: 1920,
            height: 1075,
        },
        padding_inline_start: 'none',
        padding_inline_end: 'none',
        radius: 'none',
    },
} %}
{% embed 'vartheme_bs5:media-banner' with _context %}
    {% block media_banner_slot %}
        {% include 'vartheme_bs5:heading' with {
            heading_text: 'Media Banner Title',
            level: 2,
            text_size: 'display-5',
            text_color: 'text-white',
        } only %}
        <p class="lead mb-0 text-white">Add any rich content inside the media banner slot.</p>
    {% endblock %}
{% endembed %}
{% endstory %}

