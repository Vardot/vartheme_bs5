{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Media Banner component.
 *
 * Available attributes:
 * - attributes: the outermost `<section>` banner root element.
 * - media_layer_attributes / overlay_attributes / container_attributes
 *   / content_outer_attributes / content_width_attributes: nested elements.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set banner_height = height|default('ribbon') %}
{% set banner_position = flex_position|default('center-left') %}
{% set banner_object_position = object_position|default('center') %}
{% set container_class = container_type|default('container') %}
{% set overlay_bg_class = overlay_bg|default('bg-dark') %}
{% set overlay_opacity_class = overlay_opacity|default('opacity-50') %}
{% set content_width_class = content_width|default('w-100') %}
{% set padding_start = padding_inline_start|default('none') %}
{% set padding_end = padding_inline_end|default('none') %}
{% set radius = radius|default('none') %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set is_bg_edge2edge = bg_edge2edge ?? false %}

{# Logic: optional utility classes, only when set. #}
{% set radius_class = radius != 'none' ? radius : '' %}

{# Logic: content positioning derived from the flex position preset. #}
{% set vertical_align_class = {
  'top-left': 'justify-content-start',
  'center-left': 'justify-content-center',
  'bottom-left': 'justify-content-end',
  'hero-center': 'justify-content-center',
}[banner_position]|default('justify-content-center') %}

{% set center_mode = banner_position == 'hero-center' %}
{% set text_align_class = center_mode ? 'text-center' : 'text-start' %}
{% set content_align_class = center_mode ? 'align-items-center' : 'align-items-start' %}

{% set banner_spacing_classes = banner_height == 'large' ? ['py-5', 'py-lg-6'] : ['py-4', 'py-lg-5'] %}

{# Logic: normalize the media source from a string or iterable value. #}
{% set media_src = '' %}
{% set media_alt = '' %}
{% set media_width = '' %}
{% set media_height = '' %}
{% if media is defined %}
  {% if media.src is defined and media.src is not empty %}
    {% if media.src is iterable %}
      {% set media_src = media.src.url|default(media.src.uri|default(media.src.value|default(''))) %}
    {% else %}
      {% set media_src = media.src %}
    {% endif %}
  {% elseif media.url is defined and media.url is not empty %}
    {% set media_src = media.url %}
  {% endif %}
  {% set media_alt = media.alt|default('') %}
  {% set media_width = media.width|default('') %}
  {% set media_height = media.height|default('') %}
{% endif %}

{# Logic: merge section and wrapper classes as arrays. #}
{% set attributes = attributes.addClass([
  'media-banner',
  'position-relative',
  'overflow-hidden',
  'px-0',
  'text-bg-dark',
  is_bg_edge2edge ? 'bg-edge2edge' : '',
  padding_start != 'none' ? padding_start : '',
  padding_end != 'none' ? padding_end : '',
  radius_class,
]|merge(banner_spacing_classes)) %}

{% set media_layer_attributes = create_attribute().addClass([
  'position-absolute',
  'top-0',
  'start-0',
  'w-100',
  'h-100',
]).setAttribute('aria-hidden', 'true') %}

{% set overlay_attributes = create_attribute().addClass([
  'position-absolute',
  'top-0',
  'start-0',
  'w-100',
  'h-100',
  overlay_bg_class,
  overlay_opacity_class,
]) %}

{% set container_attributes = create_attribute().addClass([
  container_class != 'none' ? container_class : '',
  'position-relative',
]) %}

{% set content_outer_attributes = create_attribute().addClass([
  'd-flex',
  'w-100',
  vertical_align_class,
  content_align_class,
  text_align_class,
]) %}

{% set content_width_attributes = create_attribute().addClass([
  content_width_class,
]) %}

{# Print the HTML. #}
<section{{ attributes }}>
  {% if media_src is not empty %}
    <div{{ media_layer_attributes }}>
      {{ include('vartheme_bs5:image', {
        media: {
          src: media_src,
          alt: media_alt,
          width: media_width,
          height: media_height,
        },
        width: 'w-100',
        height: 'h-100',
        fit: 'object-fit-cover',
        object_position: banner_object_position,
        align: 'me-auto',
        rounded: 'rounded-0',
        ratio: 'ratio-auto',
        loading: 'eager',
        cover_fill: true,
      }, false, true) }}
      <div{{ overlay_attributes }}></div>
    </div>
  {% endif %}

  <div{{ container_attributes }}>
    <div{{ content_outer_attributes }}>
      <div{{ content_width_attributes }}>
        {% block media_banner_slot %}{% endblock %}
      </div>
    </div>
  </div>
</section>
