{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Card Pricing component.
 *
 * Notes:
 * - Select props use Bootstrap utility class names directly where possible.
 * - Multi-class values from props are split before addClass().
 * - All logic and class preparation are kept at the top for cleaner markup.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set text_align = text_align|default('text-start') %}
{% set shadow = shadow|default('shadow') %}
{% set border = border|default('border') %}
{% set background_color = background_color|default('bg-body') %}
{% set symbol_position = symbol_position|default('before') %}
{% set currency_symbol = currency_symbol|default('$') %}
{% set currency_code = currency_code|default('USD') %}
{% set price_period_value = price_period|default('')|trim %}
{% set price_note_value = price_note|default('')|trim %}
{% set heading_level = level|default(3) %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set is_promoted = promote ?? false %}
{% set show_divider = show_features_divider ?? true %}

{# Logic: presence checks for optional content. #}
{% set has_badge = badge_text|default('')|trim is not empty %}
{% set has_heading = heading_text is not empty %}
{% set has_description = description is not empty %}
{% set has_price = price is not empty %}
{% set has_features = text is not empty %}
{% set has_button = button_url is not empty and button_url != 'No URL' and button_label is not empty %}
{% set has_price_period = price_period_value is not empty %}
{% set has_price_note = price_note_value is not empty %}

{# Logic: button target. #}
{% set btn_target = button_target|default('self') %}

{# Logic: heading tag and visual variants. #}
{% set heading_tag = heading_level == 2 ? 'h2' : (heading_level == 4 ? 'h4' : 'h3') %}
{% set button_variant_class = button_variant|default(is_promoted ? 'btn-secondary' : 'btn-primary') %}
{% set badge_variant = is_promoted ? 'text-bg-primary' : 'text-bg-secondary' %}
{% set features_wrapper_class = show_divider ? 'border-top pt-3 mb-4' : 'mb-4' %}

{# Logic: merge card classes as arrays. #}
{% set background_classes = background_color|split(' ') %}
{% set card_classes = [
  'card',
  'h-100',
  'position-relative',
  text_align,
  shadow,
  border,
]|merge(background_classes) %}

{% if is_promoted %}
  {% set card_classes = card_classes|merge(['border-primary', 'shadow-lg']) %}
{% endif %}

{% set attributes = attributes.addClass(card_classes) %}
{% set body_attributes = create_attribute().addClass(['card-body', 'd-flex', 'flex-column']) %}
{% set badge_wrapper_attributes = create_attribute().addClass(['mb-2']) %}
{% set heading_attributes = create_attribute().addClass(['h5', 'fw-bold', 'mb-1']) %}
{% set description_attributes = create_attribute().addClass(['mb-3', 'opacity-75']) %}
{% set price_wrapper_attributes = create_attribute().addClass(['mb-2']) %}
{% set price_row_attributes = create_attribute().addClass(['d-inline-flex', 'align-items-end', 'gap-2']) %}
{% set price_heading_attributes = create_attribute().addClass(['display-6', 'fw-semibold', 'mb-0']) %}
{% set data_attributes = create_attribute()
  .setAttribute('value', price|default('')|e)
  .setAttribute('data-currency', currency_code|e)
  .addClass(['d-inline-flex', 'align-items-start', 'gap-1']) %}
{% set symbol_attributes = create_attribute().addClass(['fs-5']) %}
{% set period_attributes = create_attribute().addClass(['opacity-75']) %}
{% set note_attributes = create_attribute().addClass(['small', 'opacity-75', 'mt-1']) %}
{% set features_wrapper_attributes = create_attribute().addClass(features_wrapper_class|split(' ')) %}
{% set features_content_attributes = create_attribute().addClass(['small']) %}
{% set button_label_value = button_label|default('Get started') %}
{% set button_href_value = button_url|default('') %}
{% set button_wrapper_attributes = create_attribute().addClass(['mt-auto']) %}

{# Print the HTML. #}
<article{{ attributes }}>
  <div{{ body_attributes }}>
    {% if has_badge %}
      <div{{ badge_wrapper_attributes }}>
        {{ include('vartheme_bs5:badge', {
          label: badge_text|trim,
          variant: badge_variant,
          size: 'fs-6 px-2 py-1',
          radius: 'rounded-1',
        }, with_context: false) }}
      </div>
    {% endif %}

    {% if has_heading %}
      <{{ heading_tag }}{{ heading_attributes }}>{{ heading_text }}</{{ heading_tag }}>
    {% endif %}

    {% if has_description %}
      <p{{ description_attributes }}>{{ description }}</p>
    {% endif %}

    {% if has_price %}
      <div{{ price_wrapper_attributes }}>
        <div{{ price_row_attributes }}>
          <h4{{ price_heading_attributes }}>
            <data{{ data_attributes }}>
              {% if symbol_position == 'before' %}
                <span{{ symbol_attributes }}>{{ currency_symbol }}</span>
                <span>{{ price }}</span>
              {% else %}
                <span>{{ price }}</span>
                <span{{ symbol_attributes }}>{{ currency_symbol }}</span>
              {% endif %}
            </data>
          </h4>

          {% if has_price_period %}
            <span{{ period_attributes }}>{{ price_period_value }}</span>
          {% endif %}
        </div>

        {% if has_price_note %}
          <div{{ note_attributes }}>{{ price_note_value }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if has_features %}
      <div{{ features_wrapper_attributes }}>
        <div{{ features_content_attributes }}>
          {{ text|raw }}
        </div>
      </div>
    {% endif %}

    {% if has_button %}
      <div{{ button_wrapper_attributes }}>
        {{ include('vartheme_bs5:button', {
          href: button_href_value,
          label: button_label_value,
          variant: button_variant_class,
          size: 'btn-sm',
          target: btn_target,
        }, with_context: false) }}
      </div>
    {% endif %}
  </div>
</article>
