{% stories IconToggle with {
  title: 'Organisms/Icon Toggle',
  parameters: {
    componentSubtitle: 'Single icon button that overlays a popover panel',
    docs: {
      description: {
        component: 'A single icon button, meant to sit at the end of the header/navbar (or anywhere else). Clicking it overlays a popover panel holding whatever is dropped into the "content" slot, without hiding sibling elements (e.g. the main menu).',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    icon: {
      name: 'Icon',
      description: 'Bootstrap Icon name shown in the closed state. Swaps to a close (X) icon while the panel is open.',
      defaultValue: 'search',
      control: 'select',
      options: {
        Search: 'search',
        Person: 'person',
        People: 'people',
        Info: 'info',
        Question: 'question',
        "'Chevron down'": 'chevron-down',
      },
    },
    label: {
      name: 'Label',
      description: 'Accessible label for the closed state (visually hidden).',
      defaultValue: 'Search',
      control: 'text',
    },
    open_label: {
      name: 'Open state label',
      description: 'Accessible label announced while the panel is open.',
      defaultValue: 'Close search',
      control: 'text',
    },
    placement: {
      name: 'Panel alignment',
      description: 'Which side of the button the popover panel aligns to (logical, RTL-aware).',
      defaultValue: 'end',
      control: 'select',
      options: {
        "'End side'": 'end',
        "'Start side'": 'start',
      },
    },
    panel: {
      name: 'Panel style',
      description: 'A boxed popover under the button, or an inline search bar on one hairline-underlined line.',
      defaultValue: 'popover',
      control: 'select',
      options: {
        "'Boxed popover'": 'popover',
        "'Inline bar'": 'bar',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default (search, empty panel)',
  args: {
    icon: 'search',
    label: 'Search',
    open_label: 'Close search',
    placement: 'end',
  },
} %}
{{ include('vartheme_bs5:icon-toggle') }}
{% endstory %}

{% story WithContent with {
  name: 'With content (search form)',
  args: {
    icon: 'search',
    label: 'Search',
    open_label: 'Close search',
    placement: 'end',
    content: '<form class="views-exposed-form form"><div class="form-group"><label for="edit-keywords" class="visually-hidden">Search</label><input type="text" id="edit-keywords" class="form-control" placeholder="Enter search keywords"></div><button type="submit" class="btn btn-primary mt-2">Search</button></form>',
  },
} %}
{% embed 'vartheme_bs5:icon-toggle' %}
  {% block content %}{{ content|raw }}{% endblock %}
{% endembed %}
{% endstory %}

{% story AccountToggle with {
  name: 'Custom icon (account)',
  args: {
    icon: 'person',
    label: 'Account',
    open_label: 'Close account menu',
    placement: 'end',
    content: '<a class="d-block mb-2" href="#">My account</a><a class="d-block" href="#">Log out</a>',
  },
} %}
{% embed 'vartheme_bs5:icon-toggle' %}
  {% block content %}{{ content|raw }}{% endblock %}
{% endembed %}
{% endstory %}

{% story SearchBar with {
  name: 'Inline search bar',
  args: {
    icon: 'search',
    label: 'Search',
    open_label: 'Close search',
    placement: 'end',
    panel: 'bar',
    content: '<form class="views-exposed-form form"><div class="form-item"><label for="edit-keywords-bar" class="visually-hidden">Search</label><input type="text" id="edit-keywords-bar" class="form-control" placeholder="Search by keyword"></div><div class="form-actions"><input type="submit" class="btn btn-primary" value="Search"></div></form>',
  },
} %}
{% embed 'vartheme_bs5:icon-toggle' %}
  {% block content %}{{ content|raw }}{% endblock %}
{% endembed %}
{% endstory %}

{% story StartAligned with {
  name: 'Start-aligned panel',
  args: {
    icon: 'search',
    label: 'Search',
    open_label: 'Close search',
    placement: 'start',
  },
} %}
{{ include('vartheme_bs5:icon-toggle') }}
{% endstory %}

{% endstories %}
