{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Card Icon component.
 *
 * Bootstrap 5 Icon Card.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set text_align_class = text_align|default('text-center') %}
{% set icon_name = icon|default('people') %}
{% set icon_size_value = icon_size|default('fs-4')|trim %}
{% set background_color = background_color|default('bg-body') %}
{% set shadow_class = shadow|default('shadow') %}
{% set button_label_value = button_label|default('')|trim %}
{% set button_variant_value = button_variant|default('btn-primary')|trim %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set has_padding = has_padding ?? true %}

{# Logic: link / button rendering decisions. #}
{% set has_url = url is defined and url is not empty and url != 'No URL' %}
{% set show_button = has_url and button_label_value != '' and button_variant_value != '' %}

{# Logic: background color may carry a paired text utility (e.g. "bg-primary text-white"). #}
{% set background_classes = background_color|split(' ') %}

{# Logic: icon row horizontal alignment follows the text alignment. #}
{% set icon_justify_map = {
  'text-start': 'justify-content-start',
  'text-center': 'justify-content-center',
  'text-end': 'justify-content-end',
} %}
{% set icon_justify_class = icon_justify_map[text_align_class]|default('justify-content-center') %}

{% set body_padding_class = has_padding ? 'p-4' : '' %}

{# Logic: class arrays merged for each element. #}
{% set card_classes = ['card', 'overflow-hidden']|merge(background_classes) %}
{% if shadow_class and shadow_class != 'shadow-none' %}
  {% set card_classes = card_classes|merge([shadow_class]) %}
{% endif %}

{% set body_classes = ['card-body', 'd-flex', 'flex-column', text_align_class] %}
{% if body_padding_class %}
  {% set body_classes = body_classes|merge([body_padding_class]) %}
{% endif %}

{% set icon_row_classes = ['d-flex', icon_justify_class] %}
{% set heading_classes = ['h5', 'mt-3', 'mb-2'] %}
{% set description_classes = ['opacity-75'] %}
{% set button_wrapper_classes = ['mt-3'] %}

{% set attributes = attributes.addClass(card_classes) %}
{% set body_attributes = create_attribute().addClass(body_classes) %}
{% set icon_row_attributes = create_attribute().addClass(icon_row_classes) %}
{% set heading_attributes = create_attribute().addClass(heading_classes) %}
{% set description_attributes = create_attribute().addClass(description_classes) %}
{% set button_wrapper_attributes = create_attribute().addClass(button_wrapper_classes) %}

{# Print the HTML. #}
<div{{ attributes }}>
  <div{{ body_attributes }}>

    {% if icon_name is not empty and icon_name != 'none' %}
      <div{{ icon_row_attributes }}>
        {{ include('vartheme_bs5:bootstrap-icon', {
          icon: icon_name,
          icon_size: icon_size_value,
        }, with_context: false) }}
      </div>
    {% endif %}

    {% if text is not empty %}
      <h3{{ heading_attributes }}>{{ text }}</h3>
    {% endif %}

    {% if description is not empty %}
      <div{{ description_attributes }}>
        {{ description|raw }}
      </div>
    {% endif %}

    {% if show_button %}
      <div{{ button_wrapper_attributes }}>
        {{ include('vartheme_bs5:button', {
          href: url,
          label: button_label_value,
          variant: button_variant_value,
          size: 'btn-sm',
        }, with_context: false) }}
      </div>
    {% endif %}

  </div>
</div>
