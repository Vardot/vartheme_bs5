{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Views View Unformatted component.
 *
 * This template is used in two contexts:
 *
 * 1. As a theme template (via {% include "vartheme_bs5:views-view-unformatted" %}
 *    in templates/views/views-view-unformatted.html.twig). In this context the
 *    variables come from template_preprocess_views_view_unformatted():
 *    - title: The title of this group of rows. May be empty.
 *    - rows: A list of the view's row items where each item has:
 *      - attributes: The row's HTML attributes (Drupal\Core\Template\Attribute).
 *      - content: The row's rendered content.
 *    - view: The view object.
 *    - default_row_class: TRUE if default classes should be applied on rows.
 *
 * 2. As an SDC component (via ComponentsViewsStyle views style plugin). In
 *    this context the "rows" slot receives an array of render arrays from the
 *    views row plugin. Each row item is a render array, not a
 *    {attributes, content} object.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Logic: row classes shared by every row. #}
{%
  set row_classes = [
    default_row_class ? 'views-row',
  ]
%}

{# Print the HTML. #}
{% if title %}
  {{ include('vartheme_bs5:heading', {
      html_tag: 'h3',
      content: title,
    },
  ) }}
{% endif %}
{% for row in rows %}
  {% if row.content is defined %}
    {# Theme template context: rows come from template_preprocess_views_view_unformatted(). #}
    {% set row_attributes = row.attributes.addClass(row_classes) %}
    <div{{ row_attributes }}>
      {{- row.content -}}
    </div>
  {% else %}
    {# SDC component context: rows are render arrays from the views row plugin. #}
    {% set row_attributes = create_attribute().addClass(row_classes) %}
    <div{{ row_attributes }}>
      {{- row -}}
    </div>
  {% endif %}
{% endfor %}
