{% stories ViewsViewSummary with {
  title: 'Organisms/View Summary',
  parameters: {
    componentSubtitle: 'Displays a Drupal View summary as a list group using Bootstrap classes.',
    docs: {
      description: {
        component: 'A component to render view summary rows (`<ul>` or `<ol>`) with customizable classes for summary container, list, and list items.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    type: {
      name: 'List Type',
      description: 'The type of list: unordered (`ul`) or ordered (`ol`).',
      defaultValue: 'ul',
      control: 'select',
      options: {
        ul: 'Unordered list',
        ol: 'Ordered list',
      },
    },
    summary_utility_classes: {
      name: 'Summary Utility Classes',
      description: 'Utility classes for the summary wrapper container.',
      control: 'object',
      defaultValue: [],
    },
    list_utility_classes: {
      name: 'List Utility Classes',
      description: 'Classes applied to the `<ul>` or `<ol>` element.',
      control: 'object',
      defaultValue: [],
    },
    list_item_utility_classes: {
      name: 'List Item Utility Classes',
      description: 'Classes applied to each `<li>` element.',
      control: 'object',
      defaultValue: [],
    },
    attributes: {
      name: 'Attributes',
      description: 'HTML attributes for the view summary container.',
      control: 'object',
      defaultValue: {},
    },
    rows: {
      name: 'Rows',
      description: 'An array of view summary row objects.',
      control: 'object',
      defaultValue: [],
    },
  },
} %}

{% story ViewsViewSummaryDefault with {
  name: 'Default - Unordered Summary',
  args: {
    type: 'ul',
    rows: [
      {content: 'News (10)'},
      {content: 'Events (3)'},
      {content: 'Blog (5)'},
    ],
  },
} %}
  {{ include('vartheme_bs5:views-view-summary') }}
{% endstory %}

{% story ViewsViewSummaryOrdered with {
  name: 'Ordered Summary List',
  args: {
    type: 'ol',
    rows: [
      {content: 'January (2)'},
      {content: 'February (6)'},
      {content: 'March (4)'},
    ],
  },
} %}
  {{ include('vartheme_bs5:views-view-summary') }}
{% endstory %}

{% story ViewsViewSummaryWithUtilityClasses with {
  name: 'With Utility Classes',
  args: {
    type: 'ul',
    summary_utility_classes: ['mb-4', 'border', 'rounded'],
    list_utility_classes: ['list-group'],
    list_item_utility_classes: ['list-group-item', 'd-flex', 'justify-content-between'],
    rows: [
      {content: 'Jobs (8)'},
      {content: 'Tutorials (12)'},
      {content: 'Releases (1)'},
    ],
  },
} %}
  {{ include('vartheme_bs5:views-view-summary') }}
{% endstory %}

{% endstories %}
