{% stories HeroBillboard with {
    title: 'Hero/Hero Billboard',
    parameters: {
        componentSubtitle: 'Bootstrap hero billboard with background image, overlay, and flexible content positioning.',
        docs: {
            description: {
                component: 'Hero billboard with configurable container, alignment, overlay, and a rich hero_slot content area.',
            },
            story: {
                inline: true,
            },
        },
    },
} %}

{% story Default with {
    name: 'Default',
    args: {
        container_type: 'container',
        bg_edge2edge: false,
        height: 'ribbon',
        flex_position: 'center-left',
        overlay_bg: 'bg-dark',
        overlay_opacity: 'opacity-50',
        content_width: 'w-100',
        object_position: 'center',
        media: {
            src: 'assets/hero-bg-placeholder.svg',
            alt: 'Background image',
            width: 1920,
            height: 1075,
        },
        hero_slot: '<div class="text-white"><h2 class="display-5 mb-3">Hero billboard title</h2><p class="lead mb-0">Add any rich content inside the hero slot.</p></div>',
    },
} %}
{% embed 'vartheme_bs5:hero-billboard' with {
    container_type: container_type|default('container'),
    bg_edge2edge: bg_edge2edge|default(false),
    height: height|default('ribbon'),
    flex_position: flex_position|default('center-left'),
    overlay_bg: overlay_bg|default('bg-dark'),
    overlay_opacity: overlay_opacity|default('opacity-50'),
    content_width: content_width|default('w-100'),
    object_position: object_position|default('center'),
    media: media|default({}),
} only %}
    {% block hero_slot %}
        {{ hero_slot|default('')|raw }}
    {% endblock %}
{% endembed %}
{% endstory %}

