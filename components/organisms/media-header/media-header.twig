{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Media Header component.
 *
 * Available properties:
 * - media_type: Media entity type. (image, video, remote_video).
 * - provider: Video provider (for remote video) (youtube, video).
 * - media_header_utility_classes: (optional) An array of utility classes. Use to add extra Bootstrap utility classes or custom CSS classes over to this to this component.
 *
 * Available attributes:
 * - N/A
 *
 * Available slots:
 * - page_breadcrumbs: Media Header page breadcrumbs.
 * - page_title: Media Header page title.
 * - background_media: Background media (Image, local or remote videos).
 *
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: utility classes. #}
{% set media_header_utility_classes = media_header_utility_classes ?? [] %}

{# Logic: merge root classes as arrays. #}
{% set classes = [
  'vmh-container',
  'bg-edge2edge',
]|merge(media_header_utility_classes) %}

{# Logic: static structural class lists as arrays. #}
{% set content_wrapper_classes = ['vmh-content-wrapper'] %}
{% set container_classes = ['container'] %}
{% set row_classes = ['row'] %}
{% set content_classes = ['vmh-content'] %}
{% set breadcrumb_classes = ['vmh-breadcrumb'] %}
{% set background_classes = ['vmh-background'] %}

{% set attributes = attributes.addClass(classes) %}

{# Print the HTML. #}
<header{{ attributes }}>
  <div class="{{ content_wrapper_classes|join(' ') }}">
    <div class="{{ container_classes|join(' ') }}">
      <div class="{{ row_classes|join(' ') }}">
        <div class="{{ content_classes|join(' ') }}">
          {# System Page breadcrumbs #}
          {% if page_breadcrumbs %}
            <div class="{{ breadcrumb_classes|join(' ') }}">{{ page_breadcrumbs }}</div>
          {% endif %}

          {# System page title #}
          {% if page_title %}
            {{ include('vartheme_bs5:page-title', {
                title: page_title,
                page_title_utility_classes: ['vmh-page-title'],
                attributes: create_attribute(),
              },
            ) }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {# Background media #}
  <div class="{{ background_classes|join(' ') }}">{% if background_media %}{{ background_media }}{% endif %}</div>
</header>
