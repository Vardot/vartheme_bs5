  <div class="row mt-5">
    <div class="col">
      <h1>Welcome To Varbase's Design System</h1>
    </div>
  </div>

  <div class="row">
    <div class="col pt-3">
      <span class="h5">Your Shortcut to Stunning Websites</span>
