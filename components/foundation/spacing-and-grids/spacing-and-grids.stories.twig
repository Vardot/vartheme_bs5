  {# Spacing Scale #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Spacing &amp; Padding</h2>
    <p class="mb-2">Bootstrap spacer base: <code>$spacer = 1rem (16px)</code>. Utilities: <code>m-*</code> / <code>p-*</code> with values 0–5.</p>
    <div class="table-responsive mb-4">
      <table class="table table-bordered">
        <thead class="table-light">
          <tr><th>Step</th><th>Value</th><th>Pixels</th><th>Visual</th></tr>
        </thead>
        <tbody>
          <tr><td><code>0</code></td><td>0</td><td>0px</td><td><div class="bg-primary" style="height:10px;width:0px;">&nbsp;</div></td></tr>
          <tr><td><code>1</code></td><td>0.25rem</td><td>4px</td><td><div class="bg-primary" style="height:10px;width:4px;">&nbsp;</div></td></tr>
          <tr><td><code>2</code></td><td>0.5rem</td><td>8px</td><td><div class="bg-primary" style="height:10px;width:8px;">&nbsp;</div></td></tr>
          <tr><td><code>3</code></td><td>1rem</td><td>16px</td><td><div class="bg-primary" style="height:10px;width:16px;">&nbsp;</div></td></tr>
          <tr><td><code>4</code></td><td>1.5rem</td><td>24px</td><td><div class="bg-primary" style="height:10px;width:24px;">&nbsp;</div></td></tr>
          <tr><td><code>5</code></td><td>3rem</td><td>48px</td><td><div class="bg-primary" style="height:10px;width:48px;">&nbsp;</div></td></tr>
        </tbody>
      </table>
    </div>

    <h3 class="fw-bold mb-3">Padding visual</h3>
    <div class="d-flex flex-wrap gap-4 mb-5">
      <div><div class="p-0 bg-primary bg-opacity-10 border border-primary border-opacity-25"><span class="small px-1"><code>p-0</code></span></div></div>
      <div><div class="p-1 bg-primary bg-opacity-10 border border-primary border-opacity-25"><span class="small px-1"><code>p-1</code></span></div></div>
      <div><div class="p-2 bg-primary bg-opacity-10 border border-primary border-opacity-25"><span class="small px-1"><code>p-2</code></span></div></div>
      <div><div class="p-3 bg-primary bg-opacity-10 border border-primary border-opacity-25"><span class="small px-1"><code>p-3</code></span></div></div>
      <div><div class="p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25"><span class="small px-1"><code>p-4</code></span></div></div>
      <div><div class="p-5 bg-primary bg-opacity-10 border border-primary border-opacity-25"><span class="small px-1"><code>p-5</code></span></div></div>
