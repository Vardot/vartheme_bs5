      <div class="d-flex flex-fill gap-2 p-2">
        <div class="flex-fill bg-primary bg-opacity-25 d-flex align-items-center justify-content-center small">1</div>
        <div class="flex-fill bg-primary bg-opacity-25 d-flex align-items-center justify-content-center small">2</div>
        <div class="flex-fill bg-primary bg-opacity-25 d-flex align-items-center justify-content-center small">3</div>
        <div class="flex-fill bg-primary bg-opacity-25 d-flex align-items-center justify-content-center small">4</div>
