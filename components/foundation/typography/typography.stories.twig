{% stories FoundationTypography with {
  title: 'Foundation/Typography',
  parameters: {
    docs: {
      description: {
        component: 'Typography scale, typeface, and text styles for Vartheme BS5.',
      },
    },
  },
} %}

{% story Typography with {
  name: 'Typography',
} %}

<div class="px-5 py-5">
  <h1 class="fw-bold mb-5">Typography</h1>

  {# 01 - Typeface #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">01 — Typeface</h2>
    <div class="row g-5">
      <div class="col-md-6">
        <div class="mb-2"><small class="text-muted">primary</small></div>
        <p class="fs-4 mb-0">
          <span class="fw-normal">Inter — Regular, </span>
          <span class="fw-normal fst-italic">Italic</span>
          <span class="fw-normal"> and </span>
          <span class="fw-bold">Bold</span>
        </p>
      </div>
      <div class="col-md-6">
        <div class="mb-2"><small class="text-muted">secondary</small></div>
        <p class="fs-4 mb-0">Secondary Typeface — Weight</p>
      </div>
    </div>
  </div>

  {# 02 - Text Color Variables #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">02 — Text Color Variables</h2>
    <div class="row g-5">
      <div class="col-md-6">
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">default</div>
          <div class="px-3 py-1"><strong>Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">light</div>
          <div class="px-3 py-1 bg-dark"><strong class="text-light">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">primary</div>
          <div class="px-3 py-1"><strong class="text-primary">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">success</div>
          <div class="px-3 py-1"><strong class="text-success">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">warning</div>
          <div class="px-3 py-1"><strong class="text-warning">Text</strong></div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">subtle</div>
          <div class="px-3 py-1"><strong class="text-muted">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">white</div>
          <div class="px-3 py-1 bg-dark"><strong class="text-white">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">secondary</div>
          <div class="px-3 py-1"><strong class="text-secondary">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">danger</div>
          <div class="px-3 py-1"><strong class="text-danger">Text</strong></div>
        </div>
        <div class="border-bottom d-flex align-items-center" style="min-height: 50px;">
          <div style="width: 100px;" class="small text-muted">info</div>
          <div class="px-3 py-1"><strong class="text-info">Text</strong></div>
        </div>
      </div>
    </div>
  </div>

  {# 03 - Headings #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">03 — Headings</h2>
    <div class="py-3">
      <div class="row fw-bold mb-3">
        <div class="col-2">Heading</div>
        <div class="col-5">Desktop</div>
        <div class="col-5">Mobile</div>
      </div>
      <hr class="my-3">
      <div class="row align-items-center mb-3">
        <div class="col-2"><small class="text-muted">Heading 1</small></div>
        <div class="col-5"><h1 class="mb-0">Heading 1</h1></div>
        <div class="col-5"><h1 class="mb-0 fs-1">Heading 1</h1></div>
      </div>
      <hr class="my-3">
      <div class="row align-items-center mb-3">
        <div class="col-2"><small class="text-muted">Heading 2</small></div>
        <div class="col-5"><h2 class="mb-0">Heading 2</h2></div>
        <div class="col-5"><h2 class="mb-0 fs-2">Heading 2</h2></div>
      </div>
      <hr class="my-3">
      <div class="row align-items-center mb-3">
        <div class="col-2"><small class="text-muted">Heading 3</small></div>
        <div class="col-5"><h3 class="mb-0">Heading 3</h3></div>
        <div class="col-5"><h3 class="mb-0 fs-3">Heading 3</h3></div>
      </div>
      <hr class="my-3">
      <div class="row align-items-center mb-3">
        <div class="col-2"><small class="text-muted">Heading 4</small></div>
        <div class="col-5"><h4 class="mb-0">Heading 4</h4></div>
        <div class="col-5"><h4 class="mb-0 fs-4">Heading 4</h4></div>
      </div>
      <hr class="my-3">
      <div class="row align-items-center mb-3">
        <div class="col-2"><small class="text-muted">Heading 5</small></div>
        <div class="col-5"><h5 class="mb-0">Heading 5</h5></div>
        <div class="col-5"><h5 class="mb-0 fs-5">Heading 5</h5></div>
      </div>
      <hr class="my-3">
      <div class="row align-items-center mb-3">
        <div class="col-2"><small class="text-muted">Heading 6</small></div>
        <div class="col-5"><h6 class="mb-0">Heading 6</h6></div>
        <div class="col-5"><h6 class="mb-0 fs-6">Heading 6</h6></div>
      </div>
      <hr class="my-3">
    </div>
  </div>

  {# 04 - Display #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">04 — Display</h2>
    <div class="py-3">
      <div class="row fw-bold mb-3">
        <div class="col-2">Display</div>
        <div class="col-5">Desktop</div>
        <div class="col-5">Mobile</div>
      </div>
      <hr class="my-3">
      {% for n in 1..6 %}
        <div class="row align-items-center mb-3">
          <div class="col-2"><small class="text-muted">Display {{ n }}</small></div>
          <div class="col-5"><h1 class="display-{{ n }} mb-0">Display {{ n }}</h1></div>
          <div class="col-5"><h1 class="display-{{ n }} mb-0">Display {{ n }}</h1></div>
        </div>
        <hr class="my-3">
      {% endfor %}
    </div>
  </div>

  {# 05 - Body Styles #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">05 — Body Styles</h2>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Default</small></div>
      <p class="fs-5 lh-lg">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.</p>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Bold</small></div>
      <p class="fs-5 lh-lg fw-bold">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.</p>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Inline-link</small></div>
      <p class="fs-5 lh-lg">
        <a href="#" class="text-decoration-underline">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</a>
      </p>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Lead</small></div>
      <p class="lead lh-lg">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.</p>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Small</small></div>
      <p class="small lh-lg">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.</p>
    </div>

    {# List Examples #}
    <div class="py-3">
      <div class="row fw-bold mb-3">
        <div class="col-2">List</div>
        <div class="col-5">Desktop</div>
        <div class="col-5">Mobile</div>
      </div>
      <hr class="my-3">
      <div class="row mb-3">
        <div class="col-2"><small class="text-muted">Ordered</small></div>
        <div class="col-5">
          <ol class="fs-5 lh-lg ps-4">
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
            <li>Consectetur adipiscing elit.
              <ol type="a" class="ps-4">
                <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
                <li>Consectetur adipiscing elit.</li>
              </ol>
            </li>
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
          </ol>
        </div>
        <div class="col-5">
          <ol class="fs-6 lh-base ps-3">
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
            <li>Consectetur adipiscing elit.
              <ol type="a" class="ps-4">
                <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
                <li>Consectetur adipiscing elit.</li>
              </ol>
            </li>
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
          </ol>
        </div>
      </div>
      <hr class="my-3">
      <div class="row mb-3">
        <div class="col-2"><small class="text-muted">Unordered</small></div>
        <div class="col-5">
          <ul class="fs-5 lh-lg ps-4">
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
            <li>Consectetur adipiscing elit.
              <ul class="ps-4">
                <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
                <li>Consectetur adipiscing elit.</li>
              </ul>
            </li>
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
          </ul>
        </div>
        <div class="col-5">
          <ul class="fs-6 lh-base ps-3">
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
            <li>Consectetur adipiscing elit.
              <ul class="ps-4">
                <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
                <li>Consectetur adipiscing elit.</li>
              </ul>
            </li>
            <li>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {# 06 - Other #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">06 — Other</h2>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Hero Title</small></div>
      <h1 class="display-1 mb-0">Hero Title</h1>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Hero Body</small></div>
      <p class="lead lh-lg">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.</p>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Quote</small></div>
      <blockquote class="border-start border-5 border-primary ps-4">
        <p class="lead fw-bold fst-italic lh-lg mb-2">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.</p>
        <footer class="fs-6 lh-lg text-muted">Quotee Name and Position</footer>
      </blockquote>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Date</small></div>
      <p class="fs-5 lh-lg">16 March 2022</p>
    </div>

    <div class="mb-4">
      <div class="mb-2"><small class="text-muted">Figure Numbers</small></div>
      <p class="display-2 fw-bold mb-0">123456</p>
    </div>
  </div>

</div>

{% endstory %}

{% endstories %}
