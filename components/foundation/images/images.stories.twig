{% stories FoundationImages with {
  title: 'Foundation/Images',
  parameters: {
    docs: {
      description: {
        component: 'Image utilities, aspect ratios, and responsive image patterns for Vartheme BS5.',
      },
    },
  },
} %}

{% story Images with {
  name: 'Images',
} %}

<div class="bg-white px-5 py-5">
  <h1 class="fw-bold mb-5">Images</h1>

  {# Responsive Images #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Responsive Images</h2>
    <img
      src="/components/foundation/images/assets/placeholder.jpg"
      class="img-fluid w-100"
      alt="Responsive image example"
    />
  </div>

  {# Image Thumbnails #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Image Thumbnails</h2>

    {# Hero Image #}
    <div class="border-top pt-4 mb-5">
      <h3 class="fw-bold mb-4">Hero Image</h3>
      <img
        src="/components/foundation/images/assets/hero-2.jpg"
        class="img-fluid w-100 object-fit-cover"
        style="max-height: 810px;"
        alt="Hero image example"
      />
    </div>

    {# Banner Image #}
    <div class="border-top pt-4 mb-5">
      <h3 class="fw-bold mb-4">Banner Image</h3>
      <img
        src="/components/foundation/images/assets/banner-1.jpg"
        class="img-fluid w-100 object-fit-cover"
        style="max-height: 465px;"
        alt="Banner image example"
      />
    </div>

    {# Teaser Image #}
    <div class="border-top pt-4 mb-5">
      <h3 class="fw-bold mb-4">Teaser Image</h3>
      <img
        src="/components/foundation/images/assets/teaser-1.jpg"
        class="img-fluid object-fit-cover"
        style="max-width: 750px; max-height: 440px;"
        alt="Teaser image example"
      />
    </div>
  </div>

  {# Image Alignment #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Image Alignment</h2>
    <div class="row g-4">
      <div class="col-6 col-md-3">
        <img src="/components/foundation/images/assets/teaser-1.jpg" class="img-fluid w-100 object-fit-cover" style="height: 220px;" alt="Teaser 1" />
        <p class="small text-muted mt-2 text-center"><code>float-start</code></p>
      </div>
      <div class="col-6 col-md-3">
        <img src="/components/foundation/images/assets/teaser-2.jpg" class="img-fluid w-100 object-fit-cover" style="height: 220px;" alt="Teaser 2" />
        <p class="small text-muted mt-2 text-center"><code>mx-auto d-block</code></p>
      </div>
      <div class="col-6 col-md-3">
        <img src="/components/foundation/images/assets/teaser-3.jpg" class="img-fluid w-100 object-fit-cover" style="height: 220px;" alt="Teaser 3" />
        <p class="small text-muted mt-2 text-center"><code>float-end</code></p>
      </div>
      <div class="col-6 col-md-3">
        <img src="/components/foundation/images/assets/teaser-1.jpg" class="img-fluid w-100 object-fit-cover" style="height: 220px;" alt="Teaser 4" />
        <p class="small text-muted mt-2 text-center"><code>img-fluid</code></p>
      </div>
    </div>
  </div>

  {# Image Element #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Image Element</h2>
    <img
      src="/components/foundation/images/assets/placeholder.jpg"
      class="img-fluid"
      style="width: 380px; height: 380px; object-fit: cover;"
      alt="Image element example"
    />
  </div>

  {# Teasers gallery #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Teasers</h2>
    <div class="row g-3">
      <div class="col-md-4">
        <img src="/components/foundation/images/assets/teaser-1.jpg" class="img-fluid w-100 object-fit-cover" style="height: 280px;" alt="Teaser 01" />
      </div>
      <div class="col-md-4">
        <img src="/components/foundation/images/assets/teaser-2.jpg" class="img-fluid w-100 object-fit-cover" style="height: 280px;" alt="Teaser 02" />
      </div>
      <div class="col-md-4">
        <img src="/components/foundation/images/assets/teaser-3.jpg" class="img-fluid w-100 object-fit-cover" style="height: 280px;" alt="Teaser 03" />
      </div>
    </div>
  </div>

  {# Hero gallery #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Hero</h2>
    <div class="row g-3">
      <div class="col-12">
        <img src="/components/foundation/images/assets/hero-1.jpg" class="img-fluid w-100 object-fit-cover" style="height: 400px;" alt="Hero 01" />
      </div>
      <div class="col-12">
        <img src="/components/foundation/images/assets/hero-2.jpg" class="img-fluid w-100 object-fit-cover" style="height: 400px;" alt="Hero 02" />
      </div>
    </div>
  </div>

  {# Banner gallery #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Banner</h2>
    <div class="row g-3">
      <div class="col-12">
        <img src="/components/foundation/images/assets/banner-1.jpg" class="img-fluid w-100 object-fit-cover" style="height: 300px;" alt="Banner 01" />
      </div>
      <div class="col-12">
        <img src="/components/foundation/images/assets/banner-2.jpg" class="img-fluid w-100 object-fit-cover" style="height: 300px;" alt="Banner 02" />
      </div>
    </div>
  </div>

</div>

{% endstory %}

{% endstories %}
