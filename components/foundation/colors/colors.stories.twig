<style>
  .color-grid {
    display: grid;
    grid-template-columns: 100px repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .color-grid-header {
    display: grid;
    grid-template-columns: 100px repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .color-grid-header span {
    font-size: 0.875rem;
    font-weight: bold;
    color: var(--bs-secondary-color);
  }
  .color-name {
    display: flex;
    align-items: center;
    font-size: 0.875rem;
  }
  .color-swatch {
    height: 50px;
    border-radius: var(--bs-border-radius);
    display: flex;
    color: var(--bs-white);
    font-size: 0.75rem;
    font-weight: bold;
    box-shadow: var(--bs-box-shadow-sm);
    align-items: center;
    justify-content: start;
    padding-inline: 0.5rem 0.5rem;
  }
  .swatch-border {
    border: 1px solid var(--bs-border-color);
  }

</style>

