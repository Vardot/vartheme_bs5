      </div>
    </div>
    <div class="col">
      <div class="w-100 py-5 d-flex justify-content-center">
        <img class="m-5" src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-incorrect--logo-white.png" alt="Incorrect Varbase logo" title="Incorrect Varbase logo" />
      </div>
    </div>
  </div>

