      <div class="bg-light w-100 py-5 d-flex justify-content-center">
        <img class="m-5" src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-logo-emblem-colored-266x46.png" alt="Colored Varbase Logo emblem" title="Colored Varbase Logo emblem"/>
      </div>
    </div>
    <div class="col">
      <div class="bg-primary w-100 py-5 d-flex justify-content-center">
