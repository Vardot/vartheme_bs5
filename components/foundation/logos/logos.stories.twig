{% story Logos with {
  name: 'Logos',
} %}

<div class="px-5 py-5">
  <h1 class="fw-bold mb-5">Logo &amp; Share Image</h1>

  {# Logo section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Logo</h2>
    <div class="row g-0 mb-3">
      <div class="col">
        <div class="bg-light d-flex align-items-center justify-content-center py-5">
          <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-logo-emblem-colored-266x46.png"
               alt="Colored Varbase Logo emblem"
               title="Colored Varbase Logo emblem" />
        </div>
      </div>
      <div class="col">
        <div class="bg-primary d-flex align-items-center justify-content-center py-5">
          <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-logo-emblem-white-266x46.png"
               alt="White Varbase Logo emblem"
               title="White Varbase Logo emblem" />
        </div>
      </div>
    </div>
    <h3 class="fw-bold mb-3">Original Size</h3>
    <div class="ms-3">
      <img style="width: 118px;"
           src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-logo-emblem-colored.svg"
           alt="Original Varbase Logo Size" />
    </div>
  </div>

  {# Usage section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-2">Usage</h2>
    <p class="mb-4">Varbase's Logo should always be use lowercase <strong>v</strong>. No capital <strong>V</strong>.</p>
    <div class="row g-0">
      <div class="col">
        <div class="border border-success d-flex flex-column align-items-center justify-content-center py-5 gap-3">
          <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-logo-emblem-colored.svg"
               style="width: 118px;"
               alt="Correct Varbase logo" />
          <span class="text-success small">Correct</span>
        </div>
      </div>
      <div class="col">
        <div class="border border-danger d-flex flex-column align-items-center justify-content-center py-5 gap-3">
          <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-logo-emblem-colored.svg"
               style="width: 118px; text-transform: capitalize;"
               alt="Incorrect Varbase logo" />
          <span class="text-danger small">Incorrect</span>
        </div>
      </div>
    </div>
  </div>

  {# Favicon section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Favicon</h2>
    <div class="d-flex align-items-end gap-3">
      <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/fivecon-152x152.png"
           alt="Varbase Favicon 152x152" title="152x152" />
      <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/fivecon-120x120.png"
           alt="Varbase Favicon 120x120" title="120x120" />
      <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/fivecon-76x76.png"
           alt="Varbase Favicon 76x76" title="76x76" />
      <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/fivecon-60x60.png"
           alt="Varbase Favicon 60x60" title="60x60" />
      <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/fivecon-16x16.png"
           alt="Varbase Favicon 16x16" title="16x16" />
    </div>
  </div>

  {# Share Image section #}
  <div class="border-top pt-4 mb-5">
    <h2 class="fw-bold mb-4">Share Image</h2>
    <div class="bg-light d-flex align-items-center justify-content-center py-5">
      <img src="https://raw.githubusercontent.com/Vardot/varbase-assets/refs/heads/main/v10-01-x/varbase-social-share.png"
           class="img-fluid"
           alt="Varbase Social share image"
           title="Varbase Social share image" />
    </div>
  </div>
</div>

{% endstory %}

{% endstories %}
