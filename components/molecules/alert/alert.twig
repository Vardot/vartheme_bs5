{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Alert component.
 *
 * Available properties:
 * - variant: Bootstrap predefined alert variant.
 *            (primary|secondary|success|info|warning|danger|light|dark)
 * - dismissible: It is possible to dismiss any alert inline. When an alert
 *   is dismissed, the element is completely removed from the page structure.
 *
 * Available slots:
 * - heading: Alerts can also contain a primary alert heading.
 * - content: The content of the alert.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: boolean props. #}
{% set dismissible = dismissible ?? true %}

{# Logic: merge alert classes as arrays. #}
{% set variant_classes = variant ? ['alert-' ~ variant] : [] %}
{% set dismissible_classes = dismissible ? ['alert-dismissible', 'fade', 'show'] : [] %}

{% set classes = [
  'alert',
]|merge(variant_classes)|merge(dismissible_classes) %}

{% set attributes = attributes.addClass(classes) %}
{% set attributes = attributes.setAttribute('role', 'alert') %}

{# Print the HTML. #}

<div{{ attributes }}>
  {% if heading|render|striptags|trim is not empty %}
    {{ include('vartheme_bs5:heading', {
      heading_text: heading|render|striptags|trim,
      level: 4,
      extra_classes: 'alert-heading',
    }, false) }}
  {% endif %}

  {% block content %}
    {{ content }}
  {% endblock %}

  {% if dismissible %}
    {% set close_attrs = create_attribute() %}
    {% set close_attrs = close_attrs.setAttribute('data-bs-dismiss', 'alert') %}
    {{ include('vartheme_bs5:close-button', {
        size: 'btn-sm',
        attributes: close_attrs,
      }, with_context: false) }}
  {% endif %}
</div>
