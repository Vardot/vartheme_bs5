{#
  Bootstrap Alert
  Props:
    - type (string): "" or "alert-primary" etc
    - dismissible (bool)
    - heading (string)
    - message (string)
    - html_id (string)
    - extra_classes (string)
  Slot:
    - content
#}

{% set attributes = attributes|default(create_attribute()) %}

{# Ensure safe scalar defaults (prevents runtime issues) #}
{% set variant = type|default('') %}
{% set is_dismissible = dismissible|default(false) %}
{% set heading_text = heading|default('') %}
{% set message_text = message|default('') %}
{% set html_id = html_id|default('') %}
{% set extra_classes = extra_classes|default('') %}

{% set classes = ['alert'] %}
{% if variant|trim %}
  {% set classes = classes|merge([variant|trim]) %}
{% else %}
  {# Optional: choose a sensible default visual if blank #}
  {% set classes = classes|merge(['alert-primary']) %}
{% endif %}

{% if is_dismissible %}
  {% set classes = classes|merge(['alert-dismissible', 'fade', 'show']) %}
{% endif %}

{% if extra_classes|trim %}
  {% set classes = classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

{% if html_id|trim %}
  {% set attributes = attributes.setAttribute('id', html_id|trim) %}
{% endif %}

{# Slot content (Canvas provides variable; fallback to Twig block) #}
{% if content is defined %}
  {% set slot_content = content %}
{% else %}
  {% set slot_content %}{% block content %}{% endblock %}{% endset %}
{% endif %}

<div role="alert" {{ attributes.addClass(classes) }}>
  {% if heading_text|trim %}
    <h4 class="alert-heading mb-2">{{ heading_text }}</h4>
  {% endif %}

  {% if message_text|trim %}
    <p class="mb-0">{{ message_text }}</p>
  {% endif %}

  {% if slot_content|trim %}
    <div class="{{ (message_text|trim or heading_text|trim) ? 'mt-2' : '' }}">
      {{ slot_content }}
    </div>
  {% endif %}

  {% if is_dismissible %}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  {% endif %}
</div>
