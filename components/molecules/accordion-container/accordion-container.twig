{#
  Accordion Container (Bootstrap 5)

  Props:
  - id: accordion id (optional)
  - flush: boolean
  - always_open: boolean (allow multiple items open)
  - extra_classes: string

  Slot:
  - accordion_content: one or more accordion items (e.g. vartheme_bs5:accordion-block)

  Important:
  - In SDC, slot content is provided as a variable (accordion_content). Using
    Twig blocks/embeds prevents Drupal from injecting the slot content.
  - We expose the generated id to children via `accordion_parent_id` so that
    nested accordion items can bind to the same parent (data-bs-parent).
#}

{% set accordion_id = id|default('')|trim %}
{% if accordion_id is empty %}
  {% set accordion_id = 'accordion-' ~ random(1000000) %}
{% endif %}

{% set classes = ['accordion'] %}
{% if flush %}
  {% set classes = classes|merge(['accordion-flush']) %}
{% endif %}
{% if extra_classes|default('')|trim %}
  {% set classes = classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

{# Make parent id available to nested accordion blocks rendered in the slot. #}
{% set accordion_parent_id = accordion_id %}
{% set accordion_always_open = always_open ? true : false %}
{% set accordion_color = color|default('default') %}

<div id="{{ accordion_id }}" class="{{ classes|join(' ') }}">
  {% if accordion_content is defined and accordion_content|render|trim is not empty %}
    {{ accordion_content }}
  {% else %}
    {# Fallback examples for Canvas preview when the slot is empty. #}
    <div class="accordion-item">
      <h3 class="accordion-header" id="heading-demo-1">
        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-demo-1" aria-expanded="true" aria-controls="collapse-demo-1">
          Accordion 1
        </button>
      </h3>
      <div id="collapse-demo-1" class="accordion-collapse collapse show" aria-labelledby="heading-demo-1" data-bs-parent="#{{ accordion_id }}">
        <div class="accordion-body">
          <p class="mb-0">Lorem ipsum dolor sit amet, consectetur adipisicing elit.</p>
        </div>
      </div>
    </div>

    <div class="accordion-item">
      <h3 class="accordion-header" id="heading-demo-2">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-demo-2" aria-expanded="false" aria-controls="collapse-demo-2">
          Accordion 2
        </button>
      </h3>
      <div id="collapse-demo-2" class="accordion-collapse collapse" aria-labelledby="heading-demo-2" data-bs-parent="#{{ accordion_id }}">
        <div class="accordion-body">
          <p class="mb-0">Sed ut perspiciatis unde omnis iste natus error sit voluptatem.</p>
        </div>
      </div>
    </div>
  {% endif %}
</div>
