{#
/**
 * @file
 * Vartheme BS5 override of the Webshare Share component.
 *
 * Renders the platform icons using the Bootstrap Icons font that ships with
 * Vartheme rather than the module's bundled SVG assets. This keeps every
 * sharing button visually consistent with the rest of the Vartheme UI and
 * inherits the theme's icon styling automatically.
 *
 * Props are identical to webshare:share — see the module component for
 * the full prop reference.
 */
#}
{% set classes = [
  'webshare',
  'webshare--' ~ (orientation|default('horizontal')),
  'webshare--' ~ (placement|default('inline')),
  'webshare--align-' ~ (alignment|default('start')),
  mobile_visibility == 'hide_mobile' ? 'webshare--hide-mobile',
  mobile_visibility == 'mobile_only' ? 'webshare--mobile-only',
] %}
{% set heading_id = webshare_links_id ? webshare_links_id ~ '-heading' : 'webshare-heading-' ~ random() %}
{% set region_label = heading ?: 'Share this page'|t %}

{# Map each platform key to its Bootstrap Icon class. The fall-through is
   'bi-share' so any custom platform added by an administrator still picks
   up a sensible default icon. #}
{% set bi_icons = {
  'linkedin': 'bi-linkedin',
  'facebook_share': 'bi-facebook',
  'x': 'bi-twitter-x',
  'whatsapp': 'bi-whatsapp',
  'copy': 'bi-clipboard',
} %}

<nav{{ attributes
  .addClass(classes)
  .setAttribute('aria-label', region_label)
  .setAttribute('data-webshare-url', url)
  .setAttribute('data-webshare-title', share_title)
  .setAttribute('data-webshare-text', share_text)
}}>
  {% if heading %}
    <h3 id="{{ heading_id }}" class="webshare__heading">{{ heading }}</h3>
  {% endif %}
  <ul id="{{ webshare_links_id }}" class="webshare__list"{% if heading %} aria-labelledby="{{ heading_id }}"{% endif %}>
    {% if native_share %}
      <li class="webshare__item webshare__item--native" data-webshare-native>
        <button type="button" class="webshare__native-button" aria-label="{{ native_label|default('Share this page'|t) }}">
          {% if native_icon_html %}
            <span class="webshare__native-icon" aria-hidden="true">{{ native_icon_html|raw }}</span>
          {% else %}
            <i class="bi bi-share-fill webshare__native-icon" aria-hidden="true"></i>
          {% endif %}
          <span class="visually-hidden">{{ native_label|default('Share'|t) }}</span>
        </button>
      </li>
    {% endif %}
    {% for platform in platforms|default([]) %}
      {% set bi_class = bi_icons[platform.key]|default('bi-share') %}
      <li class="webshare__item webshare__item--{{ platform.key }}">
        {% if platform.is_copy %}
          <button type="button" class="webshare-copy-url" data-url="{{ url }}" data-clipboard="{{ url }}" aria-label="{{ platform.title|default('Copy URL'|t) }}">
            {% if platform.icon_html %}
              <span aria-hidden="true">{{ platform.icon_html|raw }}</span>
            {% else %}
              <i class="bi {{ bi_class }}" aria-hidden="true"></i>
            {% endif %}
            <span class="visually-hidden">{{ platform.title|default('Copy URL'|t) }}</span>
          </button>
        {% else %}
          <a href="{{ platform.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ platform.title }} {{ '(opens in a new tab)'|t }}">
            {% if platform.icon_html %}
              <span aria-hidden="true">{{ platform.icon_html|raw }}</span>
            {% else %}
              <i class="bi {{ bi_class }}" aria-hidden="true"></i>
            {% endif %}
            <span class="visually-hidden">{{ platform.title }} {{ '(opens in a new tab)'|t }}</span>
          </a>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
