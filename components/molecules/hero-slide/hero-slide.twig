{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Hero Slide component.
 *
 * Intended use:
 * - Place multiple "Hero Slide" components inside "Hero Slider (Container)" slot.
 *
 * Container context variables used:
 * - hero_slider_media_position (default media position)
 * - hero_slider_container_type (content width for overlay slides)
 *
 * Available attributes (structural wrappers routed through the attribute object):
 * - attributes: the outermost `carousel-item` slide root <div>.
 * - content_container_attributes: content container <div> (container/-fluid).
 * - inner_row_attributes: inner `row g-0` <div>.
 * - overlay_content_col_attributes: overlay content column <div>.
 * - split_content_col_attributes: split-layout content column <div>.
 * - split_wrap_attributes: split-layout outer `h-100` <div>.
 * - split_container_attributes: split-layout `container h-100` <div>.
 * - img_col_attributes: split-layout image column <div>.
 * - text_col_attributes: split-layout text column <div>.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{{ attach_library('vartheme_bs5/framework') }}

{% macro media_src(media) %}
  {% if media is iterable %}
    {% if media.src is defined and media.src %}
      {{ media.src }}
    {% elseif media.url is defined and media.url %}
      {{ media.url }}
    {% elseif media.uri is defined and media.uri %}
      {{ media.uri }}
    {% else %}
      {{ '' }}
    {% endif %}
  {% else %}
    {{ '' }}
  {% endif %}
{% endmacro %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set enabled = enabled ?? true %}
{% set active = active ?? false %}

{% if enabled %}
  {# Variables: scalar props with schema defaults. #}
  {% set title_tag = title_tag|default('h2') %}
  {% set title_size = title_size|default('display-5') %}
  {% set content_max_width = content_max_width|default('normal') %}
  {% set vertical_alignment = vertical_alignment|default('center') %}
  {% set text_align = text_align|default('text-start') %}
  {% set split_gap = split_gap|default('md') %}
  {% set overlay_bg = overlay_bg|default('bg-dark') %}
  {% set overlay_opacity = overlay_opacity|default('opacity-50') %}
  {% set button_variant = button_variant|default('btn-primary') %}

  {# Logic: resolve media position from per-slide override or container default. #}
  {% set media_position_from_container = hero_slider_media_position|default('overlay') %}
  {% set resolved_media_position = media_position_from_container|trim|lower %}
  {% if media_position is defined and media_position and media_position != 'inherit' %}
    {% set resolved_media_position = media_position|trim|lower %}
  {% endif %}
  {% if resolved_media_position in ['no_media', 'no-media', 'nomedia'] %}
    {% set resolved_media_position = 'none' %}
  {% endif %}

  {% set bg_color = background_color|default(resolved_media_position == 'overlay' ? 'bg-transparent' : 'bg-white') %}
  {% set gap = split_gap %}
  {% set container_type = hero_slider_container_type|default('none') %}
  {% set pad_x = 'px-0' %}
  {% set pad_y = 'py-0' %}
  {% if resolved_media_position == 'overlay' %}
    {% set pad_x = 'px-0' %}
    {% set pad_y = 'pt-4 pt-lg-0 pb-4 pb-lg-0' %}
  {% elseif resolved_media_position == 'none' %}
    {% set pad_x = 'px-0' %}
    {% set pad_y = 'py-4' %}
  {% endif %}
  {% if resolved_media_position == 'start' and pad_x == 'px-0' %}
    {% set pad_x = 'px-0 px-lg-4' %}
  {% endif %}
  {% if resolved_media_position != 'overlay' and pad_y == 'py-0' %}
    {% set pad_y = 'py-3 py-lg-5' %}
  {% endif %}

  {% set title_tag_resolved = title_tag %}
  {% set title_size_resolved = title_size %}
  {% set content_size_resolved = 'fs-6' %}
  {% set overlay_bg_resolved = overlay_bg %}
  {% set overlay_opacity_resolved = overlay_opacity %}
  {% set object_pos = 'center' %}
  {% set img_fit = 'cover' %}
  {% set horizontal_align = 'start' %}
  {% set vertical_align = vertical_alignment %}
  {% set text_align_resolved = text_align %}
  {% set text_color_resolved = text_color|default(resolved_media_position == 'overlay' ? 'text-white' : 'text-dark') %}
  {% set max_width = content_max_width %}

  {% set title_final = (title is defined ? title : '')|trim %}
  {% if title_final == '' %}
    {% set title_final = 'Varbase; better than ever' %}
  {% endif %}

  {% set button_text_final = (button_text is defined ? button_text : '')|trim %}
  {% if button_text_final == '' %}
    {% set button_text_final = 'Learn more' %}
  {% endif %}

  {% set button_url_final = (button_url is defined ? button_url : '')|trim %}
  {% if button_url_final == '' %}
    {% set button_url_final = '/' %}
  {% endif %}

  {% set justify_map = {
    start: 'justify-content-start',
    center: 'justify-content-center',
    end: 'justify-content-end',
  } %}
  {% set align_map = {
    start: 'align-items-start',
    center: 'align-items-center',
    end: 'align-items-end',
  } %}
  {% set width_map = {
    narrow: 'col-lg-5',
    normal: 'col-lg-6',
    wide: 'col-lg-7',
  } %}
  {% set gap_map = {
    none: 'g-0',
    sm: 'g-2',
    md: 'g-3',
    lg: 'g-4',
  } %}

  {% set content_wrap_class = resolved_media_position == 'none' ? 'position-relative w-100 h-100' : 'position-absolute top-0 start-0 w-100 h-100' %}

  {% set content_container_class = '' %}
  {% if (resolved_media_position == 'overlay' or resolved_media_position == 'none') and container_type == 'container' %}
    {% set content_container_class = 'container' %}
  {% elseif (resolved_media_position == 'overlay' or resolved_media_position == 'none') and container_type == 'container-fluid' %}
    {% set content_container_class = 'container-fluid' %}
  {% elseif resolved_media_position == 'overlay' or resolved_media_position == 'none' %}
    {% set content_container_class = 'container' %}
  {% endif %}

  {% set overlay_classes = [] %}
  {% if resolved_media_position == 'overlay' and overlay_bg_resolved != 'none' %}
    {% set overlay_classes = [overlay_bg_resolved, overlay_opacity_resolved] %}
  {% endif %}

  {% set src_final = _self.media_src(media)|trim %}
  {% if resolved_media_position == 'none' %}
    {% set src_final = '' %}
  {% endif %}
  {% if src_final and (src_final starts with 'assets/') %}
    {% if componentMetadata is defined and componentMetadata.path is defined %}
      {% set src_final = (base_path|default('/')) ~ componentMetadata.path ~ '/' ~ src_final %}
    {% elseif directory is defined %}
      {% set src_final = (base_path|default('/')) ~ directory ~ '/components/atoms/hero-slider/hero-slide/' ~ src_final %}
    {% endif %}
  {% endif %}

  {% set has_media = src_final != '' %}
  {% set alt_final = (media.alt is defined and media.alt) ? media.alt : (title_final ? title_final : 'Slide image') %}
  {% set has_cta = button_text_final and button_url_final %}
  {% set cta_button_props = {
    label: button_text_final,
    href: button_url_final,
    variant: button_variant,
    size: 'btn-md',
  } %}

  {% set attributes = attributes.addClass('carousel-item') %}
  {% if active %}
    {% set attributes = attributes.addClass('active') %}
  {% endif %}
  {% set attributes = attributes
    .setAttribute('data-hero-slide', true)
    .setAttribute('data-hero-layout', resolved_media_position) %}

  {% set slide_item_attributes = create_attribute({
    class: ['hero-slider__item', 'position-relative', 'w-100'],
  }) %}
  {% if resolved_media_position != 'overlay' and bg_color %}
    {% set slide_item_attributes = slide_item_attributes.addClass(bg_color) %}
  {% endif %}

  {% set image_attributes = create_attribute({
    class: [
      'd-block',
      'hero-slider__img',
      'hero-slider__img-fit-' ~ img_fit,
      'hero-slider__img-pos-' ~ object_pos,
      'h-100',
      'w-100',
    ],
    src: src_final,
    alt: alt_final,
    loading: 'lazy',
    decoding: 'async',
  }) %}

  {% set overlay_gradient_attributes = create_attribute({
    class: ['hero-slider__overlay-gradient'],
    'aria-hidden': 'true',
  }) %}

  {% set overlay_layer_attributes = create_attribute({
    class: ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100'],
    'aria-hidden': 'true',
  }) %}
  {% if overlay_classes %}
    {% set overlay_layer_attributes = overlay_layer_attributes.addClass(overlay_classes) %}
  {% endif %}

  {% set fallback_overlay_attributes = create_attribute({
    class: ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100', 'bg-black'],
    'aria-hidden': 'true',
  }) %}

  {% set split_fallback_attributes = create_attribute({
    class: ['w-100', 'h-100', 'bg-black'],
    'aria-hidden': 'true',
  }) %}

  {% set content_wrap_attributes = create_attribute({
    class: [content_wrap_class, 'd-flex', justify_map[horizontal_align], align_map[vertical_align], 'hero-slider__content-wrap'],
  }) %}

  {% set content_inner_attributes = create_attribute({
    class: ['w-100', pad_y],
  }) %}

  {% set caption_attributes = create_attribute({
    class: ['hero-slider__caption', text_align_resolved, text_color_resolved],
  }) %}

  {% set title_attributes = create_attribute({
    class: ['hero-slider__title', title_size_resolved, 'mb-3'],
  }) %}

  {% set text_attributes = create_attribute({
    class: ['hero-slider__text', 'mb-4', content_size_resolved],
  }) %}

  {% set cta_wrap_attributes = create_attribute({
    class: ['mt-3'],
  }) %}

  {% set split_row_attributes = create_attribute({
    class: ['row', 'h-100', 'align-items-stretch', gap_map[gap]],
  }) %}

  {% set media_frame_attributes = create_attribute({
    class: ['h-100', 'w-100', 'position-relative'],
  }) %}

  {% set split_text_wrap_attributes = create_attribute({
    class: ['w-100', 'd-flex', justify_map[horizontal_align], align_map[vertical_align]],
  }) %}

  {% set content_col_classes = ['col-12', width_map[max_width]] %}
  {% set split_text_col_classes = ['col-12', pad_x] %}
  {% set img_col_classes = ['col-12', 'col-lg-6'] %}
  {% set text_col_classes = ['col-12', 'col-lg-6', 'd-flex'] %}

  {# Container/column wrappers route classes through the attribute object as
   # arrays so duplicate classes and data type conflicts are avoided. #}
  {% set content_container_classes = content_container_class != '' ? [content_container_class] : [] %}
  {% set content_container_attributes = create_attribute().addClass(content_container_classes) %}
  {% set inner_row_attributes = create_attribute({class: ['row', 'g-0']}) %}
  {% set overlay_content_col_attributes = create_attribute({class: content_col_classes}) %}
  {% set split_content_col_attributes = create_attribute({class: split_text_col_classes}) %}
  {% set split_wrap_attributes = create_attribute({class: ['h-100']}) %}
  {% set split_container_attributes = create_attribute({class: ['container', 'h-100']}) %}
  {% set img_col_attributes = create_attribute({class: img_col_classes}) %}
  {% set text_col_attributes = create_attribute({class: text_col_classes}) %}

  {% set overlay_content_markup %}
    <div{{ content_wrap_attributes }}>
      <div{{ content_inner_attributes }}>
        <div{{ content_container_attributes }}>
          <div{{ inner_row_attributes }}>
            <div{{ overlay_content_col_attributes }}>
              <div{{ caption_attributes }}>
                {% if title_final %}
                  <{{ title_tag_resolved }}{{ title_attributes }}>{{ title_final }}</{{ title_tag_resolved }}>
                {% endif %}
                {% if content %}
                  <div{{ text_attributes }}>{{ content|raw }}</div>
                {% endif %}
                {% if has_cta %}
                  <div{{ cta_wrap_attributes }}>
                    {{ include('vartheme_bs5:button', cta_button_props, with_context: false) }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endset %}

  {% set split_text_markup %}
    <div{{ split_text_wrap_attributes }}>
      <div{{ content_inner_attributes }}>
        <div{{ content_container_attributes }}>
          <div{{ inner_row_attributes }}>
            <div{{ split_content_col_attributes }}>
              <div{{ caption_attributes }}>
                {% if title_final %}
                  <{{ title_tag_resolved }}{{ title_attributes }}>{{ title_final }}</{{ title_tag_resolved }}>
                {% endif %}
                {% if content %}
                  <div{{ text_attributes }}>{{ content|raw }}</div>
                {% endif %}
                {% if has_cta %}
                  <div{{ cta_wrap_attributes }}>
                    {{ include('vartheme_bs5:button', cta_button_props, with_context: false) }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  {% endset %}

  {% set split_media_markup %}
    <div{{ media_frame_attributes }}>
      {% if has_media %}
        {{ include('vartheme_bs5:image', {
          media: { src: src_final, alt: alt_final },
          fit: 'object-fit-' ~ img_fit,
          width: 'w-100',
          loading: 'lazy',
        }, with_context=false) }}
      {% else %}
        <div{{ split_fallback_attributes }}></div>
      {% endif %}
    </div>
  {% endset %}

  <div{{ attributes }}>
    <div{{ slide_item_attributes }}>
      {% if resolved_media_position == 'overlay' or resolved_media_position == 'none' %}
        {% if has_media %}
          {{ include('vartheme_bs5:image', {
            media: { src: src_final, alt: alt_final },
            fit: 'object-fit-' ~ img_fit,
            width: 'w-100',
            loading: 'lazy',
          }, with_context=false) }}
        {% elseif resolved_media_position != 'none' %}
          <div{{ fallback_overlay_attributes }}></div>
        {% endif %}

        {% if resolved_media_position != 'none' %}
          <div{{ overlay_gradient_attributes }}></div>
        {% endif %}

        {% if overlay_classes %}
          <div{{ overlay_layer_attributes }}></div>
        {% endif %}

        {{ overlay_content_markup }}
      {% else %}
        <div{{ split_wrap_attributes }}>
          <div{{ split_container_attributes }}>
            <div{{ split_row_attributes }}>
              {% if resolved_media_position == 'start' %}
                <div{{ img_col_attributes }}>{{ split_media_markup }}</div>
                <div{{ text_col_attributes }}>{{ split_text_markup }}</div>
              {% else %}
                <div{{ text_col_attributes }}>{{ split_text_markup }}</div>
                <div{{ img_col_attributes }}>{{ split_media_markup }}</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
