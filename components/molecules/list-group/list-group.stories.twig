{#
/**
 * @file
 * list-group.stories.twig
 * Storybook stories for Bootstrap 5.3 List Group component
 */
#}
{% stories ListGroup with {
  "title": "Molecules/List Group",
  "parameters": {
    "componentSubtitle": "Bootstrap 5.3 List Group component for displaying flexible lists of content.",
    "docs": {
      "description": {
        "component": "A flexible component for displaying a series of content. Build complex lists with custom content and controls."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "items": {
      "name": "Items",
      "description": "Array of list group items to display.",
      "control": "object",
      "defaultValue": []
    },
    "flush": {
      "name": "Flush",
      "description": "Remove borders and rounded corners.",
      "control": "boolean",
      "defaultValue": false
    },
    "numbered": {
      "name": "Numbered",
      "description": "Add numbers to list items.",
      "control": "boolean",
      "defaultValue": false
    },
    "horizontal": {
      "name": "Horizontal",
      "description": "Make list group horizontal at breakpoint.",
      "control": "select",
      "options": {
        "None": "",
        "Always": "true",
        "Small": "sm",
        "Medium": "md", 
        "Large": "lg",
        "'Extra Large'": "xl",
        "'Extra Extra Large'": "xxl"
      },
      "defaultValue": ""
    },
    "utility_classes": {
      "name": "Utility Classes",
      "description": "Additional Bootstrap utility classes.",
      "control": "object",
      "defaultValue": []
    }
  }
} %}

{% story BasicListGroup with {
  "name": "Basic List Group",
  "args": {
    "items": [
      {"content": "An item"},
      {"content": "A second item"},
      {"content": "A third item"},
      {"content": "A fourth item"},
      {"content": "And a fifth one"}
    ]
  }
} %}
  {{ include("vartheme_bs5:list-group") }}
{% endstory %}

{% story ActiveDisabledItems with {
  "name": "Active and Disabled Items",
  "args": {
    "items": [
      {"content": "An active item", "active": true},
      {"content": "A second item"},
      {"content": "A third item"},
      {"content": "A fourth item"},
      {"content": "A disabled item", "disabled": true}
    ]
  }
} %}
  {{ include("vartheme_bs5:list-group") }}
{% endstory %}

{% story LinksAndButtons with {
  "name": "Links and Buttons",
  "args": {
    "items": [
      {"content": "The current link item", "href": "#", "active": true},
      {"content": "A second link item", "href": "#"},
      {"content": "A third link item", "href": "#"},
      {"content": "A fourth link item", "href": "#"},
      {"content": "A disabled link item", "href": "#", "disabled": true}
    ]
  }
} %}
  {{ include("vartheme_bs5:list-group") }}
{% endstory %}

