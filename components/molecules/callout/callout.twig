{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Callout component.
 *
 * Available properties:
 * - type: Predefined callout type styles.
 *         (''|bs-callout-info|bs-callout-warning|bs-callout-danger), If not provided the fallback default callout style will apply.
 * - callout_utility_classes: An array of utility classes. Use to add extra utility classes or custom CSS classes over to this component.
 *
 * Available attributes:
 * - attributes: HTML attributes for the callout element.
 *
 * Available slots:
 * - content: The content of the callout.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: type and utility class arrays. #}
{% set type_classes = type ? [type] : [] %}
{% set callout_utility_classes = callout_utility_classes ? callout_utility_classes : [] %}

{# Logic: merge the callout classes as arrays. #}
{% set classes = [
  'bs-callout',
]|merge(type_classes)|merge(callout_utility_classes) %}
{% set attributes = attributes.addClass(classes) %}
{% set attributes = attributes.setAttribute('role', 'note') %}

{# Print the HTML. #}
<div{{ attributes }}>
  {% block content %}
    {{ content }}
  {% endblock %}
</div>
