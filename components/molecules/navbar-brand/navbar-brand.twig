{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Navbar Brand component.
 *
 * Available config:
 * - text: the text to use for the brand.
 * - path: the path for the link. Leave blank for no link.
 * - image_path: the path for the logo image.
 * - image:
 *   - src: The source of the image
 *   - width: The width of the image
 *   - height: The height of the image
 *   - alt: The alternative text of the image
 * - navbar_brand_utility_classes: An array of utility classes.
 *
 * Available attributes:
 * - attributes: Attributes array.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Import navbar_brand itself. #}
{% import _self as navbar_brand %}

{# Declare a function called image that returns an image tag with all its attributes. #}
{% macro image(src, width, height, alt) %}
  <img src="{{ src }}" height="{{ height }}" width="{{ width }}" alt="{{ alt|default('') }}" class="brand-logo-image" />
{% endmacro %}

{# Variables: scalar props with schema defaults. #}
{% set navbar_brand_utility_classes = navbar_brand_utility_classes|default([]) %}

{# Logic: merge brand classes as arrays. #}
{% set link_classes = ['navbar-brand', 'd-flex', 'align-items-center']|merge(navbar_brand_utility_classes) %}
{% set span_classes = ['navbar-brand', 'h1', 'mb-0']|merge(navbar_brand_utility_classes) %}

{# Print the HTML. #}
{% if path %}
  {% set attributes = attributes
    .setAttribute('href', path)
    .addClass(link_classes)
    .setAttribute('aria-label', text)
  %}
  <a{{ attributes }}>
    {% if image_path %}
      {# Call image function that declared above. #}
      {{ navbar_brand.image(image_path, width, height, alt) }}
    {% endif %}
    {{ text }}
  </a>
{% else %}
  {% set attributes = attributes
    .setAttribute('aria-label', text)
    .addClass(span_classes)
  %}
  <span{{ attributes }}>
    {% if image_path %}
      {# Call image function that declared above. #}
      {{ navbar_brand.image(image_path, width, height, alt) }}
    {% endif %}
    {{ text }}
  </span>
{% endif %}
