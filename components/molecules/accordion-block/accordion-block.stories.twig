{% stories AccordionBlock with {
  title: 'Layout/Accordion/Accordion block',
  parameters: {
    componentSubtitle: 'Bootstrap accordion single item',
    docs: {
      description: {
        component: 'A single collapsible accordion item. Default style: secondary-subtle background, dark text. Hover: secondary background with primary (#0D6EFD) text. An optional color class can override the header button appearance.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    title: {
      name: 'Heading',
      control: 'text',
      defaultValue: 'Section title',
    },
    heading_level: {
      name: 'Heading level',
      control: 'select',
      defaultValue: 3,
      options: {
        H2: 2,
        H3: 3,
        H4: 4,
        H5: 5,
        H6: 6,
      },
    },
    open_by_default: {
      name: 'Expanded by default',
      control: 'boolean',
      defaultValue: true,
    },
    always_open: {
      name: 'Keep this item independent',
      control: 'boolean',
      defaultValue: false,
    },
    color: {
      name: 'Header color override',
      control: 'select',
      defaultValue: 'inherit',
      options: {
        "'Inherit from container'": 'inherit',
        Primary: 'text-bg-primary',
        Secondary: 'text-bg-secondary',
        Success: 'text-bg-success',
        Danger: 'text-bg-danger',
        Warning: 'text-bg-warning',
        Info: 'text-bg-info',
        Dark: 'text-bg-dark',
      },
    },
    item_id: {
      name: 'Item ID',
      control: 'text',
      defaultValue: '',
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    title: 'What is included?',
    heading_level: 3,
    open_by_default: true,
    always_open: false,
    color: 'inherit',
    item_id: '',
  },
} %}
{% set accordion_content %}
    <p class="mb-0">This section contains the accordion body content. You can place any content here including text, lists, images, buttons, or nested components.</p>
  {% endset %}
{{ attach_library('vartheme_bs5/accordion-scripts') }}
{{ include('vartheme_bs5:accordion-block', {
  title: title,
  heading_level: heading_level,
  open_by_default: open_by_default,
  always_open: always_open,
  color: color,
  item_id: item_id,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

{% story OpenByDefault with {
  name: 'Open by default',
  args: {
    title: 'Expanded on load',
    heading_level: 3,
    open_by_default: true,
    always_open: false,
    color: 'inherit',
    item_id: 'open-default',
  },
} %}
{% set accordion_content %}
    <p class="mb-0">This accordion item is expanded when the page first loads. Use <code>open_by_default: true</code> to reveal content immediately.</p>
  {% endset %}
{{ attach_library('vartheme_bs5/accordion-scripts') }}
{{ include('vartheme_bs5:accordion-block', {
  title: title,
  heading_level: heading_level,
  open_by_default: open_by_default,
  always_open: always_open,
  color: color,
  item_id: item_id,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

{% story ClosedByDefault with {
  name: 'Closed by default',
  args: {
    title: 'Hidden until clicked',
    heading_level: 3,
    open_by_default: false,
    always_open: false,
    color: 'inherit',
    item_id: 'closed-default',
  },
} %}
{% set accordion_content %}
