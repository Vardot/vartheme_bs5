{% story RichContent with {
  name: 'Rich content body',
  args: {
    title: 'Shipping & returns',
    heading_level: 3,
    open_by_default: true,
    always_open: false,
    color: 'inherit',
    item_id: 'rich-content',
  },
} %}
{% set accordion_content %}
    <p>Free standard shipping on all orders over $50. Estimated delivery times:</p>
    <ul class="mb-2">
      <li>Standard: 5–7 business days</li>
      <li>Express: 2–3 business days</li>
      <li>Overnight: next business day</li>
    </ul>
    <p class="mb-0">Returns are accepted within 30 days of purchase. <a href="#">View full returns policy.</a></p>
  {% endset %}
{{ attach_library('vartheme_bs5/accordion-scripts') }}
{{ include('vartheme_bs5:accordion-block', {
  title: title,
  heading_level: heading_level,
  open_by_default: open_by_default,
  always_open: always_open,
  color: color,
  item_id: item_id,
  accordion_content: accordion_content,
}, with_context: false) }}
{% endstory %}

