{#
  Accordion Item (Bootstrap 5)

  Intended use:
  - Place multiple "Accordion" (accordion-block) components inside an
    "Accordion container" (accordion-container) slot.

  Parent binding:
  - If `parent_id` is provided, it will be used for Bootstrap's
    `data-bs-parent` binding.
  - Otherwise, the component will try to use `accordion_parent_id` exposed by
    the surrounding accordion-container.

  Slot:
  - accordion_content: body content
#}

{% set parent_from_context = accordion_parent_id|default('') %}
{% set bound_parent = parent_id|default('')|trim %}
{% if bound_parent is empty %}
  {% set bound_parent = parent_from_context %}
{% endif %}

{% set allow_multiple = always_open ? true : (accordion_always_open|default(false) ? true : false) %}
{% set inherited_color = accordion_color|default('default') %}
{% set resolved_color = color|default('inherit') %}
{% if resolved_color == 'inherit' %}
  {% set resolved_color = inherited_color %}
{% endif %}

{% set uid = item_id|default('')|trim %}
{% if uid is empty %}
  {% set uid = (random(1000000) ~ '-' ~ 'now'|date('U')) %}
{% endif %}

{% set heading_id = 'heading-' ~ uid %}
{% set collapse_id = 'collapse-' ~ uid %}

{% set route_name = app.request.attributes.get('_route')|default('') %}
{% set is_canvas_preview = (route_name matches '/canvas/i') or (route_name matches '/sdc/i') or (route_name matches '/component/i') %}
{# In Canvas/preview contexts we keep items expanded for easier editing. #}
{% set expanded = is_canvas_preview ? true : (open_by_default ? true : false) %}
{% set button_classes = ['accordion-button'] %}
{% if resolved_color and resolved_color != 'default' %}
  {% set button_classes = button_classes|merge(['text-bg-' ~ resolved_color]) %}
{% endif %}
{% if not expanded %}
  {% set button_classes = button_classes|merge(['collapsed']) %}
{% endif %}

{% set collapse_classes = ['accordion-collapse', 'collapse'] %}
{% if expanded %}
  {% set collapse_classes = collapse_classes|merge(['show']) %}
{% endif %}

{% set item_classes = ['accordion-item'] %}
{% if resolved_color and resolved_color != 'default' %}
  {% set item_classes = item_classes|merge(['border-' ~ resolved_color]) %}
{% endif %}
{% if extra_classes|default('')|trim %}
  {% set item_classes = item_classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

<div class="{{ item_classes|join(' ') }}">
  <h{{ heading_level|default(3) }} class="accordion-header" id="{{ heading_id }}">
    <button
      class="{{ button_classes|join(' ') }}"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#{{ collapse_id }}"
      aria-expanded="{{ expanded ? 'true' : 'false' }}"
      aria-controls="{{ collapse_id }}"
    >
      {{ title|default('Accordion item') }}
    </button>
  </h{{ heading_level|default(3) }}>

  <div
    id="{{ collapse_id }}"
    class="{{ collapse_classes|join(' ') }}"
    aria-labelledby="{{ heading_id }}"
    {% if bound_parent and not allow_multiple %}data-bs-parent="#{{ bound_parent }}"{% endif %}
  >
    <div class="accordion-body">
      {% if accordion_content is defined and accordion_content|render|trim is not empty %}
        {{ accordion_content }}
      {% else %}
  {#
    Canvas-friendly default:
    If no slot content is provided, render the Text component so users can edit content later.
  #}
  {% set default_body = '<p class="mb-0">Accordion body content…</p>' %}
  {{ include('vartheme_bs5:text', {text: default_body, element: 'div'}, with_context: false) }}
{% endif %}
    </div>
  </div>
</div>
