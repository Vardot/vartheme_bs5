{#
  Accordion Item (Bootstrap 5)
#}

{# --- Resolve IDs and labels --- #}
{% set bound_parent = parent_id|default('')|trim %}
{% if bound_parent is empty %}
  {% set bound_parent = accordion_parent_id|default('') %}
{% endif %}

{% set uid = item_id|default('')|trim %}
{% if uid is empty %}
  {% set uid = random(1000000) ~ '-' ~ 'now'|date('U') %}
{% endif %}

{% set heading_level = heading_level|default(3) %}
{% set heading_id    = 'heading-'  ~ uid %}
{% set collapse_id   = 'collapse-' ~ uid %}
{% set title_text    = title|default('Accordion item') %}

{# --- Resolve color --- #}
{% set resolved_color = color|default('inherit') %}
{% if resolved_color == 'inherit' %}
  {% set resolved_color = accordion_color|default('') %}
{% endif %}

{# --- Resolve state flags --- #}
{% set allow_multiple    = always_open ? true : (accordion_always_open|default(false) ? true : false) %}
{% set route_name        = app.request.attributes.get('_route')|default('') %}
{% set is_canvas_preview = (route_name matches '/canvas/i') or (route_name matches '/sdc/i') or (route_name matches '/component/i') %}
{% set expanded          = is_canvas_preview ? true : (open_by_default ? true : false) %}
{% set has_slot_content  = accordion_content is defined and accordion_content|render|trim is not empty %}

{# --- Build class lists --- #}
{% set button_classes = ['accordion-button', 'fw-bold'] %}
{% if resolved_color %}
  {% set button_classes = button_classes|merge([resolved_color]) %}
{% endif %}
{% if not expanded %}
  {% set button_classes = button_classes|merge(['collapsed']) %}
{% endif %}

{% set collapse_classes = ['accordion-collapse', 'collapse'] %}
{% if expanded %}
  {% set collapse_classes = collapse_classes|merge(['show']) %}
{% endif %}

{% set body_classes = ['accordion-body'] %}
{% if is_canvas_preview %}
  {% set body_classes = body_classes|merge(['accordion-body--canvas']) %}
{% endif %}
{% if is_canvas_preview and not has_slot_content %}
  {% set body_classes = body_classes|merge(['accordion-body--canvas-empty']) %}
{% endif %}

{# --- Build attributes --- #}
{% set item_attributes = create_attribute({
  'class': ['accordion-item'],
}) %}

{% set heading_attributes = create_attribute({
  'class': ['accordion-header'],
  'id': heading_id,
}) %}

{% set button_attributes = create_attribute({
  'class': button_classes,
  'type': 'button',
  'data-bs-toggle': 'collapse',
  'data-bs-target': '#' ~ collapse_id,
  'aria-expanded': expanded ? 'true' : 'false',
  'aria-controls': collapse_id,
}) %}

{% set collapse_attributes = create_attribute({
  'id': collapse_id,
  'class': collapse_classes,
  'aria-labelledby': heading_id,
}) %}
{% if bound_parent and not allow_multiple %}
  {% set collapse_attributes = collapse_attributes.setAttribute('data-bs-parent', '#' ~ bound_parent) %}
{% endif %}

{% set body_attributes = create_attribute({
  'class': body_classes,
}) %}

{# --- HTML --- #}
<div{{ item_attributes }}>
  <h{{ heading_level }}{{ heading_attributes }}>
    <button{{ button_attributes }}>{{ title_text }}</button>
  </h{{ heading_level }}>

  <div{{ collapse_attributes }}>
    <div{{ body_attributes }}>
      <div class="accordion-body__content">
        {% if has_slot_content %}
          {{ accordion_content }}
        {% else %}
          {{ include('vartheme_bs5:text', {text: '<p class="mb-0">Accordion body content…</p>', element: 'div'}, with_context: false) }}
        {% endif %}
      </div>
    </div>
  </div>
</div>
