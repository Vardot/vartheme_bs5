{#
  Hero Slider Container (Bootstrap 5)

  Usage (Canvas):
  - Add "Hero Slider (Container)" component.
  - Inside its "Slides" slot, add unlimited "Hero Slide" components.
  - Reorder slides via drag & drop (Canvas component order).

  Notes:
  - Canvas does not support array-of-object props, so we use a slot.
  - If no slide is marked Active, we automatically mark the first slide active
    by patching the rendered markup (Canvas-safe).
#}

{#
  Attach only the theme framework library.
  In vartheme_bs5, `framework` depends on `bootstrap-scripts`, which already
  includes `bs-carousel-script`.
#}
{{ attach_library('vartheme_bs5/framework') }}

{% set base_id = html_id|default('heroSlider')|trim %}
{% if base_id is empty %}{% set base_id = 'heroSlider' %}{% endif %}
{# Always append a random suffix so duplicated sliders never share the same DOM id. #}
{% set carousel_id = (base_id|clean_id) ~ '-' ~ random(1000000) %}

{# Expose settings to nested Hero Slide items (similar to accordion container pattern). #}
{% set hero_slider_id = carousel_id %}
{% set hero_slider_media_position = media_position|default('overlay') %}
{% set hero_slider_bg_edge2edge = bg_edge2edge ? true : true %}
{% set hero_slider_container_type = container_type|default('none') %}
{% set hero_slider_section_padding_y = section_padding_y|default('py-0') %}
{# Default height requested: 700px #}
{% set hero_slider_slider_height = slider_height|default('700') %}
{% set hero_slider_controller_shape = controller_shape|default('round') %}
{% set hero_slider_controller_color = controller_color|default('primary') %}

{% set carousel_classes = 'carousel slide' %}
{% if transition|default('slide') == 'fade' %}{% set carousel_classes = carousel_classes ~ ' carousel-fade' %}{% endif %}

{#
  Width rule (requested):
  - Media position "Overlay background" => slider is full width.
  - Media position "Image left" / "Image right" => slider is container width.

  We still keep `container_type` for the *content* inside slides.
#}
{#
  Width rule is handled per slide:
  - Overlay slides are full width.
  - Split slides (left/right) wrap themselves in `.container`.
  This avoids double-containers when Canvas wraps components.
#}
{% set outer_container_class = '' %}

{# Content container class (used inside slides + empty-state preview). #}
{% set content_container_class = '' %}
{% if hero_slider_container_type == 'container' %}
  {% set content_container_class = 'container' %}
{% elseif hero_slider_container_type == 'container-fluid' %}
  {% set content_container_class = 'container-fluid' %}
{% else %}
  {% set content_container_class = 'container' %}
{% endif %}

{# Let Hero Slide know whether the whole slider is wrapped in a container. #}
{% set hero_slider_outer_container = outer_container_class ? true : false %}

{% set section_classes = [] %}
{% if hero_slider_section_padding_y %}{% set section_classes = section_classes|merge([hero_slider_section_padding_y]) %}{% endif %}
{% if extra_classes|default('')|trim %}{% set section_classes = section_classes|merge(extra_classes|trim|split(' ')) %}{% endif %}

{#
  Slot handling (Canvas-safe):
  - Do NOT pre-render slot content into a string (keeps bubbleable metadata).
  - We will activate the first slide (if needed) and build indicators via JS.
#}
{% set has_slides = slides is defined and slides|render|trim is not empty %}

{# Controller styles #}
{% set control_base = ['hero-slider__control'] %}
{% if hero_slider_controller_shape == 'round' %}
  {% set control_base = control_base|merge(['rounded-circle']) %}
{% elseif hero_slider_controller_shape == 'pill' %}
  {% set control_base = control_base|merge(['rounded-pill']) %}
{% else %}
  {% set control_base = control_base|merge(['rounded-0']) %}
{% endif %}

{# Controller icon color (no background, matches previous components). #}
{% set control_text_class = 'text-' ~ hero_slider_controller_color %}
{% if hero_slider_controller_color == 'white' %}
  {% set control_text_class = 'text-white' %}
{% endif %}

{% set slider_height_style = 'height: ' ~ hero_slider_slider_height ~ 'px; min-height: ' ~ hero_slider_slider_height ~ 'px;' %}

{#
  Keep class naming consistent with previous components:
  - `bg-edge2edge` is used across components for full-bleed backgrounds.
  - We also keep `hero-slider--edge2edge` for backward compatibility.
#}
<section class="hero-slider{% if hero_slider_bg_edge2edge %} hero-slider--edge2edge bg-edge2edge{% endif %} {{ section_classes|join(' ') }}">

{% if outer_container_class %}
    <div class="{{ outer_container_class }}">
  {% endif %}

  <div id="{{ carousel_id }}" class="{{ carousel_classes }}"
    style="--hero-controller-color: var(--bs-{{ hero_slider_controller_color }});"
    {% if autoplay %}data-bs-ride="carousel" data-bs-interval="{{ interval_ms|default(5000) }}"{% else %}data-bs-interval="false"{% endif %}
    {% if pause_on_hover %}data-bs-pause="hover"{% else %}data-bs-pause="false"{% endif %}
  >

    {# Inline styles scoped to this carousel instance (matches existing hero-slider component approach). #}
    <style>
      /* Scoped styles for this instance */
      #{{ carousel_id }} .hero-slider__item { {{ slider_height_style }} }
      #{{ carousel_id }} .hero-slider__img { width: 100%; height: 100%; }

      /* Overlay gradient (design match) */
      #{{ carousel_id }} .hero-slider__overlay-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(0,0,0,.75) 0%, rgba(0,0,0,.45) 42%, rgba(0,0,0,0) 75%);
        pointer-events: none;
      }

      /* Bottom nav (indicators + controls)
         - Overlay slides: nav aligns to the content container (not full-bleed).
         - Split slides: nav aligns under the content column (right side for image-left; left side for image-right).
      */
      #{{ carousel_id }} .hero-slider__nav {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 2.5rem;
        z-index: 5;
        pointer-events: none;
      }
      #{{ carousel_id }} .hero-slider__nav * { pointer-events: auto; }
      #{{ carousel_id }} .hero-slider__nav-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
      }

      /* Indicators (requested):
         - inactive: controller color ROUND border
         - active: controller color FILLED (still round)
      */
      #{{ carousel_id }} .carousel-indicators { position: static; margin: 0; gap: .5rem; }
      #{{ carousel_id }} .carousel-indicators [data-bs-target]{
        width: 10px;
        height: 10px;
        border-radius: 999px !important;
        border: 1px solid var(--hero-controller-color) !important;
        background-color: transparent !important;
        opacity: 1 !important;
        margin: 0;
      }
      #{{ carousel_id }} .carousel-indicators [data-bs-target].active {
        border-radius: 999px !important;
        background-color: var(--hero-controller-color) !important;
        border-color: var(--hero-controller-color) !important;
      }

      /* Controls */
      /* Tight spacing between prev / pause / next (design match) */
      #{{ carousel_id }} .hero-slider__controls { display: flex; align-items: center; gap: .35rem; }

      #{{ carousel_id }} .hero-slider__control {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: auto;
        height: 48px;
        border: 0;
        padding: 0;
        text-decoration: none;
        /* Arrows use circle-fill icons, so the button itself stays transparent. */
        background: transparent;
        border-radius: 999px;
        box-shadow: none;
      }
      #{{ carousel_id }} .hero-slider__control:hover { opacity: .92; }
      /* Bigger arrow icons (design match) */
      #{{ carousel_id }} .hero-slider__control svg { width: 34px; height: 34px; }

      /* Pause button: no background per requirement */
      #{{ carousel_id }} .hero-slider__control--pause { background: transparent; box-shadow: none; }
      /* Bigger pause/play icon (design match) */
      #{{ carousel_id }} .hero-slider__control--pause svg { width: 24px; height: 24px; }

      /* Icon color: inherited from the chosen controller color (text-* class). */
      #{{ carousel_id }} .hero-slider__control svg path { fill: currentColor; }

      /* Play/Pause toggling */
      #{{ carousel_id }} [data-hero-toggle="pause"] .icon-play { display: none; }
      #{{ carousel_id }} [data-hero-toggle="pause"][data-paused="true"] .icon-pause { display: none; }
      #{{ carousel_id }} [data-hero-toggle="pause"][data-paused="true"] .icon-play { display: inline; }

      /* Hide default bootstrap controls */
      #{{ carousel_id }} .carousel-control-prev,
      #{{ carousel_id }} .carousel-control-next { display: none; }
      #{{ carousel_id }} .add-custom-px-4 { padding-left:1.8rem !important; }
    </style>

    {# Default to enabled indicators/controls unless explicitly turned off. #}
    {% set _show_indicators = show_indicators is defined ? show_indicators : false %}
    {% set _show_controls = show_controls is defined ? show_controls : false %}

    
    {# Nav (indicators + controls) alignment:
       - overlay/none: full width
       - start (image left): align under content (right column) => offset on lg
       - end (image right): align under content (left column)
    #}
    {% set nav_col_class = 'col-12' %}
    {% if hero_slider_media_position == 'start' %}
      {% set nav_col_class = 'col-12 col-lg-6 offset-lg-6' %}
    {% elseif hero_slider_media_position == 'end' %}
      {% set nav_col_class = 'col-12 col-lg-6' %}
    {% endif %}

{% if _show_indicators or _show_controls %}
      <div class="hero-slider__nav" aria-hidden="false">
        <div class="{{ content_container_class }}">
          <div class="row">
            <div class="{{ nav_col_class }}" data-hero-nav-col>
              {% set nav_inner_class = 'hero-slider__nav-inner' %}
              {% if (not _show_indicators) and _show_controls %}
                {% set nav_inner_class = nav_inner_class ~ ' justify-content-end' %}
              {% endif %}
              {# Apply controller color to indicators too via currentColor. #}
              <div class="{{ (nav_inner_class ~ ' ' ~ control_text_class)|trim }}">
            {#
              Canvas-safe indicators:
              We don't count slides in Twig (that would require pre-rendering slot content).
              Indicators are built in JS after render based on `.carousel-item` count.
            #}
            {% if _show_indicators %}
              <div class="carousel-indicators" data-hero-indicators></div>
            {% endif %}

            {% if _show_controls %}
              <div class="hero-slider__controls" role="group" aria-label="Carousel controls">
                <button class="{{ control_base|join(' ') }} btn btn-link {{ control_text_class }}" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="prev">
                  <span class="visually-hidden">Previous</span>
                  {# Bootstrap icon: arrow-left-circle-fill (color via currentColor) #}
                  <svg class="icon-prev" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.5 7.5a.5.5 0 0 1 0 1H6.707l1.147 1.146a.5.5 0 1 1-.708.708l-2-2a.5.5 0 0 1 0-.708l2-2a.5.5 0 1 1 .708.708L6.707 7.5H11.5z" fill="currentColor"/>
                  </svg>
                </button>

                <button class="{{ (control_base|merge(['hero-slider__control--pause']))|join(' ') }} btn btn-link {{ control_text_class }}" type="button" data-hero-toggle="pause" data-paused="{{ autoplay ? 'false' : 'true' }}" aria-label="{{ autoplay ? 'Pause' : 'Play' }}">
                  <span class="visually-hidden">{{ autoplay ? 'Pause' : 'Play' }}</span>
                  {# Bootstrap icon: pause-fill (color via currentColor) #}
                  <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5zm5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5z" fill="currentColor"/>
                  </svg>
                  <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M10 8l8 4-8 4V8z" fill="currentColor"/>
                  </svg>
                </button>

                <button class="{{ control_base|join(' ') }} btn btn-link {{ control_text_class }}" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="next">
                  <span class="visually-hidden">Next</span>
                  {# Bootstrap icon: arrow-right-circle-fill (color via currentColor) #}
                  <svg class="icon-next" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                    <path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zm-3.5 7.5a.5.5 0 0 0 0 1h4.793l-1.147 1.146a.5.5 0 1 0 .708.708l2-2a.5.5 0 0 0 0-.708l-2-2a.5.5 0 1 0-.708.708L9.293 7.5H4.5z" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            {% endif %}
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="carousel-inner">
      {% if has_slides %}
        {{ slides }}
      {% else %}
        {# Canvas preview fallback when empty. #}
        <div class="carousel-item active" data-hero-slide>
          <div class="hero-slider__item position-relative w-100 bg-black">
            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-50" aria-hidden="true"></div>
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex justify-content-start align-items-center">
              <div class="w-100 py-4">
                  <div class="{{ content_container_class }}">
                  <div class="row g-0">
                    <div class="col-12 col-lg-8 px-4">
                      <div class="hero-slider__caption text-start text-white">
                        <h2 class="hero-slider__title display-5 mb-3">Hero Slider</h2>
                        <div class="hero-slider__text fs-6"><p>Add “Hero Slide” components into the Slides slot.</p></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>

  </div>

  {% if outer_container_class %}
    </div>
  {% endif %}
</section>

<script>
(function () {
  function initHeroSliderControls() {
    var el = document.getElementById('{{ carousel_id }}');
    if (!el) return;

	  // Canvas can wrap nested components with extra DOM elements.
	  // Bootstrap Carousel expects `.carousel-item` to be DIRECT children of `.carousel-inner`.
	  // If wrapped, the slider will not work. Flatten any nested items.
	  var inner = el.querySelector('.carousel-inner');
	  if (inner) {
	    var nestedItems = inner.querySelectorAll('.carousel-item');
	    for (var n = 0; n < nestedItems.length; n++) {
	      if (nestedItems[n].parentElement !== inner) {
	        inner.appendChild(nestedItems[n]);
	      }
	    }
	  }

	  // 1) Ensure there is always an active item.
	  var items = (inner ? inner.querySelectorAll(':scope > .carousel-item') : el.querySelectorAll('.carousel-item'));
  if (!items.length) return;
  var activeIdx = -1;
  for (var i = 0; i < items.length; i++) {
    if (items[i].classList.contains('active')) { activeIdx = i; break; }
  }
  if (activeIdx === -1) {
    items[0].classList.add('active');
    activeIdx = 0;
  }

	  // 2) Build indicators (if enabled in markup).
  var indicators = el.querySelector('[data-hero-indicators]');
  if (indicators) {
    indicators.innerHTML = '';
    for (var j = 0; j < items.length; j++) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.setAttribute('data-bs-target', '#{{ carousel_id }}');
      btn.setAttribute('data-bs-slide-to', String(j));
      btn.setAttribute('aria-label', 'Slide ' + (j + 1));
      if (j === activeIdx) {
        btn.className = 'active';
        btn.setAttribute('aria-current', 'true');
      }
      indicators.appendChild(btn);
    }
  }

  // 3) Position nav under the correct content column based on the ACTIVE slide layout.
  var navCol = el.querySelector('[data-hero-nav-col]');
  function applyNavForActiveSlide(activeIndex) {
    if (!navCol) return;
    var activeItem = items[activeIndex];
    var layout = activeItem && activeItem.getAttribute('data-hero-layout') ? activeItem.getAttribute('data-hero-layout') : 'overlay';

    // Reset to base.
    navCol.className = 'col-12';

    // Split layouts: put nav under the CONTENT column.
    // - start => image left, content right => offset the nav to the right.
    // - end   => image right, content left  => no offset.
    if (layout === 'start') {
      navCol.className = 'col-12 col-lg-6 offset-lg-6 add-custom-px-4';
    } else if (layout === 'end') {
      navCol.className = 'col-12 col-lg-6';
    } else {
      navCol.className = 'col-12';
    }
  }
  applyNavForActiveSlide(activeIdx);

  // Update nav position when slide changes.
  el.addEventListener('slid.bs.carousel', function (evt) {
    if (evt && typeof evt.to === 'number') {
      applyNavForActiveSlide(evt.to);
    }
  });

  // 4) Pause/Play: DO NOT hide if bootstrap isn't ready yet.
  //    Some pages load JS late; we resolve the carousel instance lazily on click.
  var toggle = el.querySelector('[data-hero-toggle="pause"]');
  var instance = null;
  function getInstance() {
    if (instance) return instance;
    if (!(window.bootstrap && window.bootstrap.Carousel)) return null;
    instance = window.bootstrap.Carousel.getOrCreateInstance(el);
    return instance;
  }

  if (toggle) {
    // Align initial state with autoplay.
    if (!{{ autoplay ? 'true' : 'false' }}) {
      toggle.setAttribute('data-paused', 'true');
      toggle.setAttribute('aria-label', 'Play');
      var label0 = toggle.querySelector('.visually-hidden');
      if (label0) label0.textContent = 'Play';
      var inst0 = getInstance();
      if (inst0) { try { inst0.pause(); } catch (e) {} }
    }

    toggle.addEventListener('click', function () {
      var inst = getInstance();
      if (!inst) return;
      var paused = toggle.getAttribute('data-paused') === 'true';
      var labelNode = toggle.querySelector('.visually-hidden');
      if (paused) {
        inst.cycle();
        toggle.setAttribute('data-paused', 'false');
        toggle.setAttribute('aria-label', 'Pause');
        if (labelNode) labelNode.textContent = 'Pause';
      } else {
        inst.pause();
        toggle.setAttribute('data-paused', 'true');
        toggle.setAttribute('aria-label', 'Play');
        if (labelNode) labelNode.textContent = 'Play';
      }
    });
  }

  }

  // Run after DOM is ready to avoid Bootstrap timing issues.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSliderControls);
  } else {
    initHeroSliderControls();
  }
})();
</script>
