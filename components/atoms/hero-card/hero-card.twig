{#
  Hero Card
  - Bootstrap utility classes only in markup
  - Shared components used for image, heading, and button rendering
  - Class and attribute logic kept at the top for readability
#}

{% set title = title|default('Demo title') %}
{% set heading_tag = heading_tag|default('h2') %}
{% set heading_level_map = {
  h2: 2,
  h3: 3,
  h4: 4,
  h5: 5,
  h6: 6,
} %}
{% set heading_level = heading_level_map[heading_tag]|default(1) %}
{% set content_text = content_text|default('Demo content text goes here. You can edit this in Canvas.') %}

{% set container_type = container_type|default('container') %}
{% set media_position = media_position|default('end') %}
{% set split_gap = split_gap|default('g-4') %}
{% set horizontal_alignment = horizontal_alignment|default('text-start') %}
{% set vertical_alignment = vertical_alignment|default('justify-content-center') %}
{% set background_color = background_color|default('bg-transparent') %}
{% set content_color = content_color|default('text-dark') %}
{% set overlay_bg = overlay_bg|default('bg-dark') %}
{% set overlay_opacity = overlay_opacity|default('opacity-50') %}
{% set overlay_image_mode = overlay_image_mode|default('object-fit-cover') %}
{% set object_position = object_position|default('center') %}
{% set bg_edge2edge = bg_edge2edge|default(false) %}
{% set card_border = card_border|default(false) %}
{% set padding = padding|default(false) %}

{% set section_padding_class = 'py-5' %}
{% set has_media = media_position != 'none' and ((media is defined and media and media.src is defined and media.src is not empty) or (slots.media_slot is defined and slots.media_slot|render|trim)) %}
{% set merge_media = true %}
{% set slots = slots|default({}) %}
{% set actions_slot = (slots.actions is defined) ? (slots.actions|render|trim) : '' %}
{% set media_slot_override = (slots.media_slot is defined) ? (slots.media_slot|render|trim) : '' %}

{% set dark_backgrounds = ['bg-dark', 'bg-black', 'bg-primary', 'bg-secondary'] %}
{% if content_color == 'text-dark' and background_color in dark_backgrounds %}
  {% set content_color = 'text-white' %}
{% endif %}

{% set media_src = media.src|default('') %}
{% set media_alt = media.alt|default('') %}
{% set media_width = media.width|default('') %}
{% set media_height = media.height|default('') %}
{% set media_style = 'object-position: ' ~ object_position ~ ';' %}

{% set outer_classes = ['position-relative', 'overflow-hidden'] %}
{% if bg_edge2edge %}
  {% set outer_classes = outer_classes|merge(['bg-edge2edge', background_color]) %}
{% endif %}
{% if media_position != 'overlay' %}
  {% set outer_classes = outer_classes|merge([section_padding_class]) %}
{% endif %}

{% set inner_classes = ['position-relative', 'z-1'] %}
{% if media_position == 'overlay' %}
  {% set inner_classes = inner_classes|merge([section_padding_class]) %}
{% endif %}
{% if container_type in ['container', 'container-fluid'] %}
  {% set inner_classes = [container_type]|merge(inner_classes) %}
{% endif %}

{% set card_classes = ['card', 'position-relative', 'overflow-hidden', 'rounded-3'] %}
{% if bg_edge2edge %}
  {% set card_classes = card_classes|merge(['bg-transparent']) %}
{% else %}
  {% set card_classes = card_classes|merge([background_color]) %}
{% endif %}
{% set card_classes = card_border ? card_classes|merge(['border']) : card_classes|merge(['border-0']) %}

{% set content_classes = ['card-body', 'position-relative', 'd-flex', 'flex-column', content_color, horizontal_alignment] %}
{% if padding %}
  {% set content_classes = content_classes|merge(['p-3', 'p-md-4']) %}
{% endif %}

{% set overlay_flex_classes = ['card-img-overlay', 'd-flex', 'w-100', 'h-100'] %}
{% if horizontal_alignment == 'text-center' %}
  {% set overlay_flex_classes = overlay_flex_classes|merge(['justify-content-center', 'text-center']) %}
{% elseif horizontal_alignment == 'text-end' %}
  {% set overlay_flex_classes = overlay_flex_classes|merge(['justify-content-end', 'text-end']) %}
{% else %}
  {% set overlay_flex_classes = overlay_flex_classes|merge(['justify-content-start', 'text-start']) %}
{% endif %}
{% set overlay_flex_classes = overlay_flex_classes|merge([vertical_alignment, 'position-relative']) %}

{% set stack_alignment_classes = ['d-flex', 'flex-column'] %}
{% if horizontal_alignment == 'text-center' %}
  {% set stack_alignment_classes = stack_alignment_classes|merge(['align-items-center', 'text-center']) %}
{% elseif horizontal_alignment == 'text-end' %}
  {% set stack_alignment_classes = stack_alignment_classes|merge(['align-items-end', 'text-end']) %}
{% else %}
  {% set stack_alignment_classes = stack_alignment_classes|merge(['align-items-start', 'text-start']) %}
{% endif %}
{% set stack_alignment_classes = stack_alignment_classes|merge([vertical_alignment]) %}

{% set overlay_background_image = bg_edge2edge and media_position == 'overlay' and has_media and (media_src or media_slot_override) %}
{% set overlay_color_layer = bg_edge2edge and media_position == 'overlay' and has_media %}

{% set split_gap_number = split_gap == 'g-2' ? '3' : (split_gap == 'g-5' ? '5' : '4') %}
{% set media_gap_classes = [] %}
{% if has_media and merge_media %}
  {% if media_position == 'start' and split_gap != 'g-0' %}
    {% set media_gap_classes = ['mt-3', 'mt-lg-0', 'ps-lg-' ~ split_gap_number] %}
  {% elseif media_position == 'end' and split_gap != 'g-0' %}
    {% set media_gap_classes = ['mt-3', 'mt-lg-0', 'pe-lg-' ~ split_gap_number] %}
  {% elseif media_position == 'top' and split_gap != 'g-0' %}
    {% set media_gap_classes = ['mt-3', 'mt-md-4'] %}
  {% elseif media_position == 'bottom' and split_gap != 'g-0' %}
    {% set media_gap_classes = ['mb-3', 'mb-md-4'] %}
  {% endif %}
{% endif %}

{% set content_rounding_classes = [] %}
{% if has_media and media_position == 'top' and merge_media %}
  {% set content_rounding_classes = ['rounded-bottom'] %}
{% elseif has_media and media_position == 'bottom' and merge_media %}
  {% set content_rounding_classes = ['rounded-top'] %}
{% endif %}

{% set content_box_classes = content_classes|merge(media_gap_classes)|merge(content_rounding_classes) %}
{% if media_position in ['start', 'end'] %}
  {% set content_box_classes = content_box_classes|merge(['w-100', 'flex-grow-1', vertical_alignment]) %}
{% elseif media_position in ['overlay', 'top', 'bottom', 'none', 'content'] %}
  {% set content_box_classes = content_box_classes|merge(['w-100']) %}
{% endif %}

{% set split_row_classes = ['row', 'align-items-stretch'] %}
{% set split_row_classes = merge_media ? split_row_classes|merge(['g-0']) : split_row_classes|merge([split_gap]) %}

{% set media_column_classes = ['col-12', 'col-lg-6', 'd-flex', 'h-100'] %}
{% set content_column_classes = ['col-12', 'col-lg-6', 'd-flex', 'flex-column'] %}
{% if media_position == 'end' %}
  {% set media_column_classes = media_column_classes|merge(['order-lg-2']) %}
  {% set content_column_classes = content_column_classes|merge(['order-lg-1']) %}
{% endif %}
{% if merge_media %}
  {% set media_column_classes = media_column_classes|merge(['p-0']) %}
  {% set content_column_classes = content_column_classes|merge(['p-0']) %}
{% endif %}
{% if horizontal_alignment == 'text-center' %}
  {% set content_column_classes = content_column_classes|merge(['align-items-center', 'text-center']) %}
{% elseif horizontal_alignment == 'text-end' %}
  {% set content_column_classes = content_column_classes|merge(['align-items-end', 'text-end']) %}
{% else %}
  {% set content_column_classes = content_column_classes|merge(['align-items-start', 'text-start']) %}
{% endif %}

{% set split_media_wrapper_classes = ['w-100', 'h-100', 'overflow-hidden'] %}
{% if merge_media %}
  {% if media_position == 'start' %}
    {% set split_media_wrapper_classes = split_media_wrapper_classes|merge(['rounded-start']) %}
  {% elseif media_position == 'end' %}
    {% set split_media_wrapper_classes = split_media_wrapper_classes|merge(['rounded-end']) %}
  {% endif %}
{% else %}
  {% set split_media_wrapper_classes = split_media_wrapper_classes|merge(['rounded']) %}
{% endif %}

{% set top_media_wrapper_classes = ['card-img-top', 'overflow-hidden'] %}
{% set bottom_media_wrapper_classes = ['card-img-bottom', 'overflow-hidden'] %}
{% if merge_media %}
  {% set top_media_wrapper_classes = top_media_wrapper_classes|merge(['mb-0', 'rounded-top']) %}
  {% set bottom_media_wrapper_classes = bottom_media_wrapper_classes|merge(['mt-0', 'rounded-bottom']) %}
{% else %}
  {% set top_media_wrapper_classes = top_media_wrapper_classes|merge(['mb-3', 'rounded-3']) %}
  {% set bottom_media_wrapper_classes = bottom_media_wrapper_classes|merge(['mt-3', 'rounded-3']) %}
{% endif %}

{% set overlay_background_media_classes = ['card-img', 'position-absolute', 'top-0', 'start-0', 'w-100', 'h-100', 'z-0'] %}
{% set overlay_media_wrapper_classes = ['card-img', 'w-100', 'h-100'] %}
{% set overlay_layer_classes = ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100'] %}
{% set overlay_color_layer_classes = overlay_layer_classes|merge([overlay_bg, overlay_opacity, 'z-0']) %}

{% set title_classes = ['card-title', 'mb-3'] %}
{% set text_classes = ['card-text', 'mb-0'] %}
{% set content_media_wrapper_classes = ['mb-3'] %}
{% set button_wrapper_classes = ['mt-3'] %}

{% set button_variant = button_1_style|default('btn-primary') %}
{% set button_outline = false %}
{% if button_variant|slice(0, 12) == 'btn-outline-' %}
  {% set button_variant = 'btn-' ~ button_variant|slice(12) %}
  {% set button_outline = true %}
{% endif %}
{% set button_size = button_1_size|default('default') == 'btn-sm' ? 'btn-sm' : (button_1_size|default('default') == 'btn-lg' ? 'btn-lg' : 'btn-md') %}
{% set button_target = button_1_target|default('default') == '_blank' ? 'blank' : 'self' %}

{% set outer_attributes = create_attribute().addClass(outer_classes) %}
{% set inner_attributes = create_attribute().addClass(inner_classes) %}
{% set card_attributes = create_attribute().addClass(card_classes) %}
{% set overlay_flex_attributes = create_attribute().addClass(overlay_flex_classes) %}
{% set overlay_layer_attributes = create_attribute().addClass(overlay_layer_classes) %}
{% set overlay_color_layer_attributes = create_attribute().addClass(overlay_color_layer_classes).setAttribute('aria-hidden', 'true') %}
{% set split_row_attributes = create_attribute().addClass(split_row_classes) %}
{% set media_column_attributes = create_attribute().addClass(media_column_classes) %}
{% set content_column_attributes = create_attribute().addClass(content_column_classes) %}
{% set split_media_wrapper_attributes = create_attribute().addClass(split_media_wrapper_classes) %}
{% set top_media_wrapper_attributes = create_attribute().addClass(top_media_wrapper_classes) %}
{% set bottom_media_wrapper_attributes = create_attribute().addClass(bottom_media_wrapper_classes) %}
{% set stack_alignment_attributes = create_attribute().addClass(stack_alignment_classes) %}
{% set content_box_attributes = create_attribute().addClass(content_box_classes) %}
{% set title_wrapper_attributes = create_attribute().addClass(title_classes) %}
{% set text_attributes = create_attribute().addClass(text_classes) %}
{% set content_media_wrapper_attributes = create_attribute().addClass(content_media_wrapper_classes) %}
{% set button_wrapper_attributes = create_attribute().addClass(button_wrapper_classes) %}
{% set overlay_background_media_attributes = create_attribute().addClass(overlay_background_media_classes) %}
{% set overlay_media_wrapper_attributes = create_attribute().addClass(overlay_media_wrapper_classes) %}

{% set split_background_media_attributes = create_attribute().addClass(['w-100', 'h-100']) %}
{% set split_background_media_class = 'w-100 h-100 img-fluid ' ~ overlay_image_mode %}

{% set heading_markup %}
  {% if title %}
    <div {{ title_wrapper_attributes }}>
      {{ include('vartheme_bs5:heading', {
        heading_text: title,
        level: heading_level,
        text_color: content_color,
        align: horizontal_alignment,
      }, false) }}
    </div>
  {% endif %}
{% endset %}

{% set text_markup %}
  {% if content_text %}
    <div {{ text_attributes }}>{{ content_text|raw }}</div>
  {% endif %}
{% endset %}

{% set button_markup %}
  {% if actions_slot %}
    {{ actions_slot|raw }}
  {% elseif (button_1_label|default('')|trim) and (button_1_url|default('')|trim) %}
    <div {{ button_wrapper_attributes }}>
      {{ include('vartheme_bs5:button', {
        label: button_1_label,
        href: button_1_url,
        variant: button_variant,
        outline: button_outline,
        size: button_size,
        target: button_target,
        alignment: 'inline',
        radius: 'rounded',
      }, false) }}
    </div>
  {% endif %}
{% endset %}

{% set image_component_props = {
  media: {
    src: media_src,
    alt: media_alt,
    width: media_width,
    height: media_height,
  },
  fit: overlay_image_mode,
  loading: 'lazy',
} %}

{% set standard_image_props = image_component_props|merge({
  width: 'w-100',
  align: 'me-auto',
  rounded: media_position == 'content' ? 'rounded-3' : 'rounded-0',
  ratio: 'ratio-auto',
}) %}

{% set overlay_image_props = image_component_props|merge({
  width: 'w-100',
  align: 'me-auto',
  rounded: 'rounded-0',
  ratio: 'ratio-auto',
}) %}

{% set standard_media_markup %}
  {% if media_slot_override %}
    {{ media_slot_override|raw }}
  {% elseif media_src %}
    <div style="{{ media_style }}">
      {{ include('vartheme_bs5:image', standard_image_props, false) }}
    </div>
  {% endif %}
{% endset %}

{% set split_media_markup %}
  {% if media_slot_override %}
    <div {{ split_background_media_attributes }}>{{ media_slot_override|raw }}</div>
  {% elseif media_src %}
    <div {{ split_background_media_attributes }}>
      {{ include('canvas:image', {
        src: media_src,
        alt: media_alt,
        width: media_width,
        height: media_height,
        class: split_background_media_class,
        loading: 'lazy',
      }, false, true) }}
    </div>
  {% endif %}
{% endset %}

{% set content_media_markup %}
  {% if media_slot_override %}
    {{ media_slot_override|raw }}
  {% elseif media_src %}
    <div style="{{ media_style }}">
      {{ include('vartheme_bs5:image', standard_image_props, false) }}
    </div>
  {% endif %}
{% endset %}

{% set overlay_background_media_markup %}
  {% if media_slot_override %}
    <div {{ overlay_background_media_attributes }}>{{ media_slot_override|raw }}</div>
  {% elseif media_src %}
    <div {{ overlay_background_media_attributes }}>
      {{ include('canvas:image', {
        src: media_src,
        alt: media_alt,
        width: media_width,
        height: media_height,
        class: 'w-100 h-100 img-fluid ' ~ overlay_image_mode,
        loading: 'lazy',
      }, false, true) }}
    </div>
  {% endif %}
{% endset %}

{% set overlay_media_markup %}
  {% if media_slot_override %}
    {{ media_slot_override|raw }}
  {% elseif media_src %}
    <div {{ overlay_media_wrapper_attributes }} style="{{ media_style }}">
      {{ include('vartheme_bs5:image', overlay_image_props, false) }}
    </div>
  {% endif %}
{% endset %}

{% set content_block_markup %}
  {{ heading_markup }}
  {{ text_markup }}
  {{ button_markup }}
{% endset %}

{% set content_block_with_media_markup %}
  {% if has_media %}
    <div {{ content_media_wrapper_attributes }}>
      {{ content_media_markup }}
    </div>
  {% endif %}
  {{ heading_markup }}
  {{ text_markup }}
  {{ button_markup }}
{% endset %}

<div {{ outer_attributes }}>
  {% if overlay_background_image %}
    {{ overlay_background_media_markup }}
  {% endif %}

  {% if overlay_color_layer %}
    <div {{ overlay_color_layer_attributes }}></div>
  {% endif %}

  <div {{ inner_attributes }}>
    <div {{ card_attributes }}>
      {% if media_position == 'overlay' and has_media and not overlay_background_image %}
        <div {{ overlay_layer_attributes }}>
          <div {{ overlay_color_layer_attributes }}></div>
          <div {{ overlay_layer_attributes }}>
            {{ overlay_media_markup }}
          </div>
        </div>
      {% endif %}

      {% if media_position == 'overlay' %}
        <div {{ overlay_flex_attributes }}>
          <div {{ content_box_attributes }}>
            {{ content_block_markup }}
          </div>
        </div>

      {% elseif has_media and media_position in ['start', 'end'] %}
        <div {{ split_row_attributes }}>
          <div {{ media_column_attributes }}>
            <div {{ split_media_wrapper_attributes }}>
              {{ split_media_markup }}
            </div>
          </div>
          <div {{ content_column_attributes }}>
            <div {{ content_box_attributes }}>
              {{ content_block_markup }}
            </div>
          </div>
        </div>

      {% elseif has_media and media_position in ['top', 'bottom'] %}
        {% if media_position == 'top' %}
          <div {{ top_media_wrapper_attributes }}>
            {{ standard_media_markup }}
          </div>
        {% endif %}

        <div {{ stack_alignment_attributes }}>
          <div {{ content_box_attributes }}>
            {{ content_block_markup }}
          </div>
        </div>

        {% if media_position == 'bottom' %}
          <div {{ bottom_media_wrapper_attributes }}>
            {{ standard_media_markup }}
          </div>
        {% endif %}

      {% elseif media_position == 'content' %}
        <div {{ stack_alignment_attributes }}>
          <div {{ content_box_attributes }}>
            {{ content_block_with_media_markup }}
          </div>
        </div>

      {% else %}
        <div {{ stack_alignment_attributes }}>
          <div {{ content_box_attributes }}>
            {{ content_block_markup }}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>
