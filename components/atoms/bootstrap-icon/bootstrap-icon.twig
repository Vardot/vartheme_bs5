{#
  Bootstrap icon component.

  Props:
  - icon (string): Bootstrap icon name, e.g. "alarm", "link-45deg"
  - icon_size (string): Bootstrap font-size utility class, e.g. fs-4
  - color (string): Optional text color utility class, e.g. "text-primary"
#}

{% set icon_name = icon|default('award')|trim %}
{% set icon_size_class = icon_size is defined and icon_size ? icon_size|trim : 'fs-4' %}
{% set color_class = color is defined and color ? color|trim : '' %}

{% set icon_classes = [
  'bi',
  'bi-' ~ icon_name,
  'd-inline-block',
  'lh-1',
  icon_size_class,
] %}

{% if color_class %}
  {% set icon_classes = icon_classes|merge([color_class]) %}
{% endif %}

{% set icon_attributes = create_attribute().addClass(icon_classes) %}

{% if icon_name %}
  <i{{ icon_attributes }}></i>
{% endif %}
