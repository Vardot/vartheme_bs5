{#
  Video component (Bootstrap 5, SDC, Canvas-friendly)
  - Uploaded video only (Media Library)
  - Placeholder renders if no video selected
#}

{% set src = (video_file is defined and video_file and video_file.src is defined) ? (video_file.src|default('')|trim) : '' %}
{% set poster = (video_file is defined and video_file and video_file.poster is defined) ? (video_file.poster|default('')|trim) : '' %}
{% set has_video = src != '' %}

{% set ratio_map = {'16x9':'ratio ratio-16x9','4x3':'ratio ratio-4x3','1x1':'ratio ratio-1x1','21x9':'ratio ratio-21x9'} %}
{% set ratio_class = ratio_map[ratio|default('16x9')]|default('ratio ratio-16x9') %}

{# Width is always full (100%). Alignment & Corners settings removed. #}
{% set block_classes = ['w-100']|join(' ') %}

{% if extra_classes|default('')|trim %}
  {% set block_classes = block_classes ~ ' ' ~ (extra_classes|trim) %}
{% endif %}

{% set frame_classes = ['w-100','h-100']|filter(v => v)|join(' ') %}

{% set fig_attrs = create_attribute().addClass(['d-block', block_classes]|filter(v=>v)) %}

<figure{{ fig_attrs }}>
  <div class="{{ ratio_class }}">
    {% if has_video %}
      <video class="{{ frame_classes }}" controls preload="metadata" {% if poster %}poster="{{ poster|e }}"{% endif %}>
        <source src="{{ src|e }}">
        Your browser does not support the video tag.
      </video>
    {% else %}
      {# Placeholder (no asset dependency) #}
      <div class="{{ frame_classes }} d-flex align-items-center justify-content-center text-center p-4 border border-2 border-secondary">
        <div class="text-body-secondary">
          <div class="fs-2 lh-1 mb-2" aria-hidden="true">
            <i class="bi bi-cloud-arrow-up"></i>
          </div>
          <div class="fw-semibold">Add a video</div>
          <div class="small">Use the media picker to upload and select a video.</div>
        </div>
      </div>
    {% endif %}
  </div>

</figure>
