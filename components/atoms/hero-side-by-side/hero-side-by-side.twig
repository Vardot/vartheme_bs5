{#
  Hero Side by Side
#}

{% set bg_edge2edge = bg_edge2edge|default(false) %}
{% set heading_level = heading_level|default(2) %}
{% set image_position = image_position|default('right') %}
{% set align = align|default('text-start') %}
{% set background_color = background_color|default('bg-white') %}
{% set content_color = content_color|default('text-dark') %}
{% set background_overlay_color = background_overlay_color|default('bg-none') %}
{% set background_overlay_opacity = background_overlay_opacity|default(50) %}
{% set button_variant = button_variant|default('btn-primary') %}
{% set button_outline = button_outline|default(false) %}
{% set button_size = button_size|default('btn-md') %}
{% set vertical_padding = vertical_padding|default('py-4') %}

{% set image_on_left = image_position == 'left' %}
{% set has_background_image = background_image is defined and background_image is not empty %}
{% set has_button = button_label is defined and button_label and button_url is defined and button_url %}

{% set heading_props = {
  heading_text: heading|default(''),
  level: heading_level,
  align: align
} %}
{% if content_color in ['text-primary', 'text-secondary', 'text-success', 'text-danger', 'text-warning', 'text-info', 'text-muted', 'text-white', 'text-dark'] %}
  {% set heading_props = heading_props|merge({ text_color: content_color }) %}
{% endif %}

{% set resolved_button_variant = button_variant %}
{% if button_outline and button_variant != 'btn-link' %}
  {% set resolved_button_variant = button_variant|replace({'btn-': 'btn-outline-'}) %}
{% endif %}

{% set section_classes = [
  'hero-side-by-side',
  'position-relative',
  'overflow-hidden',
  vertical_padding,
  bg_edge2edge ? 'bg-edge2edge',
  background_color != 'bg-none' ? background_color,
  content_color
] %}
{% set section_attributes = create_attribute().addClass(section_classes) %}

{% set overlay_attributes = create_attribute().addClass([
  'position-absolute', 'top-0', 'start-0', 'w-100', 'h-100',
  background_overlay_color != 'bg-none' ? background_overlay_color,
  'opacity-' ~ background_overlay_opacity
]) %}

{% set container_attributes = create_attribute().addClass(['container', 'position-relative', 'z-1']) %}
{% set row_attributes = create_attribute().addClass(['row', 'align-items-center', 'g-4', 'g-lg-5']) %}
{% set text_col_attributes = create_attribute().addClass([
  'col-lg-6',
  image_on_left ? 'order-lg-2',
  align,
  'd-flex',
  'flex-column',
  'justify-content-center'
]) %}
{% set image_col_attributes = create_attribute().addClass([
  'col-lg-6',
  image_on_left ? 'order-lg-1'
]) %}
{% set text_wrap_attributes = create_attribute().addClass(['w-100']) %}
{% set body_attributes = create_attribute().addClass(['mb-4', 'lead']) %}

<section{{ section_attributes }}>
  {% if background_overlay_color != 'bg-none' and has_background_image %}
    <div{{ overlay_attributes }}></div>
  {% endif %}

  <div{{ container_attributes }}>
    <div{{ row_attributes }}>
      <div{{ text_col_attributes }}>
        <div{{ text_wrap_attributes }}>
          {% if heading %}
            {% include 'vartheme_bs5:heading' with heading_props only %}
          {% endif %}

          {% if text %}
            <div{{ body_attributes }}>{{ text|raw }}</div>
          {% endif %}

          {% if has_button %}
            {% include 'vartheme_bs5:button' with {
              label: button_label,
              href: button_url,
              target: button_target|default('self'),
              variant: button_variant,
              outline: button_outline,
              size: button_size,
              alignment: align == 'text-center' ? 'center' : 'left'
            } only %}
          {% endif %}
        </div>
      </div>

      <div{{ image_col_attributes }}>
        {% if image is defined and image is not empty %}
          {% include 'vartheme_bs5:image' with {
            media: image,
            ratio: 'ratio-auto',
            fit: 'object-fit-cover',
            align: 'me-auto',
            width: 'w-100',
            rounded: 'rounded-3',
            loading: 'lazy'
          } only %}
        {% endif %}
      </div>
    </div>
  </div>
</section>
