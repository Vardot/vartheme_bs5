{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Input Password component.
 *
 * Available variables:
 * - attributes: HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 * - input_password_utility_classes: An array of utility classes.
 * - bs_form_control: A class 'form-control' related to input type.
 *
 * @see template_preprocess_input()
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set type = type ?? 'text' %}
{% set size = size ?? '' %}
{% set placeholder = placeholder ?? '' %}
{% set input_password_utility_classes = input_password_utility_classes ? input_password_utility_classes : [] %}

{# Logic: class arrays. #}
{% set bs_form_control = bs_form_control ? ['form-control'] : [] %}
{% set classes = []|merge(bs_form_control)|merge(input_password_utility_classes)|merge([size]) %}

{# Print the HTML. #}
{# To render drupal Input component #}
{% if attributes %}
  {% set attributes = attributes.addClass(classes) %}
  <input{{ attributes }} />{{ children }}
{# To render Storybook Input component #}
{% else %}
  <input type="{{ type }}" class="{{ classes|join(' ') }}" placeholder="{{ placeholder }}" />
{% endif %}
