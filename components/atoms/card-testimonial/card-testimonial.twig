{#
  Bootstrap 5 Testimonial Card

  Props: text, cite_name, cite_text, cite_url, media
  Options: align, style (default|inverted), shadow, border, rounded, show_quote_icon
#}

{% set shadow_map = {
  'none': '',
  'sm': 'shadow-sm',
  'default': 'shadow',
  'lg': 'shadow-lg'
} %}

{% set border_value = border|default('default') %}
{% set border_class = '' %}
{% if border_value == 'none' %}
  {% set border_class = 'border-0' %}
{% elseif border_value == 'default' %}
  {% set border_class = '' %}
{% else %}
  {% set border_class = 'border border-' ~ border_value %}
{% endif %}

{% set rounded_value = rounded|default('default') %}
{% set rounded_map = {
  'default': '',
  '0': 'rounded-0',
  '1': 'rounded-1',
  '2': 'rounded-2',
  '3': 'rounded-3',
  'pill': 'rounded-pill'
} %}

{% set style_value = style|default('default') %}
{% set style_map = {
  'default': 'bg-body',
  'inverted': 'bg-dark text-white'
} %}

{% set align_value = align|default('center') %}
{% set align_map = {
  'center': 'text-center',
  'left': 'text-start'
} %}

{% set classes = ['card', 'h-100', 'position-relative'] %}
{% set classes = classes|merge([style_map[style_value]|default('bg-body')]) %}
{% if shadow_map[shadow|default('default')]|default('') %}
  {% set classes = classes|merge([shadow_map[shadow|default('default')]]) %}
{% endif %}
{% if border_class %}
  {% set classes = classes|merge([border_class]) %}
{% endif %}
{% if rounded_map[rounded_value]|default('') %}
  {% set classes = classes|merge([rounded_map[rounded_value]]) %}
{% endif %}
{% if extra_classes|default('')|trim %}
  {% set classes = classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

{% set attrs = create_attribute().addClass(classes) %}
{% if id|default('')|trim %}
  {% set attrs = attrs.setAttribute('id', id|trim) %}
{% endif %}

<div{{ attrs }}>
  <div class="card-body p-4 p-lg-5 {{ align_map[align_value]|default('text-center') }}">
    {% if show_quote_icon|default(true) %}
      <div class="position-absolute top-0 start-0 p-3 opacity-25" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M7.39762 10.3C7.39762 11.0733 7.14888 11.7 6.6514 12.18C6.15392 12.6333 5.52552 12.86 4.76621 12.86C3.84979 12.86 3.09047 12.5533 2.48825 11.94C1.91222 11.3266 1.62421 10.4467 1.62421 9.29999C1.62421 8.07332 1.96459 6.87332 2.64535 5.69999C3.35231 4.49999 4.33418 3.55332 5.59098 2.85999L6.4943 4.25999C5.81354 4.73999 5.26369 5.27332 4.84476 5.85999C4.45201 6.44666 4.19017 7.12666 4.05926 7.89999C4.29491 7.79332 4.56983 7.73999 4.88403 7.73999C5.61716 7.73999 6.21938 7.97999 6.69067 8.45999C7.16197 8.93999 7.39762 9.55333 7.39762 10.3ZM14.6242 10.3C14.6242 11.0733 14.3755 11.7 13.878 12.18C13.3805 12.6333 12.7521 12.86 11.9928 12.86C11.0764 12.86 10.3171 12.5533 9.71484 11.94C9.13881 11.3266 8.85079 10.4467 8.85079 9.29999C8.85079 8.07332 9.19117 6.87332 9.87194 5.69999C10.5789 4.49999 11.5608 3.55332 12.8176 2.85999L13.7209 4.25999C13.0401 4.73999 12.4903 5.27332 12.0713 5.85999C11.6786 6.44666 11.4168 7.12666 11.2858 7.89999C11.5215 7.79332 11.7964 7.73999 12.1106 7.73999C12.8437 7.73999 13.446 7.97999 13.9173 8.45999C14.3886 8.93999 14.6242 9.55333 14.6242 10.3Z"
            fill="currentColor"
          ></path>
        </svg>
      </div>
    {% endif %}

    <blockquote class="mb-0">
      {% if text is not empty %}
        <p class="lead mb-4">{{ text }}</p>
      {% endif %}

      <footer class="d-flex align-items-center gap-3 {{ align_value == 'center' ? 'justify-content-center' : 'justify-content-start' }}">
        {% if media.src is not empty %}
          <div class="flex-shrink-0">
            {% include 'canvas:image' ignore missing with {
              src: media.src,
              alt: media.alt,
              class: 'rounded-circle object-fit-cover',
              width: media.width|default(60),
              height: media.height|default(60),
              sizes: '60px'
            } only %}
          </div>
        {% endif %}

        <div class="small">
          {% if cite_name is not empty %}
            <div class="fw-semibold">{{ cite_name }}</div>
          {% endif %}
          {% if cite_text is not empty %}
            {% if cite_url and cite_url != 'No URL' %}
              <a href="{{ cite_url }}" target="_blank" rel="noopener" class="text-reset text-decoration-underline">{{ cite_text }}</a>
            {% else %}
              <div class="opacity-75">{{ cite_text }}</div>
            {% endif %}
          {% endif %}
        </div>
      </footer>
    </blockquote>
  </div>
</div>
