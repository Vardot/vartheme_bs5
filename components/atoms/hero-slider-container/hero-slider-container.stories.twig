{% stories HeroSliderContainer with {
  "title": "Hero/Hero Slider Container",
  "parameters": {
    "componentSubtitle": "Bootstrap carousel wrapper for hero slides",
    "docs": {
      "description": {
        "component": "Wraps one or more hero slides and controls autoplay, transition style, navigation, and indicators."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "bg_edge2edge": {
      "name": "Edge-to-edge background",
      "control": "boolean",
      "defaultValue": true
    },
    "transition": {
      "name": "Transition",
      "control": "select",
      "defaultValue": "slide",
      "options": {
        "Slide": "slide",
        "Fade": "fade"
      }
    },
    "autoplay": {
      "name": "Autoplay",
      "control": "boolean",
      "defaultValue": true
    },
    "interval_ms": {
      "name": "Autoplay interval (ms)",
      "control": "number",
      "defaultValue": 5000
    },
    "pause_on_hover": {
      "name": "Pause on hover",
      "control": "boolean",
      "defaultValue": true
    },
    "show_indicators": {
      "name": "Show indicators",
      "control": "boolean",
      "defaultValue": true
    },
    "show_controls": {
      "name": "Show controls",
      "control": "boolean",
      "defaultValue": true
    },
    "slider_height": {
      "name": "Slider height",
      "control": "select",
      "defaultValue": "700",
      "options": {
        "500px": "500",
        "700px": "700",
        "900px": "900"
      }
    },
    "controller_color": {
      "name": "Controller color",
      "control": "select",
      "defaultValue": "primary",
      "options": {
        "Primary": "primary",
        "Light": "light",
        "Dark": "dark",
        "White": "white"
      }
    }
  }
} %}

{% set demo_media = {
  src: 'assets/hero-slider-image.webp',
  alt: 'Hero image',
  width: 1600,
  height: 900
} %}

{% story Default with {
  "name": "Default",
  "args": {
    "bg_edge2edge": true,
    "transition": "slide",
    "autoplay": true,
    "interval_ms": 5000,
    "pause_on_hover": true,
    "show_indicators": true,
    "show_controls": true,
    "slider_height": "700",
    "controller_color": "primary"
  }
} %}
{% embed 'vartheme_bs5:hero-slider-container' with {
  bg_edge2edge: bg_edge2edge,
  transition: transition,
  autoplay: autoplay,
  interval_ms: interval_ms,
  pause_on_hover: pause_on_hover,
  show_indicators: show_indicators,
  show_controls: show_controls,
  slider_height: slider_height,
  controller_color: controller_color
} only %}
  {% block slides %}
    {{ include('vartheme_bs5:hero-slide', {
      active: true,
      title: 'Varbase; better than ever',
      content: '<p>Build clean landing pages with reusable hero slider patterns.</p>',
      button_text: 'Learn more',
      button_url: '#',
      button_variant: 'btn-primary',
      media: demo_media,
      media_position: 'overlay',
      title_tag: 'h2',
      title_size: 'display-5',
      content_max_width: 'normal',
      vertical_alignment: 'center',
      text_align: 'text-start',
      text_color: 'text-white',
      split_gap: 'md',
      background_color: 'bg-black',
      overlay_bg: 'bg-dark',
      overlay_opacity: 'opacity-50'
    }, with_context = false) }}

    {{ include('vartheme_bs5:hero-slide', {
      active: false,
      title: 'Reusable structure for multiple slides',
      content: '<p>Keep the container focused on behavior while slides define content and visual layout.</p>',
      button_text: 'Explore components',
      button_url: '#',
      button_variant: 'btn-light',
      media: demo_media,
      media_position: 'overlay',
      title_tag: 'h2',
      title_size: 'display-5',
      content_max_width: 'normal',
      vertical_alignment: 'center',
      text_align: 'text-start',
      text_color: 'text-white',
      split_gap: 'md',
      background_color: 'bg-black',
      overlay_bg: 'bg-dark',
      overlay_opacity: 'opacity-50'
    }, with_context = false) }}
  {% endblock %}
{% endembed %}
{% endstory %}

