{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Close Button component.
 *
 * Generic close button for dismissing content like modals and alerts.
 *
 * Available properties:
 * - size: (btn-sm|btn-lg) Bootstrap button size class.
 * - disabled: (true|false) Disabled button.
 * - close_button_utility_classes: An array of utility classes that can be used to add extra
 *                    Bootstrap utility classes or custom classes to this component.
 *
 * Available attributes:
 * - attributes: HTML attributes for the close button element.
 *
 * Available slots:
 * - N/A
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: boolean props. #}
{% set disabled = disabled ?? false %}

{# Logic: merge close button classes as arrays. #}
{% set size_classes = size ? [size] : [] %}
{% set disabled_classes = disabled ? ['disabled'] : [] %}
{% set utility_classes = close_button_utility_classes ?? [] %}

{% set classes = [
  'btn',
  'btn-close',
]|merge(size_classes)|merge(disabled_classes)|merge(utility_classes) %}

{# Logic: include text for screen readers, using aria-label, and set the
 # disabled state when requested. #}
{% set attributes = attributes.setAttribute('aria-label', 'Close'|t) %}
{% if disabled %}
  {% set attributes = attributes.setAttribute('disabled', true) %}
{% endif %}

{# Print the HTML. #}
{% set attributes = attributes.addClass(classes) %}
<button type="button"{{ attributes }}></button>
