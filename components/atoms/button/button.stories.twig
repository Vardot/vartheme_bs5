{% stories Button with {
  title: 'Base/Button',
  parameters: {
    componentSubtitle: 'Bootstrap Button component',
    docs: {
      description: {
        component: 'Use Bootstrap’s custom button styles for actions in forms, dialogs, and more.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    variant: {
      name: 'Variant',
      description: 'Bootstrap button style class.',
      defaultValue: 'btn-primary',
      control: 'select',
      options: {
        Primary: 'btn-primary',
        Secondary: 'btn-secondary',
        Success: 'btn-success',
        Danger: 'btn-danger',
        Warning: 'btn-warning',
        Info: 'btn-info',
        Light: 'btn-light',
        Dark: 'btn-dark',
        Link: 'btn-link',
      },
    },
    outline: {
      name: 'Outline',
      description: 'When enabled, uses the Bootstrap outline style (btn-outline-*) for the selected variant (not applied to Link).',
      defaultValue: false,
      control: 'boolean',
    },
    size: {
      name: 'Size',
      description: 'Bootstrap button size class.',
      defaultValue: 'btn',
      control: 'select',
      options: {
        "'Medium (default)'": 'btn-md',
        Small: 'btn-sm',
        Large: 'btn-lg',
      },
    },
    label: {
      name: 'Label',
      description: 'Button text.',
      defaultValue: 'Button label',
      control: 'text',
    },
    href: {
      name: 'Link URL (optional)',
      description: 'If provided, renders as a link (<a>) instead of a <button>.',
      defaultValue: '',
      control: 'text',
    },
    target: {
      name: 'Link target',
      description: 'Where to open the link (used only when Link URL is provided).',
      defaultValue: 'self',
      control: 'select',
      options: {
        "'Same tab (default)'": 'self',
        "'New tab'": 'blank',
      },
    },
    disabled: {
      name: 'Disabled',
      defaultValue: false,
      control: 'boolean',
    },
    icon: {
      name: 'Icon',
      description: 'Optional Bootstrap icon name to show with the label.',
      defaultValue: 'none',
      control: 'select',
      options: {
        None: 'none',
        "'Arrow right'": 'arrow-right',
        "'Arrow left'": 'arrow-left',
        "'Arrow right fill'": 'arrow-right-circle-fill',
        "'Arrow left fill'": 'arrow-left-circle-fill',
        "'Arrow up fill'": 'arrow-up-circle-fill',
        "'Arrow down fill'": 'arrow-down-circle-fill',
        "'Caret right fill'": 'caret-right-fill',
        "'Caret left fill'": 'caret-left-fill',
        Plus: 'plus-lg',
        Download: 'download',
        "'External link'": 'box-arrow-up-right',
        Check: 'check-lg',
        Info: 'info-circle',
      },
    },
    icon_first: {
      name: 'Icon first',
      description: 'Show icon before the label.',
      defaultValue: false,
      control: 'boolean',
    },
    alignment: {
      name: 'Alignment',
      description: 'Alignment wrapper for a single button. Use Inline for multiple buttons.',
      defaultValue: 'inline',
      control: 'select',
      options: {
        "'Inline (default)'": 'inline',
        Left: 'left',
        Center: 'center',
        Right: 'right',
      },
    },
    radius: {
      name: 'Radius',
      description: 'Bootstrap border radius utility class.',
      defaultValue: 'rounded',
      control: 'select',
      options: {
        "'Rounded (default)'": 'rounded',
        Pill: 'rounded-pill',
        Square: 'rounded-0',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    variant: 'btn-primary',
    size: 'btn-md',
    label: 'Button',
    href: '',
    target: 'self',
    disabled: false,
    icon: 'none',
    icon_first: false,
    alignment: 'inline',
    radius: 'rounded',
  },
} %}
{{ include('vartheme_bs5:button') }}
{% endstory %}

