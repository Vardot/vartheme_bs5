{% set label = label|default('Button label') %}
{% set variant = variant|default('primary') %}
{% set size = size|default('md') %}
{% set is_disabled = disabled|default(false) %}
{% set href_value = (href is defined and href is not empty) ? href : null %}

{% set target = target|default('self') %}
{% set target_attr = target == 'blank' ? '_blank' : '_self' %}
{% set rel_attr = target == 'blank' ? 'noopener noreferrer' : null %}

{% set icon = icon|default('none') %}
{% set has_icon = icon != 'none' %}
{% set alignment = alignment|default('inline') %}
{% set mobile_width = mobile_width|default(false) %}
{% set full_width = full_width|default(false) %}
{% set radius = radius|default('default') %}

{% set is_icon_first = (icon_first|default(false) ~ '')|lower|trim in ['1','true','yes','on'] %}

{% if variant == 'primary-inverted' %}
  {% set btn_variant_class = 'btn-outline-primary' %}
{% elseif variant == 'secondary-inverted' %}
  {% set btn_variant_class = 'btn-outline-secondary' %}
{% elseif variant starts with 'outline-' %}
  {% set btn_variant_class = 'btn-' ~ variant %}
{% elseif variant == 'link' %}
  {% set btn_variant_class = 'btn-link' %}
{% else %}
  {% set btn_variant_class = 'btn-' ~ variant %}
{% endif %}

{% set size_class = '' %}
{% if size == 'xs' %}
  {% set size_class = 'btn-sm px-2 py-1' %}
{% elseif size == 'sm' %}
  {% set size_class = 'btn-sm' %}
{% elseif size == 'lg' %}
  {% set size_class = 'btn-lg' %}
{% elseif size == 'xl' %}
  {% set size_class = 'btn-lg px-4 py-3' %}
{% endif %}

{% set width_class = full_width ? 'w-100' : (mobile_width ? 'w-100 w-sm-auto' : '') %}

{% set radius_class = radius == 'sm' ? 'rounded-1'
  : radius == 'lg' ? 'rounded-3'
  : radius == 'pill' ? 'rounded-pill'
  : radius == 'none' ? 'rounded-0'
  : '' %}

{% set extra = btn_classes|default('') %}

{% set wrapper_class = alignment == 'left' ? 'd-flex justify-content-start'
  : alignment == 'center' ? 'd-flex justify-content-center'
  : alignment == 'right' ? 'd-flex justify-content-end'
  : '' %}

{% set classes = [
  'btn',
  btn_variant_class,
  size_class,
  width_class,
  radius_class,
  'd-inline-flex',
  'align-items-center',
  'justify-content-center',
  'gap-2'
] %}

{% if has_icon and not is_icon_first %}
  {% set classes = classes|merge(['flex-row-reverse']) %}
{% endif %}

{% set class_attr = (classes|join(' ') ~ ' ' ~ extra)|trim %}

{% if is_disabled %}
  {% set href_value = null %}
{% endif %}

{% if wrapper_class %}<div class="{{ wrapper_class }}">{% endif %}

{% if href_value %}
<a href="{{ href_value|e }}"
   class="{{ class_attr }}"
   target="{{ target_attr }}"
   {% if rel_attr %}rel="{{ rel_attr }}"{% endif %}
   {% if is_disabled %}aria-disabled="true" tabindex="-1"{% endif %}>
{% else %}
<button type="button" class="{{ class_attr }}" {% if is_disabled %}disabled{% endif %}>
{% endif %}

{% if has_icon %}
  {{ include('@vartheme_bs5/components/atoms/icon/icon.twig', {
    icon: icon,
    weight: 'bold',
    icon_size: 'extra-small'
  }, with_context=false) }}
{% endif %}

<span>{{ label }}</span>

{% if href_value %}</a>{% else %}</button>{% endif %}

{% if wrapper_class %}</div>{% endif %}
