{# Button component #}

{% set label = label|default('Button label') %}
{% set variant = variant|default('btn-primary') %}
{% set is_outline = outline|default(false) %}
{% set variant_class = (is_outline and variant != 'btn-link') ? (variant|replace({'btn-':'btn-outline-'}) ) : variant %}
{% set size = size|default('btn') %}
{% set is_disabled = disabled|default(false) %}
{% set href_value = (href is defined and href is not empty) ? href : null %}

{% set target = target|default('self') %}
{% set target_attr = target == 'blank' ? '_blank' : '_self' %}
{% set rel_attr = target == 'blank' ? 'noopener noreferrer' : null %}

{% set icon_value = icon|default('')|trim %}
{% set has_icon = icon_value is not empty and icon_value != 'none' %}

{% set alignment = alignment|default('inline') %}
{% set radius = radius|default('rounded') %}
{% set is_icon_first = (icon_first|default(false) ~ '')|lower|trim in ['1','true','yes','on'] %}
{% set size_text_class = (size == 'btn-lg') ? 'fs-5' : '' %}
{% set width_class = '' %}
{% set radius_class = radius %}

{% set wrapper_class = alignment == 'left' ? 'd-flex justify-content-start'
  : alignment == 'center' ? 'd-flex justify-content-center'
  : alignment == 'right' ? 'd-flex justify-content-end'
  : '' %}

{% set classes = [
  'btn',
  variant_class,
  size,
  size_text_class,
  width_class,
  radius_class,
  'd-inline-flex',
  'align-items-center',
  'justify-content-center',
  'gap-2',
  'fw-bold'
] %}

{% if has_icon and not is_icon_first %}
  {% set classes = classes|merge(['flex-row-reverse']) %}
{% endif %}

{% set class_attr = (classes|join(' '))|trim %}
{% set class_attr = class_attr|replace({'  ':' '}) %}

{% if is_disabled %}
  {% set href_value = null %}
{% endif %}

{% if wrapper_class %}<div class="{{ wrapper_class }}">{% endif %}

{% if href_value %}
<a href="{{ href_value|e }}"
   class="{{ class_attr|e }}"
   target="{{ target_attr }}"
   {% if rel_attr %}rel="{{ rel_attr }}"{% endif %}
   {% if is_disabled %}aria-disabled="true" tabindex="-1"{% endif %}>
{% else %}
<button type="button" class="{{ class_attr|e }}" {% if is_disabled %}disabled{% endif %}>
{% endif %}

{% if has_icon %}
  {{ include('vartheme_bs5:icon', {
    icon: icon_value
  }, with_context = false) }}
{% endif %}

<span>{{ label }}</span>

{% if href_value %}</a>{% else %}</button>{% endif %}

{% if wrapper_class %}</div>{% endif %}