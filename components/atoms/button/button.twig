{# Button component (Bootstrap 5 / VarTheme) #}

{% set label = label|default('Button label') %}
{% set variant = variant|default('primary') %}
{% set size = size|default('medium') %}
{% set is_disabled = disabled|default(false) %}
{% set href_value = (href is defined and href is not empty) ? href : null %}

{% set has_icon = icon is defined and icon is not empty %}
{% set mobile_width = mobile_width|default(false) %}
{% set full_width = full_width|default(false) %}
{% set radius = radius|default('default') %}

{# Normalize icon_first safely #}
{% set raw_icon_first = icon_first|default(false) %}
{% set raw_icon_first_str = (raw_icon_first ~ '')|lower|trim %}
{% set is_icon_first = raw_icon_first_str in ['1','true','yes','on'] %}

{# Validate variant #}
{% set allowed_variants = [
  'primary','secondary','success','danger','warning','info','light','dark','link',
  'primary-inverted','secondary-inverted',
  'outline-primary','outline-secondary','outline-success','outline-danger','outline-warning','outline-info','outline-light','outline-dark'
] %}
{% if variant not in allowed_variants %}
  {% set variant = 'primary' %}
{% endif %}

{# Variant → Bootstrap class #}
{% if variant == 'primary-inverted' %}
  {% set btn_variant_class = 'btn-outline-primary' %}
{% elseif variant == 'secondary-inverted' %}
  {% set btn_variant_class = 'btn-outline-secondary' %}
{% elseif variant starts with 'outline-' %}
  {% set btn_variant_class = 'btn-' ~ variant %}
{% elseif variant == 'link' %}
  {% set btn_variant_class = 'btn-link' %}
{% else %}
  {% set btn_variant_class = 'btn-' ~ variant %}
{% endif %}

{# Size → Bootstrap class #}
{% set size_class = '' %}
{% if size == 'small' %}
  {% set size_class = 'btn-sm' %}
{% elseif size == 'large' %}
  {% set size_class = 'btn-lg' %}
{% endif %}

{# Width classes #}
{% set width_class = '' %}
{% if full_width %}
  {% set width_class = 'w-100' %}
{% elseif mobile_width %}
  {% set width_class = 'w-100 w-sm-auto' %}
{% endif %}

{# Border radius mapping (Bootstrap utilities) #}
{% set radius_class = '' %}
{% if radius == 'sm' %}
  {% set radius_class = 'rounded-1' %}
{% elseif radius == 'lg' %}
  {% set radius_class = 'rounded-3' %}
{% elseif radius == 'pill' %}
  {% set radius_class = 'rounded-pill' %}
{% elseif radius == 'none' %}
  {% set radius_class = 'rounded-0' %}
{% endif %}

{# Extra classes #}
{% set extra = btn_classes|default('') %}
{% if extra is iterable %}
  {% set extra = extra|join(' ') %}
{% endif %}

{# Build classes #}
{% set classes = [
  'btn',
  btn_variant_class,
  size_class,
  width_class,
  radius_class,
  'd-inline-flex',
  'align-items-center',
  'justify-content-center',
  'gap-2'
] %}

{% if has_icon and not is_icon_first %}
  {% set classes = classes|merge(['flex-row-reverse']) %}
{% endif %}

{% set class_attr = (classes|join(' ') ~ ' ' ~ extra)|trim %}

{# Icon size mapping #}
{% set icon_size_map = {
  small: 'extra-extra-small',
  medium: 'extra-small',
  large: 'small'
} %}

{% if is_disabled %}
  {% set href_value = null %}
{% endif %}

{% if href_value %}
  <a
    href="{{ href_value|e }}"
    class="{{ class_attr }}"
    {% if is_disabled %}aria-disabled="true" tabindex="-1"{% endif %}
  >
    {% if has_icon %}
      <span class="d-inline-flex align-items-center">
        {{
          include(
            '@vartheme_bs5/components/atoms/icon/icon.twig',
            {
              weight: 'bold',
              icon: icon,
              icon_size: icon_size_map[size]|default('extra-small')
            },
            with_context: false
          )
        }}
      </span>
    {% endif %}
    <span>{{ label }}</span>
  </a>
{% else %}
  <button
    type="button"
    class="{{ class_attr }}"
    {% if is_disabled %}disabled aria-disabled="true"{% endif %}
  >
    {% if has_icon %}
      <span class="d-inline-flex align-items-center">
        {{
          include(
            '@vartheme_bs5/components/atoms/icon/icon.twig',
            {
              weight: 'bold',
              icon: icon,
              icon_size: icon_size_map[size]|default('extra-small')
            },
            with_context: false
          )
        }}
      </span>
    {% endif %}
    <span>{{ label }}</span>
  </button>
{% endif %}
