{% stories PlainText with {
  title: 'Base/Plain Text',
  parameters: {
    componentSubtitle: 'Plain text wrapper with optional trim',
    docs: {
      description: {
        component: 'Renders plain text with optional trim behavior.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    text: {
      name: 'Plain text',
      description: 'Text content to display.',
      control: 'text',
    },
    trim: {
      name: 'Trim',
      description: 'Enable smart trimming.',
      control: 'boolean',
    },
    trim_length: {
      name: 'Trim length',
      description: 'Number of characters or words to keep.',
      control: 'number',
    },
    trim_units: {
      name: 'Trim units',
      description: 'Trim by characters or words.',
      control: 'select',
      options: ['characters', 'words'],
    },
    suffix: {
      name: 'Suffix',
      description: 'Text appended when content is trimmed.',
      control: 'text',
    },
    strip_html: {
      name: 'Strip HTML',
      description: 'Only works when Trim is enabled.',
      control: 'boolean',
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    text: 'Plain text example',
    trim: false,
    trim_length: 120,
    trim_units: 'characters',
    suffix: '...',
    strip_html: false,
  },
} %}
{{ include('vartheme_bs5:plain-text') }}
{% endstory %}

{% story TrimCharacters with {
  name: 'Trim characters',
  args: {
    text: 'This is a longer plain text example to demonstrate trimming by characters.',
    trim: true,
    trim_length: 28,
    trim_units: 'characters',
    suffix: '...',
    strip_html: false,
  },
} %}
{{ include('vartheme_bs5:plain-text') }}
{% endstory %}

{% story TrimWords with {
  name: 'Trim words',
  args: {
    text: 'This is a longer plain text example to demonstrate trimming by words.',
    trim: true,
    trim_length: 7,
    trim_units: 'words',
    suffix: '...',
    strip_html: true,
  },
} %}
{{ include('vartheme_bs5:plain-text') }}
{% endstory %}

{% endstories %}
