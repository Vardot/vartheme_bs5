{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Plain Text component.
 *
 * Renders plain text with optional smart trimming by words or characters.
 *
 * Available properties:
 * - text: The text content. Defaults to ''.
 * - trim: (true|false) Enable smart trimming. Defaults to `false`.
 * - trim_length: Number of characters or words to keep. Defaults to `50`.
 * - trim_units: Measure trim length in characters or words.
 *               (characters | words) Defaults to `words`.
 * - suffix: Text appended when content is trimmed. Defaults to `...`.
 * - strip_html: (true|false) Strip HTML before trimming. Only works when Trim
 *               is enabled. Defaults to `false`.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set content = text|default('') %}
{% set trim_length = trim_length|default(50) %}
{% set trim_units = trim_units|default('words') %}
{% set suffix = suffix is defined ? suffix : '...' %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set trim = trim ?? false %}
{% set strip_html = strip_html ?? false %}

{# Logic: trimming behavior.
 # - Trim off  => always keep original text (Strip HTML ignored)
 # - Trim on + Strip HTML on  => trim plain text after stripping HTML
 # - Trim on + Strip HTML off => trim content without stripping HTML
 #}
{% set output = content %}
{% set render_raw = false %}

{% if trim and trim_length > 0 %}
  {% if strip_html %}
    {% set plain_text = content|striptags|trim %}
    {% set render_raw = false %}

    {% if trim_units == 'words' %}
      {% set normalized_text = plain_text|replace({'\n': ' ', '\r': ' ', '\t': ' '}) %}
      {% set words = normalized_text ? normalized_text|split(' ') : [] %}
      {% set filtered_words = [] %}
      {% for word in words %}
        {% if word is not empty %}
          {% set filtered_words = filtered_words|merge([word]) %}
        {% endif %}
      {% endfor %}
      {% set output = filtered_words|length > trim_length ? filtered_words|slice(0, trim_length)|join(' ') ~ suffix : plain_text %}
    {% else %}
      {% set output = plain_text|length > trim_length ? plain_text|slice(0, trim_length)|trim ~ suffix : plain_text %}
    {% endif %}
  {% else %}
    {% set render_raw = true %}

    {% if trim_units == 'words' %}
      {% set html_tokens = content|replace({'\n': ' ', '\r': ' ', '\t': ' '})|trim|split(' ') %}
      {% set filtered_html_tokens = [] %}
      {% for token in html_tokens %}
        {% if token is not empty %}
          {% set filtered_html_tokens = filtered_html_tokens|merge([token]) %}
        {% endif %}
      {% endfor %}
      {% set visible_text = content|striptags|replace({'\n': ' ', '\r': ' ', '\t': ' '})|trim %}
      {% set visible_words = visible_text ? visible_text|split(' ') : [] %}
      {% set filtered_visible_words = [] %}
      {% for word in visible_words %}
        {% if word is not empty %}
          {% set filtered_visible_words = filtered_visible_words|merge([word]) %}
        {% endif %}
      {% endfor %}

      {% set output = filtered_visible_words|length > trim_length ? filtered_html_tokens|slice(0, trim_length)|join(' ') ~ suffix : content %}
    {% else %}
      {% set visible_text = content|striptags|trim %}
      {% set output = visible_text|length > trim_length ? content|slice(0, trim_length)|trim ~ suffix : content %}
    {% endif %}
  {% endif %}
{% endif %}

{# Print the HTML. #}
{% if content is not empty %}
  <div>
    {% if render_raw %}
      {{ output|raw }}
    {% else %}
      {{ output|e }}
    {% endif %}
  </div>
{% endif %}
