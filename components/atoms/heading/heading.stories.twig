{% stories Heading with {
  title: 'Base/Heading',
  parameters: {
    componentSubtitle: 'Bootstrap heading component',
    docs: {
      description: {
        component: 'Renders an HTML heading (h1–h6) with optional Bootstrap typography utilities and optional link.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    heading_text: {
      name: 'Heading text',
      defaultValue: 'Enter title',
      control: 'text',
    },
    level: {
      name: 'Heading level',
      description: 'HTML heading tag (h1–h6).',
      defaultValue: 2,
      control: 'select',
      options: {
        H1: 1,
        H2: 2,
        H3: 3,
        H4: 4,
        H5: 5,
        H6: 6,
      },
    },
    text_size: {
      name: 'Text size',
      description: 'Optional Bootstrap typography utility.',
      control: 'select',
      options: {
        "'Heading size: H1'": 'h1',
        "'Heading size: H2'": 'h2',
        "'Heading size: H3'": 'h3',
        "'Heading size: H4'": 'h4',
        "'Heading size: H5'": 'h5',
        "'Heading size: H6'": 'h6',
        "'Display 1'": 'display-1',
        "'Display 2'": 'display-2',
        "'Display 3'": 'display-3',
        "'Display 4'": 'display-4',
        "'Display 5'": 'display-5',
        "'Display 6'": 'display-6',
      },
    },
    text_color: {
      name: 'Text color',
      description: 'Bootstrap text color utility.',
      control: 'select',
      options: {
        Primary: 'text-primary',
        Secondary: 'text-secondary',
        Success: 'text-success',
        Danger: 'text-danger',
        Warning: 'text-warning',
        Info: 'text-info',
        Muted: 'text-muted',
        White: 'text-white',
        Dark: 'text-dark',
      },
    },
    align: {
      name: 'Alignment',
      description: 'Bootstrap text alignment utility.',
      control: 'select',
      options: {
        Left: 'text-start',
        Center: 'text-center',
        Right: 'text-end',
      },
    },
    font_weight: {
      name: 'Font weight',
      description: 'Bootstrap font weight utility.',
      control: 'select',
      options: {
        Light: 'fw-light',
        Normal: 'fw-normal',
        Medium: 'fw-medium',
        Semibold: 'fw-semibold',
        Bold: 'fw-bold',
      },
    },
    font_style: {
      name: 'Font style',
      description: 'Bootstrap font style utility.',
      control: 'select',
      options: {
        Italic: 'fst-italic',
      },
    },
    url: {
      name: 'Link (optional)',
      description: 'If provided, the heading text will be a link.',
      control: 'text',
    },
    target: {
      name: 'Link target',
      description: 'Target attribute for the link.',
      control: 'select',
      options: {
        "'Same tab'": '_self',
        "'New tab'": '_blank',
      },
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    heading_text: 'Page title',
    level: 2,
  },
} %}
{{ include('vartheme_bs5:heading') }}
{% endstory %}

{% story HeadingLevels with {
  name: 'Heading levels',
  args: {},
} %}
{{ include('vartheme_bs5:heading', { heading_text: 'Heading H1', level: 1 }, with_context: false) }}
{{ include('vartheme_bs5:heading', { heading_text: 'Heading H2', level: 2 }, with_context: false) }}
{{ include('vartheme_bs5:heading', { heading_text: 'Heading H3', level: 3 }, with_context: false) }}
{{ include('vartheme_bs5:heading', { heading_text: 'Heading H4', level: 4 }, with_context: false) }}
{{ include('vartheme_bs5:heading', { heading_text: 'Heading H5', level: 5 }, with_context: false) }}
{{ include('vartheme_bs5:heading', { heading_text: 'Heading H6', level: 6 }, with_context: false) }}
{% endstory %}

{% story Display with {
  name: 'Display style',
  args: {
    heading_text: 'Display heading',
    level: 2,
    text_size: 'display-3',
    text_color: 'text-primary',
  },
} %}
{{ include('vartheme_bs5:heading') }}
{% endstory %}

{% story Centered with {
  name: 'Centered',
  args: {
    heading_text: 'Centered heading',
    level: 3,
    text_color: 'text-success',
    align: 'text-center',
  },
} %}
{{ include('vartheme_bs5:heading') }}
{% endstory %}

{% story LinkedBlank with {
  name: 'Linked (new tab)',
  args: {
    heading_text: 'Linked heading',
    level: 2,
    text_color: 'text-info',
    url: 'https://getbootstrap.com/docs/5.3/content/typography/#headings',
    target: '_blank',
  },
} %}
{{ include('vartheme_bs5:heading') }}
{% endstory %}

{% endstories %}
