{# Values #}
{% set text = heading_text|default('Enter title') %}
{% set level = level|default(2) %}
{% set has_url = url is not empty %}

{# Bootstrap classes #}
{% set classes = [] %}

{# Alignment #}
{% set align_map = {
  start: 'text-start',
  center: 'text-center',
  end: 'text-end'
} %}
{% set classes = classes|merge([align_map[align]|default('text-start')]) %}

{# Text color #}
{% set color_map = {
  default: 'text-body',
  primary: 'text-primary',
  secondary: 'text-secondary',
  success: 'text-success',
  danger: 'text-danger',
  warning: 'text-warning',
  info: 'text-info',
  muted: 'text-muted',
  white: 'text-white'
} %}
{% set classes = classes|merge([color_map[text_color]|default('text-body')]) %}

{# Size override #}
{% if text_size != 'default' %}
  {% set classes = classes|merge([text_size]) %}
{% endif %}

{# Extra classes #}
{% if extra_classes|trim %}
  {% set classes = classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

{# Build attributes #}
{% set attrs = create_attribute().addClass(classes) %}
{% if id|trim %}
  {% set attrs = attrs.setAttribute('id', id|trim) %}
{% endif %}

{# Content #}
{% set content %}
  {% if has_url %}
    <a href="{{ url }}" class="text-reset text-decoration-none">{{ text }}</a>
  {% else %}
    {{ text }}
  {% endif %}
{% endset %}

{# Render heading #}
{% if level == 1 %}
  <h1{{ attrs }}>{{ content }}</h1>
{% elseif level == 2 %}
  <h2{{ attrs }}>{{ content }}</h2>
{% elseif level == 3 %}
  <h3{{ attrs }}>{{ content }}</h3>
{% elseif level == 4 %}
  <h4{{ attrs }}>{{ content }}</h4>
{% elseif level == 5 %}
  <h5{{ attrs }}>{{ content }}</h5>
{% elseif level == 6 %}
  <h6{{ attrs }}>{{ content }}</h6>
{% endif %}
