{# Heading component #}

{# Prepare values before markup #}
{% set level = level|default(3) %}
{% set tag = 'h' ~ level %}
{% set heading_text = heading_text|default('') %}
{% set url = url|default('')|trim %}
{% set target = target|default('_self') %}


{% set text_size = text_size|default('') %}
{% set text_color = text_color|default('') %}
{% set align = align|default('') %}
{% set font_weight = font_weight|default('') %}
{% set font_style = font_style|default('') %}

{# Build attributes (keep markup simple) #}
{% set class_list = [text_size, text_color, align, font_weight, font_style]|filter(v => v is not empty) %}
{% set heading_attributes = create_attribute() %}
{% if class_list %}
  {% set heading_attributes = heading_attributes.addClass(class_list) %}
{% endif %}

{# Link props for vartheme_bs5:link #}
{% set link_props = url ? { url: url, content: heading_text } : {} %}
{% if url and target and target != '_self' %}
  {% set link_props = link_props|merge({ target: target }) %}
{% endif %}

<{{ tag }}{{ heading_attributes }}>
  {% if url %}
    {% include 'vartheme_bs5:link' with link_props only %}
  {% else %}
    {{ heading_text }}
  {% endif %}
</{{ tag }}>
