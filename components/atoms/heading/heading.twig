{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Heading component.
 *
 * Renders an HTML heading (h1–h6). When a URL is provided, the heading text
 * is rendered as a link using the vartheme_bs5:link component.
 *
 * Available properties:
 * - heading_text: The heading text. Defaults to `Enter title`.
 * - level: HTML heading tag level. (1 | 2 | 3 | 4 | 5 | 6) Defaults to `3`.
 * - text_size: Optional Bootstrap typography utility. Leave empty to match the
 *              selected heading level. (h1 | h2 | h3 | h4 | h5 | h6 | display-1
 *              | display-2 | display-3 | display-4 | display-5 | display-6)
 *              Defaults to empty.
 * - text_color: Bootstrap text color utility. Leave empty for theme default.
 *               (text-primary | text-secondary | text-success | text-danger
 *                | text-warning | text-info | text-muted | text-white | text-dark)
 *               Defaults to empty.
 * - align: Bootstrap text alignment utility. Leave empty for default alignment.
 *          (text-start | text-center | text-end) Defaults to empty.
 * - font_weight: Bootstrap font weight utility. Leave empty for default weight.
 *                (fw-light | fw-normal | fw-medium | fw-semibold | fw-bold)
 *                Defaults to empty.
 * - font_style: Bootstrap font style utility. Leave empty for default style.
 *               (fst-italic) Defaults to empty.
 * - url: Optional. When provided, the heading text is rendered as a link using
 *        the vartheme_bs5:link component. Defaults to empty.
 * - target: Optional. Controls where the linked heading opens.
 *           (_self | _blank) Defaults to `_self`.
 *
 * Available attributes:
 * - attributes: Attributes array.
 *
 * Available slots:
 * - N/A
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set level = level|default(3) %}
{% set heading_text = heading_text|default('') %}
{% set url = url|default('')|trim %}
{% set target = target|default('_self') %}
{% set text_size = text_size|default('') %}
{% set text_color = text_color|default('') %}
{% set align = align|default('') %}
{% set font_weight = font_weight|default('') %}
{% set font_style = font_style|default('') %}

{# Logic: heading tag from level. #}
{% set tag = 'h' ~ level %}

{# Logic: merge all classes as arrays, only the ones set. #}
{% set classes = [
  text_size,
  text_color,
  align,
  font_weight,
  font_style,
]|filter(v => v is not empty) %}

{% set attributes = attributes.addClass(classes) %}

{# Logic: link props for vartheme_bs5:link, only when a URL is set. #}
{% set link_props = url ? { url: url, content: heading_text } : {} %}
{% if url and target and target != '_self' %}
  {% set link_props = link_props|merge({ target: target }) %}
{% endif %}

{# Print the HTML. #}
<{{ tag }}{{ attributes }}>
  {% if url %}
    {% include 'vartheme_bs5:link' with link_props only %}
  {% else %}
    {{ heading_text }}
  {% endif %}
</{{ tag }}>
