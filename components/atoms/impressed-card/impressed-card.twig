{#
  Impressed Card (Bootstrap 5) - Canvas + SDC safe
  - No inline CSS/JS
  - Stacked layout (media top/bottom)
  - Canvas: expose ONLY the content slot for drag & drop
  - Media is controlled via the Media upload prop (no drag & drop slot UI)
#}

{% set html_id = html_id|default('') %}
{% set extra_classes = extra_classes|default('')|trim %}

{% set media_position = media_position|default('top') %}
{% set card_border = card_border|default(false) %}
{% set padded = padded|default('none') %}
{% set equal_height = equal_height|default(false) %}
{% set anchor_all = anchor_all|default(true) %}
{% set box_shadow = box_shadow|default('none') %}
{% set background_color = background_color|default('none') %}

{% set corner_style = corner_style|default('rounded') %}
{% set corner_map = { none: '', rounded_sm: 'rounded-1', rounded: 'rounded-3', rounded_lg: 'rounded-4', rounded_pill: 'rounded-pill' } %}
{% set corner_class = corner_map[corner_style]|default('rounded-3') %}

{% set link_url = link_url|default('')|trim %}
{% set link_target = link_target|default('default') %}
{% set link_target_attr = (link_target != 'default') ? link_target : '' %}

{% set media_image = media_image|default({}) %}
{% set has_media = (media_image.src|default('')|trim) is not empty %}

{# Canvas slots: expose ONLY the content slot. #}
{% set content_slot %}{% block content %}{% endblock %}{% endset %}
{% set has_content_slot = content_slot|render|trim is not empty %}

{# Fallback placeholder image. #}
{% set placeholder_src = (component_metadata.path is defined) ? (component_metadata.path ~ '/assets/impressed-card-image-placeholder.svg') : 'assets/impressed-card-image-placeholder.svg' %}
{% set img_src = has_media ? media_image.src : placeholder_src %}
{% set img_alt = media_image.alt|default('') %}
{% set img_width = media_image.width|default(null) %}
{% set img_height = media_image.height|default(null) %}

{% set padding_map = { small: 'p-2', medium: 'p-3', large: 'p-4', x_large: 'p-5' } %}
{% set body_padding_class = padding_map[padded]|default('p-0') %}

{% set card_classes = [
  'impressed-card',
  'card',
  'overflow-hidden',
  ((background_color != 'none') ? background_color : ''),
  corner_class,
  (card_border ? 'border' : 'border-0'),
  ((box_shadow != 'none') ? box_shadow : ''),
  (equal_height ? 'h-100' : ''),
  ((link_url and not anchor_all) ? 'position-relative' : ''),
  extra_classes
]|join(' ')|trim %}


{# Make the whole card clickable when enabled and URL is provided #}
{% set use_anchor_all = anchor_all and link_url %}

<div{% if html_id %} id="{{ html_id }}"{% endif %} class="{{ card_classes }}">
  {# Whole-card link wrapper #}
  {% if use_anchor_all %}
    <a class="impressed-card__linkwrap d-block text-decoration-none text-reset" href="{{ link_url }}"{% if link_target_attr %} target="{{ link_target_attr }}"{% endif %}>
  {% endif %}

  {# Media #}
  {% if media_position == 'top' %}
    <div class="impressed-card__media">
      <img class="impressed-card__media-img img-fluid w-100" src="{{ img_src }}" alt="{{ img_alt }}"{% if img_width %} width="{{ img_width }}"{% endif %}{% if img_height %} height="{{ img_height }}"{% endif %} loading="lazy">
    </div>
  {% endif %}

  {# Content (Canvas drag & drop) #}
  <div class="impressed-card__content {{ body_padding_class }}{% if not has_content_slot %} is-empty{% endif %}">
    {% if has_content_slot %}
      {{ content_slot }}
    {% else %}
      <div class="impressed-card__placeholder text-muted small py-3">
        Drop content here
      </div>
    {% endif %}
    {# Non-anchor-all link (optional) #}
    {% if link_url and (not anchor_all) %}
      <a class="stretched-link" href="{{ link_url }}"{% if link_target_attr %} target="{{ link_target_attr }}"{% endif %}></a>
    {% endif %}
  </div>

  {% if media_position == 'bottom' %}
    <div class="impressed-card__media">
      <img class="impressed-card__media-img img-fluid w-100" src="{{ img_src }}" alt="{{ img_alt }}"{% if img_width %} width="{{ img_width }}"{% endif %}{% if img_height %} height="{{ img_height }}"{% endif %} loading="lazy">
    </div>
  {% endif %}

  {% if use_anchor_all %}
    </a>
  {% endif %}
</div>
