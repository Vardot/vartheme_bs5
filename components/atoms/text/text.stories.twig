{% stories Text with {
  title: 'Base/Text',
  parameters: {
    componentSubtitle: 'Bootstrap Text component',
    docs: {
      description: {
        component: 'Renders trusted HTML content with optional size and color utilities.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    text: {
      name: 'Content (rich text)',
      description: 'HTML content. Make sure it is already filtered / trusted.',
      defaultValue: '<p><strong>Hello</strong> from rich text.</p>',
      control: 'text',
    },
    text_size: {
      name: 'Text size',
      description: 'Bootstrap font-size utility class.',
      defaultValue: 'none',
      control: 'select',
      options: {
        None: 'none',
        "'Small (fs-6)'": 'fs-6',
        "'Medium (fs-5)'": 'fs-5',
        "'Large (fs-4)'": 'fs-4',
        "'Extra large (fs-3)'": 'fs-3',
      },
    },
    text_color: {
      name: 'Text color',
      description: 'Bootstrap text color utility class.',
      defaultValue: 'text-body',
      control: 'select',
      options: {
        "'Default (text-body)'": 'text-body',
        "'Primary (text-primary)'": 'text-primary',
        "'Secondary (text-secondary)'": 'text-secondary',
        "'Success (text-success)'": 'text-success',
        "'Danger (text-danger)'": 'text-danger',
        "'Warning (text-warning)'": 'text-warning',
        "'Info (text-info)'": 'text-info',
        "'Muted (text-muted)'": 'text-muted',
        "'Dark (text-dark)'": 'text-dark',
        "'White (text-white)'": 'text-white',
      },
    },
  },
} %}

{% story TextOnly with {
  name: 'Text',
  args: {
    text: '<p><strong>Hello</strong> from rich text.</p>',
  },
} %}
{{ include('vartheme_bs5:text') }}
{% endstory %}

{% story TextSizeOnly with {
  name: 'Text size',
  args: {
    text: '<p><strong>Hello</strong> from rich text.</p>',
    text_size: 'fs-3',
  },
} %}
{{ include('vartheme_bs5:text') }}
{% endstory %}

{% story TextColorOnly with {
  name: 'Text color',
  args: {
    text: '<p><strong>Hello</strong> from rich text.</p>',
    text_color: 'text-primary',
  },
} %}
{{ include('vartheme_bs5:text') }}
{% endstory %}

{% endstories %}
