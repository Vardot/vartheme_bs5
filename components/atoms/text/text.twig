{# Rich Text component (SDC / Canvas-friendly, Bootstrap utilities) #}

{# Props are Bootstrap utility class names (e.g. fs-6, text-body) so we can use them directly #}
{% set classes = [
  'rich-text',
  text_size|default('none'),
  text_color|default('text-body')
]|filter(v => v is not empty) %}

{% set attrs = create_attribute().addClass(classes) %}

{% set content = text|default('') %}

<div {{ attrs }}>
  {{ content|raw }}
</div>
