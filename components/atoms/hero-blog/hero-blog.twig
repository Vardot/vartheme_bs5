{#
  Hero Blog (Bootstrap 5)
  Shows: published date, title, author, and an optional media slot.
#}

{% set container = container_width|default('container') %}
{% set extra = extra_classes|default('')|trim %}
{% set classes = ['hero-blog', 'py-4', 'py-md-5', extra]|filter(v => v is not empty) %}

{# Date is passed as a unix timestamp in the component examples. #}
{% set date_formatted = date is not empty ? (date|date('M d, Y')) : '' %}

<section class="{{ classes|join(' ') }}">
  <div class="{{ container }}">
    <div class="row justify-content-center">
      <div class="col-12 col-lg-10 col-xl-8">
        {% if date_formatted %}
          <p class="text-muted mb-2">
            <time datetime="{{ date|date('Y-m-d') }}">{{ date_formatted }}</time>
          </p>
        {% endif %}

        {{
          include(
            'vartheme_bs5:heading',
            {
              heading_text: heading_text|default(''),
              level: level|default(1),
              url: '',
              text_color: 'default',
              text_size: heading_size|default('display-4'),
              align: 'start'
            },
            with_context: false
          )
        }}

        {% if author is not empty %}
          <p class="mt-3 mb-0">
            <span class="text-muted">By</span>
            {% if author_url is not empty %}
              <a href="{{ author_url }}" class="link-body-emphasis text-decoration-none">{{ author }}</a>
            {% else %}
              <span class="fw-semibold">{{ author }}</span>
            {% endif %}
          </p>
        {% endif %}
      </div>
    </div>
  </div>

  {% if block('blog_media') is defined %}
    <div class="mt-4 mt-md-5">
      <div class="{{ container }}">
        <div class="row justify-content-center">
          <div class="col-12 col-lg-10 col-xl-10">
            {% block blog_media %}{% endblock %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</section>
