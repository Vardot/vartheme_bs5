{# Hero Blog #}

{% set heading_size_value = heading_size|default('default') %}
{% set date_value = date|default('') %}
{% set author_value = author|default('') %}
{% set author_url_value = author_url|default('')|trim %}

{% set heading_props = {
  heading_text: heading_text|default(''),
  level: level|default(2),
  url: ''
} %}
{% if heading_size_value != 'default' %}
  {% set heading_props = heading_props|merge({ text_size: heading_size_value }) %}
{% endif %}

{% set author_link_props = {
  url: author_url_value,
  content: author_value
} %}

{% set section_attributes = create_attribute().addClass(['py-4', 'py-md-5']) %}
{% set container_attributes = create_attribute().addClass(['container']) %}
{% set inner_row_attributes = create_attribute().addClass(['row', 'justify-content-center']) %}
{% set content_col_attributes = create_attribute().addClass(['col-12', 'col-lg-10', 'col-xl-8']) %}
{% set date_attributes = create_attribute().addClass(['text-muted', 'mb-2']) %}
{% set author_attributes = create_attribute().addClass(['mt-3', 'mb-0']) %}
{% set author_prefix_attributes = create_attribute().addClass(['text-muted']) %}
{% set author_name_attributes = create_attribute().addClass(['fw-semibold']) %}
{% set media_attributes = create_attribute().addClass(['mt-4']) %}

<section{{ section_attributes }}>
  <div{{ container_attributes }}>
    <div{{ inner_row_attributes }}>
      <div{{ content_col_attributes }}>
        {% if date_value %}
          <p{{ date_attributes }}>{{ include('vartheme_bs5:date', { date: date_value }, with_context: false) }}</p>
        {% endif %}

        {{ include('vartheme_bs5:heading', heading_props, with_context: false) }}

        {% if author_value is not empty %}
          <p{{ author_attributes }}>
            <span{{ author_prefix_attributes }}>By</span>
            {% if author_url_value is not empty %}
              {{ include('vartheme_bs5:link', author_link_props, with_context: false) }}
            {% else %}
              <span{{ author_name_attributes }}>{{ author_value }}</span>
            {% endif %}
          </p>
        {% endif %}
        {% if blog_media is defined and blog_media is not empty %}
          <div{{ media_attributes }}>{{ blog_media }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
