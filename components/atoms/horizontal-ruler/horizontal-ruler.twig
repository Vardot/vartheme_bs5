{#
  Horizontal Ruler (Bootstrap 5.3)
#}

{% set horizontal_border_width = border_width|default('border-1') %}
{% set horizontal_border_color = border_color|default('border-secondary') %}
{% set horizontal_opacity = opacity|default('opacity-100') %}
{% set horizontal_margin_top = margin_top|default('mt-3') %}
{% set horizontal_margin_bottom = margin_bottom|default('mb-3') %}

{% set horizontal_classes = [
  horizontal_border_width,
  horizontal_border_color,
  horizontal_opacity,
  horizontal_margin_top,
  horizontal_margin_bottom,
]|filter(v => v is not empty) %}

{% set horizontal_attributes = create_attribute({
  class: horizontal_classes,
}) %}

<hr{{ horizontal_attributes }}>
