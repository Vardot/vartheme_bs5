{% stories Section with {
  title: 'Layout/Section',
  parameters: {
    componentSubtitle: 'Bootstrap Section layout wrapper',
    docs: {
      description: {
        component: 'Flexible section wrapper with Bootstrap-based spacing, containers, background options, background image overlays, and responsive column presets.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    bg_edge2edge: {
      name: 'Background edge-to-edge',
      control: 'boolean',
      defaultValue: false,
    },
    container_type: {
      name: 'Container style',
      control: 'select',
      defaultValue: 'container',
      options: {
        Container: 'container',
        "'Full width (fluid)'": 'container-fluid',
        "'No container'": 'none',
      },
    },
    background_color: {
      name: 'Background color',
      control: 'select',
      defaultValue: 'none',
      options: {
        None: 'none',
        Body: 'bg-body',
        "'Body secondary'": 'bg-body-secondary',
        "'Body tertiary'": 'bg-body-tertiary',
        Tertiary: 'bg-tertiary',
        Accent: 'bg-accent',
        Primary: 'bg-primary',
        "'Primary subtle'": 'bg-primary-subtle',
        Secondary: 'bg-secondary',
        "'Secondary subtle'": 'bg-secondary-subtle',
        Success: 'bg-success',
        "'Success subtle'": 'bg-success-subtle',
        Danger: 'bg-danger',
        "'Danger subtle'": 'bg-danger-subtle',
        Warning: 'bg-warning',
        "'Warning subtle'": 'bg-warning-subtle',
        Info: 'bg-info',
        "'Info subtle'": 'bg-info-subtle',
        Light: 'bg-light',
        "'Light subtle'": 'bg-light-subtle',
        Dark: 'bg-dark',
        "'Dark subtle'": 'bg-dark-subtle',
        Black: 'bg-black',
        White: 'bg-white',
        Transparent: 'bg-transparent',
      },
    },
    text_color: {
      name: 'Text color',
      control: 'select',
      defaultValue: 'auto',
      options: {
        Auto: 'auto',
        Default: 'text-body',
        Dark: 'text-dark',
        White: 'text-white',
        Muted: 'text-muted',
      },
    },
    background_media: {
      name: 'Background image object',
      control: 'object',
      defaultValue: {},
    },
    background_overlay: {
      name: 'Image overlay',
      control: 'select',
      defaultValue: 'none',
      options: {
        None: 'none',
        "'Light (10%)'": 'overlay-10',
        "'Soft (25%)'": 'overlay-25',
        "'Medium (50%)'": 'overlay-50',
        "'Strong (75%)'": 'overlay-75',
      },
    },
    columns: {
      name: 'Grid layout',
      control: 'select',
      defaultValue: '50-50',
      options: {
        "'1 column (100%)'": '100',
        "'2 columns (50 / 50)'": '50-50',
        "'3 columns (33 / 33 / 33)'": '33-33-33',
        "'2 columns (75 / 25)'": '75-25',
        "'2 columns (25 / 75)'": '25-75',
        "'2 columns (67 / 33)'": '67-33',
        "'2 columns (33 / 67)'": '33-67',
        "'3 columns (50 / 25 / 25)'": '50-25-25',
        "'3 columns (25 / 25 / 50)'": '25-25-50',
        "'4 columns'": '25-25-25-25',
        "'5 columns'": '20-20-20-20-20',
        "'6 columns'": '16-16-16-16-16-16',
      },
    },
    gutter: {
      name: 'Grid gap',
      control: 'select',
      defaultValue: 'gx-3 gy-3',
      options: {
        None: 'gx-0 gy-0',
        Small: 'gx-1 gy-1',
        Medium: 'gx-2 gy-2',
        Large: 'gx-3 gy-3',
        "'Extra large'": 'gx-4 gy-4',
        "'XX-Large'": 'gx-5 gy-5',
      },
    },
    vertical_alignment: {
      name: 'Vertical alignment',
      control: 'select',
      defaultValue: 'align-items-start',
      options: {
        Top: 'align-items-start',
        Center: 'align-items-center',
        Bottom: 'align-items-end',
      },
    },
    horizontal_alignment: {
      name: 'Horizontal alignment',
      control: 'select',
      defaultValue: 'text-start',
      options: {
        Left: 'text-start',
        Center: 'text-center',
        Right: 'text-end',
      },
    },
    padding_block_start: {
      name: 'Padding top',
      control: 'select',
      defaultValue: 'pt-0',
      options: {
        None: 'pt-0',
        Small: 'pt-1',
        Medium: 'pt-2',
        Large: 'pt-3',
        "'Extra large'": 'pt-4',
        "'XX-Large'": 'pt-5',
      },
    },
    padding_block_end: {
      name: 'Padding bottom',
      control: 'select',
      defaultValue: 'pb-0',
      options: {
        None: 'pb-0',
        Small: 'pb-1',
        Medium: 'pb-2',
        Large: 'pb-3',
        "'Extra large'": 'pb-4',
        "'XX-Large'": 'pb-5',
      },
    },
    padding_inline_start: {
      name: 'Padding start',
      control: 'select',
      defaultValue: 'ps-0',
      options: {
        None: 'ps-0',
        Small: 'ps-1',
        Medium: 'ps-2',
        Large: 'ps-3',
        "'Extra large'": 'ps-4',
        "'XX-Large'": 'ps-5',
      },
    },
    padding_inline_end: {
      name: 'Padding end',
      control: 'select',
      defaultValue: 'pe-0',
      options: {
        None: 'pe-0',
        Small: 'pe-1',
        Medium: 'pe-2',
        Large: 'pe-3',
        "'Extra large'": 'pe-4',
        "'XX-Large'": 'pe-5',
      },
    },
    margin_block_start: {
      name: 'Margin top',
      control: 'select',
      defaultValue: 'mt-0',
      options: {
        None: 'mt-0',
        Small: 'mt-1',
        Medium: 'mt-2',
        Large: 'mt-3',
        "'Extra large'": 'mt-4',
        "'XX-Large'": 'mt-5',
      },
    },
    margin_block_end: {
      name: 'Margin bottom',
      control: 'select',
      defaultValue: 'mb-0',
      options: {
        None: 'mb-0',
        Small: 'mb-1',
        Medium: 'mb-2',
        Large: 'mb-3',
        "'Extra large'": 'mb-4',
        "'XX-Large'": 'mb-5',
      },
    },
    margin_inline_start: {
      name: 'Margin start',
      control: 'select',
      defaultValue: 'ms-0',
      options: {
        None: 'ms-0',
        Small: 'ms-1',
        Medium: 'ms-2',
        Large: 'ms-3',
        "'Extra large'": 'ms-4',
        "'XX-Large'": 'ms-5',
      },
    },
    margin_inline_end: {
      name: 'Margin end',
      control: 'select',
      defaultValue: 'me-0',
      options: {
        None: 'me-0',
        Small: 'me-1',
        Medium: 'me-2',
        Large: 'me-3',
        "'Extra large'": 'me-4',
        "'XX-Large'": 'me-5',
      },
    },
    shadow: {
      name: 'Shadow',
      control: 'select',
      defaultValue: 'none',
      options: {
        None: 'none',
        Small: 'shadow-sm',
        Medium: 'shadow',
        Large: 'shadow-lg',
      },
    },
    radius: {
      name: 'Border radius',
      control: 'select',
      defaultValue: 'none',
      options: {
        None: 'none',
        Default: 'rounded',
        Square: 'rounded-0',
        Small: 'rounded-1',
        Medium: 'rounded-2',
        Large: 'rounded-3',
        "'Extra Large'": 'rounded-4',
        Round: 'rounded-pill',
      },
    },
    border: {
      name: 'Border',
      control: 'select',
      defaultValue: 'none',
      options: {
        None: 'none',
        "'All sides'": 'border',
        Top: 'border-top',
        Bottom: 'border-bottom',
        Start: 'border-start',
        End: 'border-end',
      },
    },
    border_color: {
      name: 'Border color',
      control: 'select',
      defaultValue: 'none',
      options: {
        Default: 'none',
        Primary: 'border-primary',
        "'Primary subtle'": 'border-primary-subtle',
        Secondary: 'border-secondary',
        "'Secondary subtle'": 'border-secondary-subtle',
        Success: 'border-success',
        "'Success subtle'": 'border-success-subtle',
        Danger: 'border-danger',
        "'Danger subtle'": 'border-danger-subtle',
        Warning: 'border-warning',
        "'Warning subtle'": 'border-warning-subtle',
        Info: 'border-info',
        "'Info subtle'": 'border-info-subtle',
        Light: 'border-light',
        Dark: 'border-dark',
        "'Dark subtle'": 'border-dark-subtle',
        Black: 'border-black',
        White: 'border-white',
      },
    },
    border_width: {
      name: 'Border width',
      control: 'select',
      defaultValue: 'none',
      options: {
        Default: 'none',
        "'Extra small'": 'border-1',
        Small: 'border-2',
        Medium: 'border-3',
        Large: 'border-4',
        "'Extra large'": 'border-5',
      },
    },
    section_header: {
      name: 'Show header region',
      control: 'boolean',
      defaultValue: true,
    },
    section_footer: {
      name: 'Show footer region',
      control: 'boolean',
      defaultValue: false,
    },
  },
} %}

{% story Default with {
  name: 'Default',
  args: {
    bg_edge2edge: false,
    container_type: 'container',
    background_color: 'bg-body-tertiary',
    text_color: 'auto',
    background_overlay: 'none',
    columns: '50-50',
    gutter: 'gx-4 gy-4',
    vertical_alignment: 'align-items-start',
    horizontal_alignment: 'text-start',
    padding_block_start: 'pt-5',
    padding_block_end: 'pb-5',
    padding_inline_start: 'ps-0',
    padding_inline_end: 'pe-0',
    margin_block_start: 'mt-0',
    margin_block_end: 'mb-0',
    margin_inline_start: 'ms-0',
    margin_inline_end: 'me-0',
    shadow: 'none',
    radius: 'none',
    border: 'none',
    border_color: 'none',
    border_width: 'none',
    section_header: true,
    section_footer: true,
  },
} %}
{% embed 'vartheme_bs5:section' with _context %}
  {% block header_slot %}
    <div class="text-center">
      <h2 class="h3 mb-2">Default section</h2>
      <p class="mb-0 text-muted">A simple two-column layout inside a standard container.</p>
    </div>
  {% endblock %}
  {% block col_1 %}
    <div class="p-4 border rounded-3 h-100 bg-white">
      <h3 class="h5">Column one</h3>
      <p class="mb-0">Use this area for introductory copy, feature text, or layout building blocks.</p>
    </div>
  {% endblock %}
  {% block col_2 %}
    <div class="p-4 border rounded-3 h-100 bg-white">
      <h3 class="h5">Column two</h3>
      <p class="mb-0">The component only renders the selected number of columns for the chosen preset.</p>
    </div>
  {% endblock %}
  {% block footer_slot %}
    <div class="small text-muted text-center">Footer region example</div>
  {% endblock %}
{% endembed %}
{% endstory %}

