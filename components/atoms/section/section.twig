{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Section component.
 *
 * Bootstrap Section wrapper for building layouts (container, background,
 * spacing, and responsive grid presets). Renders ONLY the selected number
 * of columns based on the "columns" preset.
 *
 * Available properties:
 * - bg_edge2edge: (true|false) Enable full-bleed background (adds the
 *                 `bg-edge2edge` class). Defaults to `false`.
 * - container_type: How the content is contained.
 *                   (container | container-fluid | none) Defaults to `none`.
 * - background_color: Bootstrap background utility class.
 *                     (none | bg-body | bg-body-secondary | bg-body-tertiary
 *                      | bg-tertiary | bg-accent | bg-primary | bg-primary-subtle
 *                      | bg-secondary | bg-secondary-subtle | bg-success
 *                      | bg-success-subtle | bg-danger | bg-danger-subtle
 *                      | bg-warning | bg-warning-subtle | bg-info | bg-info-subtle
 *                      | bg-light | bg-light-subtle | bg-dark | bg-dark-subtle
 *                      | bg-black | bg-white | bg-transparent) Defaults to `none`.
 * - text_color: Text color utility. `auto` uses white text on dark backgrounds.
 *               (auto | text-body | text-dark | text-white | text-muted)
 *               Defaults to `auto`.
 * - background_media: Background image object (src, alt, width, height).
 * - background_overlay: Dark overlay on top of the background image.
 *                       (none | overlay-10 | overlay-25 | overlay-50 | overlay-75)
 *                       Defaults to `none`.
 * - columns: Grid layout preset for tablet/desktop. Shows ONLY the selected
 *            number of columns.
 *            (100 | 50-50 | 33-33-33 | 75-25 | 25-75 | 67-33 | 33-67
 *             | 50-25-25 | 25-25-50 | 25-25-25-25 | 20-20-20-20-20
 *             | 16-16-16-16-16-16) Defaults to `50-50`.
 * - gutter: Space between columns (Bootstrap gutters).
 *           (gx-0 gy-0 | gx-1 gy-1 | gx-2 gy-2 | gx-3 gy-3 | gx-4 gy-4
 *            | gx-5 gy-5) Defaults to `gx-3 gy-3`.
 * - padding_block_start: Padding top. (pt-0..pt-5) Defaults to `pt-0`.
 * - padding_block_end: Padding bottom. (pb-0..pb-5) Defaults to `pb-0`.
 * - padding_inline_start: Padding start. (ps-0..ps-5) Defaults to `ps-0`.
 * - padding_inline_end: Padding end. (pe-0..pe-5) Defaults to `pe-0`.
 * - margin_block_start: Margin top. (mt-0..mt-5) Defaults to `mt-0`.
 * - margin_block_end: Margin bottom. (mb-0..mb-5) Defaults to `mb-0`.
 * - margin_inline_start: Margin start. (ms-0..ms-5) Defaults to `ms-0`.
 * - margin_inline_end: Margin end. (me-0..me-5) Defaults to `me-0`.
 * - shadow: Optional Bootstrap shadow. (none | shadow-sm | shadow | shadow-lg)
 *           Defaults to `none`.
 * - radius: Bootstrap border-radius utility class.
 *           (none | rounded | rounded-0 | rounded-1 | rounded-2 | rounded-3
 *            | rounded-4 | rounded-pill) Defaults to `none`.
 * - border: Bootstrap border utility, preset combination of sides.
 *           (none | border | border-top | border-bottom | border-start
 *            | border-end) Defaults to `none`.
 * - border_color: Bootstrap border color utility. Only applies when border
 *                 is set. (none | border-primary | border-primary-subtle
 *                 | border-secondary | border-secondary-subtle | border-success
 *                 | border-success-subtle | border-danger | border-danger-subtle
 *                 | border-warning | border-warning-subtle | border-info
 *                 | border-info-subtle | border-light | border-dark
 *                 | border-dark-subtle | border-black | border-white)
 *                 Defaults to `none`.
 * - border_width: Bootstrap border width utility. Only applies when border
 *                 is set. (none | border-1 | border-2 | border-3 | border-4
 *                 | border-5) Defaults to `none`.
 * - vertical_alignment: Vertical alignment for the row.
 *                       (align-items-start | align-items-center | align-items-end)
 *                       Defaults to `align-items-start`.
 * - horizontal_alignment: Text alignment applied to each column.
 *                         (text-start | text-center | text-end)
 *                         Defaults to `text-start`.
 * - section_header: (true|false) Show the header region. Defaults to `true`.
 * - section_footer: (true|false) Show the footer region. Defaults to `true`.
 * - aos_animation: Animate On Scroll effect for the section wrapper.
 *                  (none | fade | fade-up | fade-down | fade-left | fade-right
 *                   | fade-up-right | fade-up-left | fade-down-right
 *                   | fade-down-left | flip-up | flip-down | flip-left
 *                   | flip-right | slide-up | slide-down | slide-left
 *                   | slide-right | zoom-in | zoom-in-up | zoom-in-down
 *                   | zoom-in-left | zoom-in-right | zoom-out | zoom-out-up
 *                   | zoom-out-down | zoom-out-left | zoom-out-right)
 *                  Defaults to `none`.
 * - aos_duration: Animation duration in milliseconds.
 *                 (default | 400 | 600 | 800 | 1000 | 1200 | 1500 | 2000)
 *                 Defaults to `default`.
 * - aos_delay: Animation delay in milliseconds. (0 | 100 | 200 | 300 | 400
 *              | 500 | 600) Defaults to `0`.
 * - aos_once: (true|false) Whether the animation should happen only once.
 *             Defaults to `true`.
 *
 * Available attributes:
 * - attributes: Attributes array for the section element.
 * - content_attributes: HTML attributes for the content wrapper element.
 * - container_attributes: HTML attributes for the container element.
 * - inner_attributes: HTML attributes for the inner element.
 * - header_attributes: HTML attributes for the header element.
 * - row_attributes: HTML attributes for the row element.
 * - column_attributes: HTML attributes for each column element.
 * - footer_attributes: HTML attributes for the footer element.
 *
 * Available slots:
 * - header_slot: The header region content.
 * - col_1: Column 1 content.
 * - col_2: Column 2 content.
 * - col_3: Column 3 content.
 * - col_4: Column 4 content.
 * - col_5: Column 5 content.
 * - col_6: Column 6 content.
 * - footer_slot: The footer region content.
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: scalar props with schema defaults. #}
{% set container_type = container_type|default('none') %}
{% set background_color = background_color|default('none') %}
{% set text_color = text_color|default('auto') %}
{% set overlay_variant = background_overlay|default('none') %}
{% set columns = columns|default('50-50') %}
{% set gutter = gutter|default('gx-3 gy-3') %}
{% set padding_block_start = padding_block_start|default('pt-0') %}
{% set padding_block_end = padding_block_end|default('pb-0') %}
{% set padding_inline_start = padding_inline_start|default('ps-0') %}
{% set padding_inline_end = padding_inline_end|default('pe-0') %}
{% set margin_block_start = margin_block_start|default('mt-0') %}
{% set margin_block_end = margin_block_end|default('mb-0') %}
{% set margin_inline_start = margin_inline_start|default('ms-0') %}
{% set margin_inline_end = margin_inline_end|default('me-0') %}
{% set shadow = shadow|default('none') %}
{% set radius = radius|default('none') %}
{% set border = border|default('none') %}
{% set border_color = border_color|default('none') %}
{% set border_width = border_width|default('none') %}
{% set vertical_alignment = vertical_alignment|default('align-items-start') %}
{% set horizontal_alignment = horizontal_alignment|default('text-start') %}
{% set aos_animation = aos_animation|default('none') %}
{% set aos_duration = aos_duration|default('default') %}
{% set aos_delay = aos_delay|default('0') %}

{# Variables: boolean props.
 # SDC validates `type: boolean` props and applies their schema defaults,
 # so the values arrive as real booleans — only a presence fallback is
 # needed here, never type coercion.
 #}
{% set bg_edge2edge = bg_edge2edge ?? false %}
{% set section_header = section_header ?? false %}
{% set section_footer = section_footer ?? false %}
{% set aos_once = aos_once ?? true %}

{# Logic: background media and overlay. #}
{% set has_background_image = background_media is not empty and background_media.src is not empty %}
{% set has_overlay = has_background_image and overlay_variant != 'none' %}

{% set overlay_opacity_map = {
  'overlay-10': 'opacity-10',
  'overlay-25': 'opacity-25',
  'overlay-50': 'opacity-50',
  'overlay-75': 'opacity-75',
} %}
{% set overlay_opacity_classes = has_overlay ? [overlay_opacity_map[overlay_variant]|default('opacity-25')] : [] %}

{# Logic: text color. `auto` switches to white text on dark backgrounds. #}
{% set dark_backgrounds = ['bg-primary', 'bg-secondary', 'bg-success', 'bg-danger', 'bg-dark', 'bg-black'] %}
{% set auto_text_classes = background_color in dark_backgrounds ? ['text-white'] : [] %}
{% set text_classes = text_color == 'auto' ? auto_text_classes : (text_color != 'none' and text_color is not empty ? [text_color] : []) %}

{# Logic: optional utility classes, only when set. #}
{% set background_classes = background_color != 'none' ? [background_color] : [] %}
{% set shadow_classes = shadow != 'none' ? [shadow] : [] %}
{% set radius_classes = radius != 'none' ? [radius] : [] %}
{% set border_classes = border != 'none' ? [border] : [] %}
{% set border_color_classes = border_classes is not empty and border_color != 'none' ? [border_color] : [] %}
{% set border_width_classes = border_classes is not empty and border_width != 'none' ? [border_width] : [] %}
{% set edge2edge_classes = bg_edge2edge ? ['bg-edge2edge'] : [] %}
{% set media_position_classes = (has_background_image or has_overlay) ? ['position-relative', 'overflow-hidden'] : [] %}

{# Logic: merge all section-level classes as arrays. #}
{%
  set classes = [
    margin_block_start,
    margin_block_end,
    margin_inline_start,
    margin_inline_end,
    padding_block_start,
    padding_block_end,
    padding_inline_start,
    padding_inline_end,
  ]|merge(background_classes)|merge(text_classes)|merge(shadow_classes)|merge(radius_classes)|merge(border_classes)|merge(border_color_classes)|merge(border_width_classes)|merge(edge2edge_classes)|merge(media_position_classes)
%}

{# Logic: structural wrappers. #}
{% set container_classes = container_type != 'none' ? [container_type] : [] %}
{% set inner_classes = ['sdc-section__inner'] %}
{% set media_wrap_classes = ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100', 'z-0'] %}
{% set overlay_classes = ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100', 'bg-dark', 'z-1']|merge(overlay_opacity_classes) %}
{% set content_wrap_classes = ['position-relative', 'z-2'] %}
{% set header_classes = ['sdc-section__header', 'mb-4'] %}
{% set footer_classes = ['sdc-section__footer', 'mt-4'] %}

{# Logic: layout presets mapped to Bootstrap md column widths. #}
{% set preset_map = {
  '100': [12],
  '50-50': [6, 6],
  '33-33-33': [4, 4, 4],
  '75-25': [9, 3],
  '25-75': [3, 9],
  '67-33': [8, 4],
  '33-67': [4, 8],
  '50-25-25': [6, 3, 3],
  '25-25-50': [3, 3, 6],
  '25-25-25-25': [3, 3, 3, 3],
} %}

{% set cols_key = columns ~ '' %}
{% set is_five = cols_key == '20-20-20-20-20' %}
{% set is_six = cols_key == '16-16-16-16-16-16' %}
{% set md_widths = preset_map[cols_key]|default([12]) %}
{% set pattern_len = md_widths|length %}

{% set selected_count = pattern_len %}
{% if is_five %}
  {% set selected_count = 5 %}
{% elseif is_six %}
  {% set selected_count = 6 %}
{% endif %}

{# Logic: row classes, equal-width presets use row-cols utilities. #}
{% set row_classes = ['row', gutter, vertical_alignment] %}
{% if is_five %}
  {% set row_classes = row_classes|merge(['row-cols-1', 'row-cols-md-5']) %}
{% elseif is_six %}
  {% set row_classes = row_classes|merge(['row-cols-1', 'row-cols-md-6']) %}
{% endif %}

{# Slot content. #}
{% set col1 %}{% block col_1 %}{% endblock %}{% endset %}
{% set col2 %}{% block col_2 %}{% endblock %}{% endset %}
{% set col3 %}{% block col_3 %}{% endblock %}{% endset %}
{% set col4 %}{% block col_4 %}{% endblock %}{% endset %}
{% set col5 %}{% block col_5 %}{% endblock %}{% endset %}
{% set col6 %}{% block col_6 %}{% endblock %}{% endset %}
{% set cols = [col1, col2, col3, col4, col5, col6] %}

{# Header / footer content, only rendered when enabled and not empty. #}
{% set header_content %}{% block header_slot %}{% endblock %}{% endset %}
{% set footer_content %}{% block footer_slot %}{% endblock %}{% endset %}
{% set has_header = section_header and header_content|trim is not empty %}
{% set has_footer = section_footer and footer_content|trim is not empty %}

{# Logic: attributes. AOS data attributes and library are only added when
 # an animation is selected.
 #}
{% set attributes = attributes.addClass(classes) %}
{% if aos_animation != 'none' %}
  {{ attach_library('varbase_components/aos') }}
  {% set attributes = attributes
    .setAttribute('data-aos', aos_animation)
    .setAttribute('data-aos-duration', aos_duration != 'default' ? aos_duration : null)
    .setAttribute('data-aos-delay', aos_delay != '0' ? aos_delay : null)
    .setAttribute('data-aos-once', aos_once ? 'true' : 'false')
  %}
{% endif %}

{# Logic: per-region attributes objects for the structural wrappers. #}
{% if not content_attributes %}
  {% set content_attributes = create_attribute() %}
{% endif %}
{% set content_attributes = content_attributes.addClass(content_wrap_classes) %}

{% if not container_attributes %}
  {% set container_attributes = create_attribute() %}
{% endif %}
{% set container_attributes = container_attributes.addClass(container_classes) %}

{% if not inner_attributes %}
  {% set inner_attributes = create_attribute() %}
{% endif %}
{% set inner_attributes = inner_attributes.addClass(inner_classes) %}

{% if not header_attributes %}
  {% set header_attributes = create_attribute() %}
{% endif %}
{% set header_attributes = header_attributes.addClass(header_classes) %}

{% if not row_attributes %}
  {% set row_attributes = create_attribute() %}
{% endif %}
{% set row_attributes = row_attributes.addClass(row_classes) %}

{% if not footer_attributes %}
  {% set footer_attributes = create_attribute() %}
{% endif %}
{% set footer_attributes = footer_attributes.addClass(footer_classes) %}

{# Print the HTML. #}
<section {{ attributes }}>
  {% if has_background_image %}
    <div class="{{ media_wrap_classes|join(' ') }}" aria-hidden="true">
      {% include 'vartheme_bs5:image' ignore missing with {
        media: {
          src: background_media.src,
          alt: background_media.alt,
          width: background_media.width,
          height: background_media.height,
        },
        fit: 'object-fit-cover',
        width: 'w-100',
        height: 'h-100',
        rounded: 'rounded-0',
      } only %}
    </div>
  {% endif %}

  {% if has_overlay %}
    <div class="{{ overlay_classes|join(' ') }}" aria-hidden="true"></div>
  {% endif %}

  <div{{ content_attributes }}>
    <div{{ container_attributes }}>
      <div{{ inner_attributes }}>
        {% if has_header %}
          <header{{ header_attributes }}>
            {{ header_content }}
          </header>
        {% endif %}

        <div{{ row_attributes }}>
          {% for i in 0..(selected_count - 1) %}
            {% set content = cols[i] %}

            {% if content|trim is not empty %}
              {% if is_five or is_six %}
                {% set column_classes = ['col', horizontal_alignment] %}
              {% else %}
                {% set md_width = md_widths[i % pattern_len] %}
                {% set column_classes = ['col-12', 'col-md-' ~ md_width, horizontal_alignment] %}
              {% endif %}

              {% set column_attributes = create_attribute() %}
              {% set column_attributes = column_attributes.addClass(column_classes) %}

              <div{{ column_attributes }}>
                {{ content }}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if has_footer %}
          <footer{{ footer_attributes }}>
            {{ footer_content }}
          </footer>
        {% endif %}
      </div>
    </div>
  </div>
</section>
