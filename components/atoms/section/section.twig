{#
  Section-only multi-column (no custom CSS)

  Behavior:
  - ONLY render the selected number of columns based on the "columns" preset.
  - Extra slots (col_4..col_6) are skipped when layout is 1/2/3/4.
#}

{% set attributes = attributes|default(create_attribute()) %}

{# Base props #}
{% set bg_edge2edge = bg_edge2edge|default(false) %}
{% set container_type = container_type|default('none') %}
{% set gutter_class = gutter|default('gx-3 gy-3') %}
{% set background_color = background_color|default('none') %}
{% set text_color = text_color|default('auto') %}
{% set shadow = shadow|default('none') %}
{% set overlay_variant = background_overlay|default('none') %}

{% set mt = margin_block_start|default('mt-0') %}
{% set mb = margin_block_end|default('mb-0') %}
{% set pt = padding_block_start|default('pt-0') %}
{% set pb = padding_block_end|default('pb-0') %}

{# Background / overlay #}
{% set has_background_image = background_media is not empty and background_media.src is not empty %}
{% set has_overlay = has_background_image and overlay_variant != 'none' %}

{% set overlay_opacity_map = {
  'overlay-10': '0.10',
  'overlay-25': '0.25',
  'overlay-50': '0.50',
  'overlay-75': '0.75'
} %}
{% set overlay_style = has_overlay ? ('opacity: ' ~ (overlay_opacity_map[overlay_variant]|default('0.25')) ~ ';') : '' %}

{# Text / utility classes #}
{% set auto_text = background_color in ['bg-primary', 'bg-secondary', 'bg-dark'] ? 'text-white' : '' %}
{% set text_class = text_color == 'auto' ? auto_text : text_color %}
{% set shadow_class = shadow != 'none' ? shadow : '' %}

{# Section classes #}
{% set section_classes = [
  mt,
  mb,
  pt,
  pb,
  background_color != 'none' ? background_color : '',
  text_class,
  shadow_class,
  bg_edge2edge ? 'bg-edge2edge' : '',
  (has_background_image or has_overlay) ? 'position-relative overflow-hidden' : ''
] %}

{# Structural classes #}
{% set container_classes = container_type != 'none' ? [container_type] : [] %}
{% set inner_classes = ['sdc-section__inner'] %}
{% set media_wrap_classes = ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100', 'z-0'] %}
{% set overlay_classes = ['position-absolute', 'top-0', 'start-0', 'w-100', 'h-100', 'bg-dark', 'z-1'] %}
{% set content_wrap_classes = ['position-relative', 'z-2'] %}
{% set header_classes = ['sdc-section__header', 'mb-4'] %}
{% set footer_classes = ['sdc-section__footer', 'mt-4'] %}

{# Layout presets -> md widths #}
{% set preset_map = {
  '100': [12],
  '50-50': [6, 6],
  '33-33-33': [4, 4, 4],
  '75-25': [9, 3],
  '25-75': [3, 9],
  '67-33': [8, 4],
  '33-67': [4, 8],
  '50-25-25': [6, 3, 3],
  '25-25-50': [3, 3, 6],
  '25-25-25-25': [3, 3, 3, 3]
} %}

{% set cols_key = columns|default('50-50') %}
{% set is_five = cols_key == '20-20-20-20-20' %}
{% set is_six = cols_key == '16-16-16-16-16-16' %}
{% set md_widths = preset_map[cols_key]|default([12]) %}
{% set pattern_len = md_widths|length %}

{% set selected_count = 1 %}
{% if is_five %}
  {% set selected_count = 5 %}
{% elseif is_six %}
  {% set selected_count = 6 %}
{% else %}
  {% set selected_count = pattern_len %}
{% endif %}

{# Row classes #}
{% set row_classes = ['row', gutter_class] %}
{% if is_five %}
  {% set row_classes = row_classes|merge(['row-cols-1', 'row-cols-md-5']) %}
{% elseif is_six %}
  {% set row_classes = row_classes|merge(['row-cols-1', 'row-cols-md-6']) %}
{% endif %}

{# Slot content #}
{% set col1 %}{% block col_1 %}{% endblock %}{% endset %}
{% set col2 %}{% block col_2 %}{% endblock %}{% endset %}
{% set col3 %}{% block col_3 %}{% endblock %}{% endset %}
{% set col4 %}{% block col_4 %}{% endblock %}{% endset %}
{% set col5 %}{% block col_5 %}{% endblock %}{% endset %}
{% set col6 %}{% block col_6 %}{% endblock %}{% endset %}
{% set cols = [col1, col2, col3, col4, col5, col6] %}

{# Header / footer content #}
{% set header_content %}{% block header_slot %}{% endblock %}{% endset %}
{% set footer_content %}{% block footer_slot %}{% endblock %}{% endset %}
{% set has_header = section_header and header_content|trim is not empty %}
{% set has_footer = section_footer and footer_content|trim is not empty %}

<section {{ attributes.addClass(section_classes) }}>
  {% if has_background_image %}
    <div class="{{ media_wrap_classes|join(' ') }}" aria-hidden="true">
      {% include 'canvas:image' ignore missing with {
        src: background_media.src,
        alt: background_media.alt,
        class: 'w-100 h-100 object-fit-cover',
        width: background_media.width,
        height: background_media.height
      } only %}
    </div>
  {% endif %}

  {% if has_overlay %}
    <div class="{{ overlay_classes|join(' ') }}" aria-hidden="true" style="{{ overlay_style }}"></div>
  {% endif %}

  <div class="{{ content_wrap_classes|join(' ') }}">
    <div class="{{ container_classes|join(' ') }}">
      <div class="{{ inner_classes|join(' ') }}">
        {% if has_header %}
          <header class="{{ header_classes|join(' ') }}">
            {{ header_content }}
          </header>
        {% endif %}

        <div class="{{ row_classes|join(' ') }}">
          {% for i in 0..(selected_count - 1) %}
            {% set content = cols[i] %}

            {% if content|trim is not empty %}
              {% if is_five or is_six %}
                {% set column_classes = ['col'] %}
              {% else %}
                {% set md = md_widths[i % pattern_len] %}
                {% set column_classes = ['col-12', 'col-md-' ~ md] %}
              {% endif %}

              <div class="{{ column_classes|join(' ') }}">
                {{ content }}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {% if has_footer %}
          <footer class="{{ footer_classes|join(' ') }}">
            {{ footer_content }}
          </footer>
        {% endif %}
      </div>
    </div>
  </div>
</section>