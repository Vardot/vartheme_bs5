{#
  Image component
  - Optional ratio crop via Bootstrap .ratio + .ratio-*
  - Bootstrap utility classes only
#}

{% set media_ok = media is defined and media and media.src is defined and media.src is not empty %}

{% set link_url = link_url|default('')|trim %}
{% set has_link = link_url is not empty and link_url != 'No URL' %}

{% set target_value = target|default('self') %}
{% set target_attr = target_value == 'blank' ? '_blank' : '_self' %}
{% set rel_attr = target_value == 'blank' ? 'noopener noreferrer' : null %}

{# Link attributes for vartheme_bs5:link #}
{% set link_attrs_ratio = create_attribute().addClass(['d-block', 'w-100', 'h-100']) %}
{% set link_attrs_inline = create_attribute().addClass(['d-inline-block']) %}
{% if target_attr %}
  {% set link_attrs_ratio = link_attrs_ratio.setAttribute('target', target_attr) %}
  {% set link_attrs_inline = link_attrs_inline.setAttribute('target', target_attr) %}
{% endif %}
{% if rel_attr %}
  {% set link_attrs_ratio = link_attrs_ratio.setAttribute('rel', rel_attr) %}
  {% set link_attrs_inline = link_attrs_inline.setAttribute('rel', rel_attr) %}
{% endif %}

{# Ratio: use a special value for "no crop" (ratio-auto) #}
{% set ratio_value = ratio|default('ratio-auto') %}
{% set has_ratio = ratio_value != 'ratio-auto' %}
{% set ratio_wrapper_class = has_ratio ? ('ratio ' ~ ratio_value) : '' %}

{# Fit: Bootstrap object-fit utilities #}
{% set fit_class = fit|default('object-fit-cover') %}

{# Alignment + width: Bootstrap utilities (values are the class names) #}
{% set align_class = align|default('me-auto') %}
{% set width_class = width|default('w-auto') %}

{# Rounded: Bootstrap utilities (values are the class names) #}
{% set rounded_class = rounded|default('none') != 'none' ? rounded : '' %}

{% set loading_value = loading|default('lazy') %}

{# Figure wrapper classes #}
{% set figure_classes = (['d-block', 'm-0', width_class, align_class])|filter(v => v is not empty) %}
{% set figure_attrs = create_attribute().addClass(figure_classes) %}

{# Image classes — w-100 always; h-100 only inside a ratio box #}
{% set img_classes = (['img-fluid', fit_class, rounded_class]|filter(v => v is not empty)) %}
{% set img_classes_final = ['w-100']|merge(has_ratio ? ['h-100'] : [])|merge(img_classes) %}
{% set img_class_final = img_classes_final|join(' ') %}

{# Pick link attributes based on ratio mode #}
{% set link_attrs = has_ratio ? link_attrs_ratio : link_attrs_inline %}

{# Build the inner markup (no logic in <figure>) #}
{% set figure_content %}{% endset %}
{% if media_ok %}
  {# Resolve a plain source URL. SVG must bypass drimage/responsive styles
     (image-style derivatives + WebP conversion do not apply to SVG → 404). #}
  {% set plain_src = '' %}
  {% if media.src is iterable %}
    {% set plain_src = media.src.url|default(media.src.uri|default(media.src.value|default(''))) %}
  {% else %}
    {% set plain_src = media.src %}
  {% endif %}
  {% set plain_src = plain_src ?: media.url|default('') %}
  {% set is_svg = plain_src|lower|split('?')|first|split('#')|first ends with '.svg' %}
  {# Drop the ?alternateWidths= / itok query so the SVG is served directly (no WebP derivative). #}
  {% if is_svg %}{% set plain_src = plain_src|split('?')|first %}{% endif %}
  {% set has_canvas_drimage = media.data is defined and media.data and media.data is iterable %}
  {% set drimage_data = (is_svg ? false : (has_canvas_drimage ? media.data : varbase_media_drimage(media.src))) %}
  {% if not has_canvas_drimage and has_ratio and drimage_data %}
    {% set ratio_parts = ratio_value|replace({'ratio-': ''})|split('x') %}
    {% set drimage_data = drimage_data|merge({image_handling: 'aspect_ratio', aspect_ratio: {width: ratio_parts[0] * 1, height: ratio_parts[1] * 1}}) %}
  {% endif %}
  {% set drimage_img_classes = ['w-100']|merge(has_ratio ? ['h-100'] : ['img-fluid'])|merge([fit_class, rounded_class]) %}
  {% if drimage_data %}
    {# Render via vartheme_bs5:dynamic-responsive-image (drimage_improved). #}
    {% set image_markup %}
      {{ include('vartheme_bs5:dynamic-responsive-image', {
        url: media.url|default(''),
        width: '' ~ (media.width ?? drimage_data.original_width ?? ''),
        height: '' ~ (media.height ?? drimage_data.original_height ?? ''),
        alt: media.alt|default(''),
        data: drimage_data,
        dynamic_responsive_image_utility_classes: img_classes_final|merge(['drimage']),
        picture_img_attributes: create_attribute().addClass(drimage_img_classes),
      }, with_context=false) }}
    {% endset %}
  {% else %}
    {# Native <img> fallback — SVG (drimage bypassed) or while drimage data is not provided.
       SVG keeps its intrinsic size (no w-100/h-100) so icons render at their natural
       dimensions instead of stretching to the container width. #}
    {% set svg_img_class = (['img-fluid', rounded_class]|filter(v => v is not empty))|join(' ') %}
    {% set image_markup %}
      <img
        src="{{ is_svg ? plain_src : media.src }}"
        alt="{{ media.alt|default('')|e }}"
        {% if media.width is not empty %}width="{{ media.width }}"{% endif %}
        {% if media.height is not empty %}height="{{ media.height }}"{% endif %}
        class="{{ is_svg ? svg_img_class : img_class_final }}"
        loading="{{ loading_value }}"
      >
    {% endset %}
  {% endif %}

  {# Build the optional link wrapper once #}
  {% set linked_markup %}
    {% if has_link %}
      {{ include('vartheme_bs5:link', {
        url: link_url,
        attributes: link_attrs,
        content: image_markup,
      }, false, true) }}
    {% else %}
      {{ image_markup }}
    {% endif %}
  {% endset %}

  {% set figure_content %}
    {% if has_ratio %}
      <div class="{{ ratio_wrapper_class }}">
        {{ linked_markup }}
      </div>
    {% else %}
      {{ linked_markup }}
    {% endif %}
  {% endset %}
{% endif %}

<figure{{ figure_attrs }}>
  {{ figure_content }}
</figure>
