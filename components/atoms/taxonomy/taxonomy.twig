{# Taxonomy component (SDC + Canvas, Bootstrap utilities only) #}

{% set has_url = url is defined and url is not empty %}

{# Map size prop to Bootstrap font-size utilities #}
{% set size_class = size == 'taxonomy-sm' ? '' : 'fs-6' %}

{# Base visual styling — pure Bootstrap utilities, no custom CSS #}
{% set base_classes = [
  'taxonomy',
  'badge',
  'd-inline-flex',
  'align-items-center',
  'justify-content-center',
  'text-nowrap',
  'fw-bold',
  'text-uppercase',
  'rounded-1',
  'bg-dark',
  'text-accent',
  'border',
  'border-accent',
  size_class,
] %}

{% set classes = base_classes|filter(v => v is not empty)|join(' ') %}

{% if has_url %}
  <a
    href="{{ url|e }}"
    class="{{ classes }} text-decoration-none"
    {% if target is defined and target == '_blank' %}
      target="_blank" rel="noopener noreferrer"
    {% endif %}
  >
    {{ label|e }}
  </a>
{% else %}
  <span class="{{ classes }}">
    {{ label|e }}
  </span>
{% endif %}
