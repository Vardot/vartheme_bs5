{#
  Bootstrap 5 Logo Card (SDC)

  Improvements:
  - New nice placeholder (assets/logo-placeholder.svg)
  - Prevents very big/tall logos using ratio wrapper + object-fit: contain
  - Target support + secure rel
  - User-friendly options (padding presets, size presets, readable selects)
  - Optional grayscale logo style (Bootstrap filter utility)
#}

{% set has_url = url is defined and url is not empty and url != 'No URL' %}
{% set target_value = target|default('self') %}
{% set target_attr = target_value == 'blank' ? '_blank' : '_self' %}
{% set rel_attr = target_value == 'blank' ? 'noopener noreferrer' : null %}

{% set aria = aria_label|default('')|trim %}
{% if aria == '' %}
  {% set aria = media.alt|default('Open') %}
{% endif %}

{% set shadow_map = { 'none':'', 'sm':'shadow-sm', 'default':'shadow', 'lg':'shadow-lg' } %}

{% set border_value = border|default('default') %}
{% set border_class = '' %}
{% if border_value == 'none' %}
  {% set border_class = 'border-0' %}
{% elseif border_value == 'default' %}
  {% set border_class = '' %}
{% else %}
  {% set border_class = 'border border-' ~ border_value %}
{% endif %}

{% set rounded_value = border_radius|default('default') %}
{% set rounded_map = {
  'default': '',
  '0': 'rounded-0',
  '1': 'rounded-1',
  '2': 'rounded-2',
  '3': 'rounded-3',
  'pill': 'rounded-pill'
} %}

{% set bg_value = background_color|default('default') %}
{% set bg_map = {
  'default': 'bg-body',
  'light': 'bg-light',
  'dark': 'bg-dark text-white',
  'primary': 'bg-primary text-white',
  'secondary': 'bg-secondary text-white',
  'success': 'bg-success text-white',
  'danger': 'bg-danger text-white',
  'warning': 'bg-warning',
  'info': 'bg-info'
} %}

{% set padding_value = padding|default('normal') %}
{% set padding_map = {
  'compact': 'p-3',
  'normal': 'p-3 p-md-4',
  'spacious': 'p-4 p-lg-5'
} %}

{% set tile_ratio = tile_ratio|default('square') %}
{% set ratio_map = { 'square':'ratio-1x1', '4x3':'ratio-4x3', '16x9':'ratio-16x9' } %}
{% set ratio_class = ratio_map[tile_ratio]|default('') %}

{% set logo_size = logo_size|default('md') %}
{% set logo_size_map = {
  'sm': 'w-50',
  'md': 'w-75',
  'lg': 'w-100'
} %}

{% set logo_style = logo_style|default('default') %}
{% set logo_filter_class = logo_style == 'grayscale' ? 'filter-grayscale' : '' %}

{# Card classes #}
{% set classes = ['card','h-100','overflow-hidden'] %}
{% set classes = classes|merge([bg_map[bg_value]|default('bg-body')]) %}
{% if shadow_map[shadow|default('default')]|default('') %}
  {% set classes = classes|merge([shadow_map[shadow|default('default')]]) %}
{% endif %}
{% if border_class %}
  {% set classes = classes|merge([border_class]) %}
{% endif %}
{% if rounded_map[rounded_value]|default('') %}
  {% set classes = classes|merge([rounded_map[rounded_value]]) %}
{% endif %}
{% if has_url %}
  {% set classes = classes|merge(['position-relative']) %}
{% endif %}
{% if extra_classes is defined and extra_classes|trim %}
  {% set classes = classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

{% set attrs = create_attribute().addClass(classes) %}
{% if id is defined and id|trim %}
  {% set attrs = attrs.setAttribute('id', id|trim) %}
{% endif %}

{# Image classes: contain + centered #}
{% set img_classes = [
  'img-fluid',
  'object-fit-contain',
  'd-block',
  'mx-auto',
  logo_size_map[logo_size]|default('w-75'),
  logo_filter_class
]|filter(v => v)|join(' ') %}

{% set src_value = '' %}
{% if media is defined and media %}
  {# Drupal Canvas media uploads can provide src as a string OR as an object/array (e.g. {url: ...}). #}
  {% if media.src is defined and media.src %}
    {% if media.src is iterable %}
      {% set src_value = media.src.url|default(media.src.uri|default(media.src.value|default(''))) %}
    {% else %}
      {% set src_value = media.src %}
    {% endif %}
  {% elseif media.url is defined and media.url %}
    {% set src_value = media.url %}
  {% endif %}
{% endif %}

{% set media_ok = src_value is not empty %}


<div{{ attrs }}>
  {% if ratio_class %}
    <div class="ratio {{ ratio_class }}">
      <div class="d-flex align-items-center justify-content-center {{ padding_map[padding_value]|default('p-3 p-md-4') }}">
        {% if has_url %}
          <a
            href="{{ url|e }}"
            class="stretched-link text-decoration-none"
            aria-label="{{ aria|e }}"
            target="{{ target_attr }}"
            {% if rel_attr %}rel="{{ rel_attr }}"{% endif %}
          ></a>
        {% endif %}

        {% if media_ok %}
          {% include 'canvas:image' ignore missing with {
            src: src_value,
            alt: media.alt,
            width: media.width,
            height: media.height,
            class: img_classes
          } only %}
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="card-body d-flex align-items-center justify-content-center {{ padding_map[padding_value]|default('p-3 p-md-4') }}">
      {% if has_url %}
        <a
          href="{{ url|e }}"
          class="stretched-link text-decoration-none"
          aria-label="{{ aria|e }}"
          target="{{ target_attr }}"
          {% if rel_attr %}rel="{{ rel_attr }}"{% endif %}
        ></a>
      {% endif %}

      {% if media_ok %}
        {% include 'canvas:image' ignore missing with {
          src: src_value,
          alt: media.alt,
          width: media.width,
          height: media.height,
          class: img_classes
        } only %}
      {% endif %}
    </div>
  {% endif %}
</div>
