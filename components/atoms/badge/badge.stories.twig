{% stories Badge with {
  title: 'Base/Badge',
  parameters: {
    componentSubtitle: 'Bootstrap Badge component',
    docs: {
      description: {
        component: 'Badges scale to match the size of the immediate parent element and can include optional links, icons, and indicators.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    label: {
      name: 'Label',
      description: 'Text shown inside the badge.',
      defaultValue: 'Badge',
      control: 'text',
    },
    url: {
      name: 'Link (optional)',
      description: 'If provided, badge will render as a link.',
      defaultValue: '',
      control: 'text',
    },
    variant: {
      name: 'Variant',
      description: 'Bootstrap contextual color utility for badges.',
      defaultValue: 'text-bg-primary',
      control: 'select',
      options: {
        Primary: 'text-bg-primary',
        Secondary: 'text-bg-secondary',
        Success: 'text-bg-success',
        Danger: 'text-bg-danger',
        Warning: 'text-bg-warning',
        Info: 'text-bg-info',
        Light: 'text-bg-light',
        Dark: 'text-bg-dark',
      },
    },
    size: {
      name: 'Size',
      description: 'Bootstrap utility classes for sizing (font-size + padding).',
      defaultValue: 'fs-6 px-3 py-2',
      control: 'select',
      options: {
        Small: 'fs-6 px-2 py-1',
        "'Medium (default)'": 'fs-6 px-3 py-2',
        Large: 'fs-5 px-3 py-2',
      },
    },
    radius: {
      name: 'Border radius',
      description: 'Bootstrap border-radius utility class.',
      defaultValue: 'rounded-1',
      control: 'select',
      options: {
        "'Rounded (default)'": 'rounded-1',
        "'Rounded pill'": 'rounded-pill',
      },
    },
    icon: {
      name: 'Icon (optional)',
      description: 'Bootstrap Icon name from the shared icon component list. Use Custom icon name to override.',
      defaultValue: 'none',
      control: 'select',
      options: {
        None: 'none',
        Check: 'check',
        Info: 'info',
        Search: 'search',
        Person: 'person',
        People: 'people',
        "'Arrow right'": 'arrow-right',
        "'Chevron right'": 'chevron-right',
      },
    },
    icon_first: {
      name: 'Icon position',
      description: 'If enabled, icon shows before the label. If disabled, icon shows after.',
      defaultValue: true,
      control: 'boolean',
    },
    indicator: {
      name: 'Notification indicator',
      description: 'Show a dot or a count bubble on the badge.',
      defaultValue: 'none',
      control: 'select',
      options: {
        None: 'none',
        Dot: 'dot',
        Count: 'count',
      },
    },
    indicator_text: {
      name: 'Indicator count text',
      description: 'Text shown in count bubble (e.g. 1, 9, 99+). Used only when indicator=count.',
      defaultValue: '99+',
      control: 'text',
    },
  },
} %}

{% story BadgeDefault with {
  name: 'Default',
  args: {
    label: 'Badge',
    url: '',
    variant: 'text-bg-primary',
    size: 'fs-6 px-3 py-2',
    radius: 'rounded-1',
    icon: 'none',
    icon_first: true,
    indicator: 'none',
    indicator_text: '99+',
  },
} %}
  {{ include('vartheme_bs5:badge') }}
{% endstory %}

