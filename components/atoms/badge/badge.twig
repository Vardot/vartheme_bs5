{# Badge component (Bootstrap 5 / VarTheme) #}

{# Normalize extra classes (string or array) #}
{% set additional_classes = badge_classes|default('') %}
{% if additional_classes is iterable %}
  {% set additional_classes = additional_classes|join(' ') %}
{% endif %}

{% set has_url = url is defined and url is not empty and url != 'No URL' %}

{# Normalize + validate style #}
{% set variant = style|default('primary') %}
{% set allowed = ['primary','secondary','success','danger','warning','info','light','dark'] %}
{% if variant not in allowed %}
  {% set variant = 'primary' %}
{% endif %}

{# Normalize icon_first safely (supports boolean false, "false", 0, etc.) #}
{% set is_icon_first = icon_first|default(true) %}
{% if icon_first is defined and icon_first is same as(false) %}
  {% set is_icon_first = false %}
{% else %}
  {% set v = (is_icon_first ~ '')|lower|trim %}
  {% if v in ['false','0','off','no'] %}
    {% set is_icon_first = false %}
  {% else %}
    {% set is_icon_first = true %}
  {% endif %}
{% endif %}

{# Border radius mapping (Bootstrap utilities) #}
{% set radius = radius|default('default') %}
{% set radius_class = '' %}
{% if radius == 'sm' %}
  {% set radius_class = 'rounded-1' %}
{% elseif radius == 'lg' %}
  {% set radius_class = 'rounded-3' %}
{% elseif radius == 'pill' %}
  {% set radius_class = 'rounded-pill' %}
{% elseif radius == 'none' %}
  {% set radius_class = 'rounded-0' %}
{% endif %}

{# Base Bootstrap badge classes #}
{% set base_classes = [
  'badge',
  'text-bg-' ~ variant,
  radius_class,
  'text-decoration-none',
  'd-inline-flex',
  'align-items-center',
  'gap-1',
  'px-2',
  'py-1'
] %}

{# Flip order when icon_first is false #}
{% if not is_icon_first %}
  {% set base_classes = base_classes|merge(['flex-row-reverse']) %}
{% endif %}

{% set class_attr = (base_classes|join(' ') ~ ' ' ~ additional_classes)|trim %}

{% if has_url %}
  <a href="{{ url|e }}" class="{{ class_attr }}" aria-label="{{ label|e }}">
{% else %}
  <span class="{{ class_attr }}" aria-label="{{ label|e }}">
{% endif %}

  {% if icon is defined and icon is not empty %}
    {{
      include(
        '@vartheme_bs5/components/atoms/icon/icon.twig',
        { icon: icon, icon_size: 'extra-small' },
        with_context: false
      )
    }}
  {% endif %}
  <span class="lh-1">{{ label }}</span>

{% if has_url %}
  </a>
{% else %}
  </span>
{% endif %}
