{# Badge component (Bootstrap 5 / VarTheme) #}

{% set has_url = url is defined and url is not empty and url != 'No URL' %}

{# -----------------------------
   Variant (Bootstrap utility)
   ----------------------------- #}
{% set variant = variant|default('text-bg-primary') %}
{% set variant_allowed = [
  'text-bg-primary',
  'text-bg-secondary',
  'text-bg-success',
  'text-bg-danger',
  'text-bg-warning',
  'text-bg-info',
  'text-bg-light',
  'text-bg-dark'
] %}
{% if variant not in variant_allowed %}
  {% set variant = 'text-bg-primary' %}
{% endif %}

{# -----------------------------
   Size (Bootstrap utilities)
   ----------------------------- #}
{% set size = size|default('fs-6 px-3 py-2') %}
{% set size_allowed = [
  'fs-6 px-2 py-1',
  'fs-6 px-3 py-2',
  'fs-5 px-3 py-2'
] %}
{% if size not in size_allowed %}
  {% set size = 'fs-6 px-3 py-2' %}
{% endif %}

{# Keep component SCSS size modifiers (internal only) #}
{% set size_modifier = 'badge-medium' %}
{% if size == 'fs-6 px-2 py-1' %}
  {% set size_modifier = 'badge-small' %}
{% elseif size == 'fs-5 px-3 py-2' %}
  {% set size_modifier = 'badge-large' %}
{% endif %}

{# Icon sizing (kept Bootstrap/VarTheme friendly) #}
{% set icon_size = 'extra-small' %}
{% if size_modifier == 'badge-large' %}
  {% set icon_size = 'small' %}
{% endif %}

{# -----------------------------
   Border radius (Bootstrap utility)
   ----------------------------- #}
{% set radius = radius|default('rounded-1') %}
{% set radius_allowed = ['rounded-1','rounded-pill'] %}
{% if radius not in radius_allowed %}
  {% set radius = 'rounded-1' %}
{% endif %}

{# -----------------------------
   Icon options
   ----------------------------- #}
{% set icon_value = icon|default('none') %}
{% set show_icon = (icon_value is not empty and icon_value != 'none') %}

{# Normalize icon_first safely #}
{% set is_icon_first = icon_first|default(true) %}
{% if icon_first is defined and icon_first is same as(false) %}
  {% set is_icon_first = false %}
{% else %}
  {% set v = (is_icon_first ~ '')|lower|trim %}
  {% if v in ['false','0','off','no'] %}
    {% set is_icon_first = false %}
  {% else %}
    {% set is_icon_first = true %}
  {% endif %}
{% endif %}

{# -----------------------------
   Notification indicator logic
   ----------------------------- #}
{% set indicator = indicator|default('none') %}
{% set indicator_allowed = ['none','dot','count'] %}
{% if indicator not in indicator_allowed %}
  {% set indicator = 'none' %}
{% endif %}

{% set indicator_text = indicator_text|default('99+')|trim %}
{% if indicator_text is empty %}
  {% set indicator_text = '99+' %}
{% endif %}

{% set has_indicator = (indicator == 'dot' or indicator == 'count') %}

{# Base classes #}
{% set base_classes = [
  'badge',
  variant,
  radius,
  size,
  size_modifier,
  'text-decoration-none',
  'd-inline-flex',
  'align-items-center',
  'text-nowrap',
  'lh-1',
  'me-3',
  'align-middle'
] %}

{# Add position-relative only when indicator enabled #}
{% if has_indicator %}
  {% set base_classes = base_classes|merge(['position-relative']) %}
{% endif %}

{% set merged_classes = base_classes|join(' ')|trim %}
{% set merged_classes = merged_classes|replace({'  ':' '}) %}

{% if has_url %}
  <a href="{{ url|e }}" class="{{ merged_classes }}" aria-label="{{ label|e }}">
{% else %}
  <span class="{{ merged_classes }}" aria-label="{{ label|e }}">
{% endif %}

  {% if show_icon and is_icon_first %}
    <span class="d-inline-flex align-items-center flex-shrink-0">
      {{
        include(
          '@vartheme_bs5/components/atoms/icon/icon.twig',
          { icon: icon_value, icon_size: icon_size, weight: 'bold' },
          with_context: false
        )
      }}
    </span>
    <span class="ms-1">{{ label }}</span>
  {% elseif show_icon and not is_icon_first %}
    <span>{{ label }}</span>
    <span class="ms-1 d-inline-flex align-items-center flex-shrink-0">
      {{
        include(
          '@vartheme_bs5/components/atoms/icon/icon.twig',
          { icon: icon_value, icon_size: icon_size, weight: 'bold' },
          with_context: false
        )
      }}
    </span>
  {% else %}
    <span>{{ label }}</span>
  {% endif %}

  {# Indicator (Bootstrap-only) #}
  {% if has_indicator %}
    {% if indicator == 'count' %}
      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger badge__count">
        {{ indicator_text }}
      </span>
    {% elseif indicator == 'dot' %}
      <span class="position-absolute top-0 start-100 translate-middle bg-danger border border-light rounded-circle badge__dot"></span>
    {% endif %}
  {% endif %}

{% if has_url %}
  </a>
{% else %}
  </span>
{% endif %}
