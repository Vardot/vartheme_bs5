{# Badge component (Bootstrap 5 / VarTheme) #}

{# URL #}
{% set has_url = url is defined and url is not empty and url != 'No URL' %}
{% set root_tag = has_url ? 'a' : 'span' %}

{# Variant #}
{% set variant = variant|default('text-bg-primary') %}
{% set variant_allowed = [
  'text-bg-primary',
  'text-bg-secondary',
  'text-bg-success',
  'text-bg-danger',
  'text-bg-warning',
  'text-bg-info',
  'text-bg-light',
  'text-bg-dark',
] %}
{% if variant not in variant_allowed %}
  {% set variant = 'text-bg-primary' %}
{% endif %}

{# Size #}
{% set size = size|default('fs-6 px-3 py-2') %}
{% set size_allowed = [
  'fs-6 px-2 py-1',
  'fs-6 px-3 py-2',
  'fs-5 px-3 py-2',
] %}
{% if size not in size_allowed %}
  {% set size = 'fs-6 px-3 py-2' %}
{% endif %}

{# Keep component SCSS size modifiers (internal only) #}
{% set size_modifier = 'badge-medium' %}
{% if size == 'fs-6 px-2 py-1' %}
  {% set size_modifier = 'badge-small' %}
{% elseif size == 'fs-5 px-3 py-2' %}
  {% set size_modifier = 'badge-large' %}
{% endif %}

{# Radius #}
{% set radius = radius|default('rounded-1') %}
{% set radius_allowed = ['rounded-1', 'rounded-pill'] %}
{% if radius not in radius_allowed %}
  {% set radius = 'rounded-1' %}
{% endif %}

{# Icon #}
{% set icon_value = icon|default('')|trim %}
{% set has_icon = icon_value is not empty and icon_value != 'none' %}

{# Normalize icon_first safely #}
{% set is_icon_first = icon_first|default(true) %}
{% if icon_first is defined and icon_first is same as(false) %}
  {% set is_icon_first = false %}
{% else %}
  {% set icon_first_value = (is_icon_first ~ '')|lower|trim %}
  {% if icon_first_value in ['false', '0', 'off', 'no'] %}
    {% set is_icon_first = false %}
  {% else %}
    {% set is_icon_first = true %}
  {% endif %}
{% endif %}

{# Indicator #}
{% set indicator = indicator|default('none') %}
{% set indicator_allowed = ['none', 'dot', 'count'] %}
{% if indicator not in indicator_allowed %}
  {% set indicator = 'none' %}
{% endif %}

{% set indicator_text = indicator_text|default('99+')|trim %}
{% if indicator_text is empty %}
  {% set indicator_text = '99+' %}
{% endif %}

{% set has_indicator = indicator in ['dot', 'count'] %}

{# Class lists #}
{% set root_classes = [
  'badge',
  variant,
  radius,
  size,
  size_modifier,
  'text-decoration-none',
  'd-inline-flex',
  'align-items-center',
  'text-nowrap',
  'lh-1',
  'me-3',
  'align-middle',
] %}
{% if has_indicator %}
  {% set root_classes = root_classes|merge(['position-relative']) %}
{% endif %}

{% set icon_wrapper_classes = ['d-inline-flex', 'align-items-center', 'flex-shrink-0'] %}
{% set icon_after_wrapper_classes = icon_wrapper_classes|merge(['ms-1']) %}
{% set label_after_icon_classes = ['ms-1'] %}
{% set count_indicator_classes = [
  'position-absolute',
  'top-0',
  'start-100',
  'translate-middle',
  'badge',
  'rounded-pill',
  'text-bg-danger',
  'badge__count',
] %}
{% set dot_indicator_classes = [
  'position-absolute',
  'top-0',
  'start-100',
  'translate-middle',
  'bg-danger',
  'border',
  'border-light',
  'rounded-circle',
  'badge__dot',
] %}

{# Attributes #}
{% set root_attributes = create_attribute()
  .addClass(root_classes)
  .setAttribute('aria-label', label|default('')|e) %}
{% if has_url %}
  {% set root_attributes = root_attributes.setAttribute('href', url|e) %}
{% endif %}

{% set icon_wrapper_attributes = create_attribute().addClass(icon_wrapper_classes) %}
{% set icon_after_wrapper_attributes = create_attribute().addClass(icon_after_wrapper_classes) %}
{% set label_after_icon_attributes = create_attribute().addClass(label_after_icon_classes) %}
{% set count_indicator_attributes = create_attribute().addClass(count_indicator_classes) %}
{% set dot_indicator_attributes = create_attribute().addClass(dot_indicator_classes) %}

<{{ root_tag }}{{ root_attributes }}>
  {% if has_icon and is_icon_first %}
    <span{{ icon_wrapper_attributes }}>
      {{ include('vartheme_bs5:icon', {icon: icon_value}, with_context: false) }}
    </span>
    <span{{ label_after_icon_attributes }}>{{ label }}</span>
  {% elseif has_icon and not is_icon_first %}
    <span>{{ label }}</span>
    <span{{ icon_after_wrapper_attributes }}>
      {{ include('vartheme_bs5:icon', {icon: icon_value}, with_context: false) }}
    </span>
  {% else %}
    <span>{{ label }}</span>
  {% endif %}

  {% if has_indicator %}
    {% if indicator == 'count' %}
      <span{{ count_indicator_attributes }}>{{ indicator_text }}</span>
    {% elseif indicator == 'dot' %}
      <span{{ dot_indicator_attributes }}></span>
    {% endif %}
  {% endif %}
</{{ root_tag }}>
