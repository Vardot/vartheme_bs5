{#
  Row (Bootstrap)
  - Outputs a .row with gx/gy gutters (more predictable spacing)
  - Optional container wrapper
  - Optional responsive row-cols utilities
#}

{% set attributes = attributes|default(create_attribute()) %}

{% set container_type = container_type|default('none') %}
{% set gutter = gutter|default('3') %}
{% set columns_mobile = columns_mobile|default('none') %}
{% set columns_desktop = columns_desktop|default('none') %}
{% set align_items = align_items|default('none') %}
{% set justify_content = justify_content|default('none') %}

{% set html_id = html_id|default('') %}
{% set extra_classes = extra_classes|default('') %}

{% set row_classes = [
  'sdc-row',
  'row',
  'gx-' ~ gutter,
  'gy-' ~ gutter
] %}

{# row-cols (optional) #}
{% if columns_mobile != 'none' %}
  {% set row_classes = row_classes|merge(['row-cols-' ~ columns_mobile]) %}
{% endif %}
{% if columns_desktop != 'none' %}
  {% set row_classes = row_classes|merge(['row-cols-md-' ~ columns_desktop]) %}
{% endif %}

{% if align_items != 'none' %}
  {% set row_classes = row_classes|merge([align_items]) %}
{% endif %}
{% if justify_content != 'none' %}
  {% set row_classes = row_classes|merge([justify_content]) %}
{% endif %}

{% if extra_classes|trim %}
  {% set row_classes = row_classes|merge(extra_classes|trim|split(' ')) %}
{% endif %}

{% if html_id|trim %}
  {% set attributes = attributes.setAttribute('id', html_id|trim) %}
{% endif %}

{% set block_content %}{% block content %}{% endblock %}{% endset %}

{% if container_type != 'none' %}
  <div class="{{ container_type }}">
    <div {{ attributes.addClass(row_classes) }}>
      {{ block_content }}
    </div>
  </div>
{% else %}
  <div {{ attributes.addClass(row_classes) }}>
    {{ block_content }}
  </div>
{% endif %}
