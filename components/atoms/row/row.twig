{#
  Row (Bootstrap)
  - Outputs a .row with gutter utilities
  - Optional container wrapper
  - Optional responsive row-cols utilities
  - Optional background color, background image, overlay, and spacing utilities
#}

{% set attributes = attributes|default(create_attribute()) %}

{% set container_type = container_type|default('container') %}
{% set gutter = gutter|default('3') %}
{% set columns_mobile = columns_mobile|default('none') %}
{% set columns_desktop = columns_desktop|default('none') %}
{% set align_items = align_items|default('none') %}
{% set justify_content = justify_content|default('none') %}
{% set background_color = background_color|default('none') %}
{% set bg_edge2edge = bg_edge2edge|default(false) %}
{% set background_image = background_image|default('') %}
{% set overlay_color = overlay_color|default('dark') %}
{% set overlay_opacity = overlay_opacity|default(50) %}
{% set padding_block_start = padding_block_start|default('pt-0') %}
{% set padding_block_end = padding_block_end|default('pb-0') %}
{% set margin_block_start = margin_block_start|default('mt-0') %}
{% set margin_block_end = margin_block_end|default('mb-0') %}

{% set row_classes = [
  'row',
  'g-' ~ gutter,
] %}

{% if columns_mobile != 'none' %}
  {% set row_classes = row_classes|merge(['row-cols-' ~ columns_mobile]) %}
{% endif %}
{% if columns_desktop != 'none' %}
  {% set row_classes = row_classes|merge(['row-cols-md-' ~ columns_desktop]) %}
{% endif %}
{% if align_items != 'none' %}
  {% set row_classes = row_classes|merge([align_items]) %}
{% endif %}
{% if justify_content != 'none' %}
  {% set row_classes = row_classes|merge([justify_content]) %}
{% endif %}

{% set wrapper_classes = [
  padding_block_start,
  padding_block_end,
  margin_block_start,
  margin_block_end,
] %}

{% if background_color != 'none' %}
  {% set wrapper_classes = wrapper_classes|merge([background_color]) %}
{% endif %}
{% if bg_edge2edge %}
  {% set wrapper_classes = wrapper_classes|merge(['bg-edge2edge']) %}
{% endif %}

{% set bg_src = '' %}
{% if background_image is iterable %}
  {% set img = background_image %}
  {% if background_image[0] is defined and (background_image.src is not defined and background_image.url is not defined and background_image.uri is not defined) %}
    {% set img = background_image[0] %}
  {% endif %}
  {% set bg_src = img.src|default(img.url|default(img.uri|default(''))) %}
{% elseif background_image is not empty %}
  {% set bg_src = background_image %}
{% endif %}

{% if bg_src starts with 'public://' or bg_src starts with 'private://' %}
  {% set bg_src = file_url(bg_src) %}
{% endif %}

{% set wrapper_style = '' %}
{% if bg_src|trim %}
  {% set base_bg = "url('" ~ bg_src|e('css') ~ "')" %}
  {% set has_overlay = overlay_color != 'none' and (overlay_opacity|default(0) + 0) > 0 %}
  {% if has_overlay %}
    {% set alpha = (overlay_opacity + 0) / 100 %}
    {% set rgb = overlay_color == 'light' ? '255,255,255' : '0,0,0' %}
    {% set overlay = 'linear-gradient(rgba(' ~ rgb ~ ',' ~ alpha ~ '), rgba(' ~ rgb ~ ',' ~ alpha ~ '))' %}
    {% set wrapper_style = 'background-image: ' ~ overlay ~ ', ' ~ base_bg ~ '; background-size: cover; background-position: center;' %}
  {% else %}
    {% set wrapper_style = 'background-image: ' ~ base_bg ~ '; background-size: cover; background-position: center;' %}
  {% endif %}
{% endif %}

{% set block_content %}{% block content %}{% endblock %}{% endset %}

<div class="{{ wrapper_classes|join(' ') }}"{% if wrapper_style %} style="{{ wrapper_style|raw }}"{% endif %}>
  {% if container_type != 'none' %}
    <div class="{{ container_type }}">
      <div {{ attributes.addClass(row_classes) }}>
        {{ block_content }}
      </div>
    </div>
  {% else %}
    <div {{ attributes.addClass(row_classes) }}>
      {{ block_content }}
    </div>
  {% endif %}
</div>
