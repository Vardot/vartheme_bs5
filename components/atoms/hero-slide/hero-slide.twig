{#
  Hero Slide (Bootstrap 5)

  Intended use:
  - Place multiple "Hero Slide" components inside "Hero Slider (Container)" slot.

  Container context variables used:
  - hero_slider_media_position (default media position)
  - hero_slider_container_type (content width for overlay slides)
#}

{{ attach_library('vartheme_bs5/framework') }}

{% macro media_src(media) %}
  {% if media is iterable %}
    {% if media.src is defined and media.src %}
      {{ media.src }}
    {% elseif media.url is defined and media.url %}
      {{ media.url }}
    {% elseif media.uri is defined and media.uri %}
      {{ media.uri }}
    {% else %}
      {{ '' }}
    {% endif %}
  {% else %}
    {{ '' }}
  {% endif %}
{% endmacro %}

{% set enabled_res = enabled is defined ? enabled : true %}
{% if enabled_res in [true, 1, '1', 'true', 'TRUE', 'on', 'yes'] %}
  {#
    Media position can be controlled at two levels:
    - Container default (hero_slider_media_position)
    - Per-slide override (media_position)
  #}
  {% set mp_from_container = hero_slider_media_position|default('overlay') %}
  {% set mp = mp_from_container %}
{% set mp = mp|trim|lower %}
  {% if media_position is defined and media_position and media_position != 'inherit' %}
    {% set mp = media_position %}
  {% endif %}

  {# Normalize media position values from Canvas (trim + aliases). #}
  {% set mp = mp|trim %}
  {% if mp in ['no_media','no-media','nomedia'] %}{% set mp = 'none' %}{% endif %}
  {# Per-slide presentation settings (managed inside this component). #}
  {% set bg_color = background_color|default(mp == 'overlay' ? 'bg-transparent' : 'bg-white') %}
  {% set gap = split_gap|default('md') %}
  {% set container_type = hero_slider_container_type|default('none') %}
  {% set pad_x = content_padding_x|default('px-0') %}
  {% set pad_y = content_padding_y|default('py-0') %}
  {% if mp == 'overlay' %}{% set pad_x = 'px-0' %}{% set pad_y = 'pt-4 pt-lg-0 pb-4 pb-lg-0' %}{% elseif mp == 'none' %}{% set pad_x = 'px-0' %}{% set pad_y = 'py-4' %}{% endif %}
  {#
    Split layout content horizontal padding:
    - For media position START (image left), desktop wants some breathing room,
      but on responsive we should avoid extra left/right padding.
    - Apply padding only from lg and up.
  #}
  {% if mp == 'start' and (pad_x == 'px-0') %}{% set pad_x = 'px-0 px-lg-4' %}{% endif %}
  {% if mp != 'overlay' and (pad_y == 'py-0') %}{% set pad_y = 'py-3 py-lg-5' %}{% endif %}
  {% set title_tag_res = title_tag|default('h2') %}
  {% set title_size_res = title_size|default('display-5') %}
  {% set content_size_res = content_size|default('fs-6') %}
  {% set overlay_bg_res = overlay_bg|default('bg-dark') %}
  {% set overlay_opacity_res = overlay_opacity|default('opacity-50') %}
  {% set object_pos = object_position|default('center') %}
  {% set img_fit = image_fit|default('cover') %}
  {% set h_align = horizontal_alignment|default('start') %}
  {% set v_align = vertical_alignment|default('center') %}
  {% set text_align_res = text_align|default('text-start') %}
  {% set text_color_res = text_color|default(mp == 'overlay' ? 'text-white' : 'text-dark') %}
  {% set max_w = content_max_width|default('normal') %}

  {# Default content if fields are blank (requested). #}
  {% set title_final = (title is defined ? title : '')|trim %}
  {% if title_final == '' %}{% set title_final = 'Varbase; better than ever' %}{% endif %}

  {% set button_text_final = (button_text is defined ? button_text : '')|trim %}
  {% if button_text_final == '' %}{% set button_text_final = 'Learn more' %}{% endif %}

  {% set button_url_final = (button_url is defined ? button_url : '')|trim %}
  {% if button_url_final == '' %}{% set button_url_final = '#' %}{% endif %}


  {% set justify_map = { start: 'justify-content-start', center: 'justify-content-center', end: 'justify-content-end' } %}
  {% set align_map = { start: 'align-items-start', center: 'align-items-center', end: 'align-items-end' } %}

  {% set content_wrap_class = (mp == 'none') ? 'position-relative w-100 h-100' : 'position-absolute top-0 start-0 w-100 h-100' %}
  {% set width_map = { narrow: 'col-lg-5', normal: 'col-lg-6', wide: 'col-lg-7' } %}
  {% set gap_map = { none: 'g-0', sm: 'g-2', md: 'g-3', lg: 'g-4' } %}

  {#
    Container behavior:
    - Overlay: caption content can use container/container-fluid.
    - Split (image left/right): this slide must be container-width, regardless of outer slider width.
      So we don't use an inner container for the caption; we wrap the whole split slide in `.container`.
  #}
  {% set content_container_class = '' %}
  {% if (mp == 'overlay' or mp == 'none') and container_type == 'container' %}
    {% set content_container_class = 'container' %}
  {% elseif (mp == 'overlay' or mp == 'none') and container_type == 'container-fluid' %}
    {% set content_container_class = 'container-fluid' %}
  {% else %}
    {# overlay fallback: keep readable width #}
    {% set content_container_class = (mp == 'overlay' or mp == 'none') ? 'container' : '' %}
  {% endif %}

  {% set overlay_classes = '' %}
  {% if mp == 'overlay' and overlay_bg_res != 'none' %}
    {% set overlay_classes = overlay_bg_res ~ ' ' ~ overlay_opacity_res %}
  {% endif %}

  {% set src_final = _self.media_src(media) %}
{% set src_final = src_final|trim %}

{# HARD no-media override #}
{% if mp == 'none' %}
  {% set src_final = '' %}
{% endif %}
  {# Fix placeholder asset paths: resolve relative assets/.. to an absolute URL for Canvas + Frontend. #}
{% if src_final and (src_final starts with 'assets/') %}
  {% if componentMetadata is defined and componentMetadata.path is defined %}
    {# Canvas/SDC: component path is available #}
    {% set src_final = (base_path|default('/')) ~ componentMetadata.path ~ '/' ~ src_final %}
  {% elseif directory is defined %}
    {# Frontend fallback: build the absolute theme path to this component #}
    {% set src_final = (base_path|default('/')) ~ directory ~ '/components/atoms/hero-slider/hero-slide/' ~ src_final %}
  {% endif %}
{% endif %}

  {% set has_media = src_final|default('')|trim ? true : false %}
  {% set alt_final = (media.alt is defined and media.alt) ? media.alt : (title_final ? title_final : 'Slide image') %}

  <div class="carousel-item{{ active ? ' active' : '' }}{% if extra_classes|default('')|trim %} {{ extra_classes|trim }}{% endif %}" data-hero-slide data-hero-layout="{{ mp }}">
    <div class="hero-slider__item position-relative w-100 {{ mp != 'overlay' ? bg_color : '' }}">

      {% if mp == 'overlay' or mp == 'none' %}
        {% if src_final %}
          {% if src_final %}
<img class="d-block w-100 h-100 hero-slider__img hero-slider__img-fit-{{ img_fit }} hero-slider__img-pos-{{ object_pos }}"
            src="{{- src_final|trim -}}"
            alt="{{ alt_final|e('html_attr') }}"
            loading="lazy"
            decoding="async"/>
{% endif %}
        {% else %}
          {% if mp == 'none' %}
          {# No-media text-only: background comes from bg_color on .hero-slider__item #}
        {% else %}
          <div class="position-absolute top-0 start-0 w-100 h-100 bg-black" aria-hidden="true"></div>
        {% endif %}
        {% endif %}

        {% if mp != 'none' %}
        <div class="hero-slider__overlay-gradient" aria-hidden="true"></div>
        {% endif %}

        {% if overlay_classes %}
          <div class="position-absolute top-0 start-0 w-100 h-100 {{ overlay_classes }}" aria-hidden="true"></div>
        {% endif %}

        <div class="{{ content_wrap_class }} d-flex {{ justify_map[h_align] }} {{ align_map[v_align] }} hero-slider__content-wrap">
          <div class="w-100 {{ pad_y }}">
            <div class="{{ content_container_class }}">
              <div class="row g-0">
                <div class="col-12 {{ width_map[max_w] }}">
                  <div class="hero-slider__caption {{ text_align_res }} {{ text_color_res }}">
                    {% if title_final %}
                      <{{ title_tag_res }} class="hero-slider__title {{ title_size_res }} mb-3">{{ title_final }}</{{ title_tag_res }}>
                    {% endif %}
                    {% if content %}
                      <div class="hero-slider__text {{ content_size_res }}">{{ content|raw }}</div>
                    {% endif %}
                    {% if button_text_final and button_url_final %}
                      <div class="mt-3">
                        <a class="btn {{ button_variant|default('btn-primary') }}" href="{{ button_url_final }}">{{ button_text_final }}</a>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      {% else %}
        {# Split layout (image left/right) - always container width per slide. #}
        <div class="h-100">
          <div class="container h-100">
            <div class="row h-100 align-items-stretch {{ gap_map[gap] }}">
            {% set img_col = 'col-12 col-lg-6' %}
            {% set text_col = 'col-12 col-lg-6 d-flex' %}

            {% set img_block %}
              <div class="h-100 w-100 position-relative">
                {% if src_final %}
                  {% if src_final %}
<img class="d-block w-100 h-100 hero-slider__img hero-slider__img-fit-{{ img_fit }} hero-slider__img-pos-{{ object_pos }}"
                    src="{{- src_final|trim -}}"
                    alt="{{ alt_final|e('html_attr') }}"
                    loading="lazy"
                    decoding="async"/>
{% endif %}
                {% else %}
                  <div class="w-100 h-100 bg-black" aria-hidden="true"></div>
                {% endif %}
              </div>
            {% endset %}

            {% set text_block %}
              <div class="w-100 d-flex {{ justify_map[h_align] }} {{ align_map[v_align] }}">
                <div class="w-100 {{ pad_y }}">
                  <div class="{{ content_container_class }}">
                    <div class="row g-0">
                      <div class="col-12 {{ pad_x }}">
                        <div class="hero-slider__caption {{ text_align_res }} {{ text_color_res }}">
                          {% if title_final %}
                            <{{ title_tag_res }} class="hero-slider__title {{ title_size_res }} mb-3">{{ title_final }}</{{ title_tag_res }}>
                          {% endif %}
                          {% if content %}
                            <div class="hero-slider__text {{ content_size_res }}">{{ content|raw }}</div>
                          {% endif %}
                          {% if button_text_final and button_url_final %}
                            <div class="mt-3">
                              <a class="btn {{ button_variant|default('btn-primary') }}" href="{{ button_url_final }}">{{ button_text_final }}</a>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            {% endset %}

            {% if mp == 'start' %}
              <div class="{{ img_col }}">{{ img_block }}</div>
              <div class="{{ text_col }}">{{ text_block }}</div>
            {% else %}
              <div class="{{ text_col }}">{{ text_block }}</div>
              <div class="{{ img_col }}">{{ img_block }}</div>
            {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
