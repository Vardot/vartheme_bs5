{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the List component.
 *
 * HTML list with Bootstrap list helpers and utility classes.
 *
 * Available properties:
 * - items: An array of items to display in the list.
 * - type: List type as ordered or unordered list(ul/ol)
 * - list_utility_classes: Use to add extra Bootstrap utility classes or custom classes to the list component.
 * - list_item_utility_classes: Use to add extra Bootstrap utility classes or custom classes to list items.
 *
 * Available attributes:
 * - attributes: HTML attributes to apply to the list.
 *
 * Available slots:
 * - N/A
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{% apply spaceless %}
{% if items is iterable %}
  {# Variables: scalar props with schema defaults. #}
  {% set type = type ?? 'ul' %}
  {% set list_utility_classes = list_utility_classes ? list_utility_classes : [] %}
  {% set list_item_utility_classes = list_item_utility_classes ? list_item_utility_classes : [] %}

  {# Logic: merge list classes as arrays. #}
  {% set attributes = attributes.addClass(list_utility_classes) %}

  {% if not list_item_attributes %}
    {% set list_item_attributes = create_attribute() %}
  {% endif %}
  {% set list_item_attributes = list_item_attributes.addClass(list_item_utility_classes) %}

  {# Print the HTML. #}
  <{{ type }}{{ attributes }}>
    {% for item in items %}
      <li{{ list_item_attributes }}>{{ item }}</li>
    {% endfor %}
  </{{ type }}>
{% endif %}
{% endapply %}
