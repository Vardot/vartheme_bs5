{% stories List with {
  title: 'Atoms/List',
  parameters: {
    componentSubtitle: 'HTML List component with Bootstrap utility class support.',
    docs: {
      description: {
        component: 'Renders a list (ul or ol) with optional utility classes on the wrapper and each list item.',
      },
      story: {
        inline: true,
      },
    },
  },
  argTypes: {
    type: {
      name: 'List type',
      description: 'The HTML tag to use for the list (ul or ol).',
      defaultValue: 'ul',
      control: 'select',
      options: {
        "'Unordered list'": 'ul',
        "'Ordered list'": 'ol',
      },
    },
    items: {
      name: 'Items',
      description: 'An array of list items to render as a list.',
      control: 'object',
      defaultValue: [],
    },
    list_utility_classes: {
      name: 'List Utility Classes',
      description: 'Extra Bootstrap or custom classes for the list element.',
      control: 'object',
      defaultValue: [],
    },
    list_item_utility_classes: {
      name: 'List Item Utility Classes',
      description: 'Classes applied to each list item element.',
      control: 'object',
      defaultValue: [],
    },
    attributes: {
      name: 'Attributes',
      description: 'HTML attributes for the list element.',
      control: 'object',
      defaultValue: {},
    },
  },
} %}

