{% set type = type|default('dark') %}

{% set blockquote_classes = [
  'blockquote',
  'd-flex',
  'flex-column',
  'align-items-start',
  'w-100',
  'border-start',
  'border-2',
  'ps-4',
  'gap-2',
  (type == 'light') ? 'text-white' : 'text-dark',
  (type == 'light') ? 'border-light' : 'border-secondary',
]|join(' ') %}

{% set p_classes = 'mb-0 fst-italic fw-bold fs-4' %}
{% set footer_classes = 'mb-0' %}
{% set cite_classes = 'd-block fst-normal fw-normal fs-6 mb-0' %}

<blockquote class="{{ blockquote_classes }}" data-type="{{ type|e }}">
  <p class="{{ p_classes }}">{{ text }}</p>

  {% if cite_text is not empty %}
    <footer class="{{ footer_classes }}">
      <cite title="{{ cite_text }}" class="{{ cite_classes }}">{{ cite_text }}</cite>
    </footer>
  {% endif %}
</blockquote>
