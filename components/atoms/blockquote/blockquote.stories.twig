---
{% stories Blockquote with {
  "title": "Base/Blockquote",
  "parameters": {
    "componentSubtitle": "Bootstrap Blockquote component",
    "docs": {
      "description": {
        "component": "Blockquote component with light/dark variants using Bootstrap utilities."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "type": {
      "name": "Type",
      "description": "Color style of the blockquote.",
      "defaultValue": "dark",
      "control": "select",
      "options": {
        "Dark": "dark",
        "Light": "light"
      }
    },
    "text": {
      "name": "Quote text",
      "description": "The main content of the blockquote.",
      "defaultValue": "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
      "control": "text"
    },
    "cite_text": {
      "name": "Quotee Name and Position",
      "description": "Name and role, organization, or source of the quote.",
      "defaultValue": "Quotee Name and Position",
      "control": "text"
    }
  }
} %}

{% story DefaultDark with {
  "name": "Default (Dark)",
  "args": {
    "type": "dark",
    "text": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc non sapien lacinia, pellentesque elit sit amet, tempor orci.",
    "cite_text": "Quotee Name and Position"
  }
} %}
{{ include('vartheme_bs5:blockquote') }}
{% endstory %}

