{% stories RichText with {
  "title": "Base/Rich Text",
  "parameters": {
    "componentSubtitle": "Bootstrap Rich Text component with optional trim controls",
    "docs": {
      "description": {
        "component": "Renders trusted HTML with trim and strip HTML behavior tied together."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "text": {
      "name": "Content (rich text)",
      "description": "HTML content.",
      "defaultValue": "<p><strong>Hello</strong> from rich text.</p>",
      "control": "text"
    },
    "trim": {
      "name": "Trim",
      "description": "Enable smart trimming.",
      "defaultValue": false,
      "control": "boolean"
    },
    "trim_length": {
      "name": "Trim length",
      "description": "Number of characters or words to keep.",
      "defaultValue": 120,
      "control": { "type": "number", "min": 0 }
    },
    "trim_units": {
      "name": "Trim units",
      "description": "Choose whether trim length uses characters or words.",
      "defaultValue": "characters",
      "control": { "type": "select" },
      "options": ["characters", "words"]
    },
    "suffix": {
      "name": "Suffix",
      "description": "Text appended when content is trimmed.",
      "defaultValue": "...",
      "control": "text"
    },
    "strip_html": {
      "name": "Strip HTML",
      "description": "Only works when Trim is enabled.",
      "defaultValue": false,
      "control": "boolean"
    }
  }
} %}

{% story Default with {
  "name": "Default",
  "args": {
    "text": "<p><strong>Hello</strong> from rich text.</p><p class=\"mb-0\">You can include basic HTML like <em>emphasis</em>, <a href=\"#\">links</a>, and lists.</p>",
    "trim": false,
    "trim_length": 120,
    "trim_units": "characters",
    "suffix": "...",
    "strip_html": false
  }
} %}
{{ include('vartheme_bs5:rich-text') }}
{% endstory %}

{% story TrimWithStripHtml with {
  "name": "Trim With Strip HTML",
  "args": {
    "text": "<p><strong>Hello</strong> from rich text.</p><p class=\"mb-0\">You can include basic HTML like <em>emphasis</em>, <a href=\"#\">links</a>, and lists.</p>",
    "trim": true,
    "trim_length": 12,
    "trim_units": "words",
    "suffix": "...",
    "strip_html": true
  }
} %}
{{ include('vartheme_bs5:rich-text') }}
{% endstory %}

{% story TrimWithoutStripHtml with {
  "name": "Trim Without Strip HTML",
  "args": {
    "text": "<p><strong>Hello</strong> from rich text.</p><p class=\"mb-0\">This keeps HTML output while trimming is enabled.</p>",
    "trim": true,
    "trim_length": 8,
    "trim_units": "words",
    "suffix": "...",
    "strip_html": false
  }
} %}
{{ include('vartheme_bs5:rich-text') }}
{% endstory %}

{% endstories %}
