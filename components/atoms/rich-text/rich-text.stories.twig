{% stories RichText with {
  "title": "Base/Rich Text",
  "parameters": {
    "componentSubtitle": "Bootstrap Rich Text component with optional smart trimming",
    "docs": {
      "description": {
        "component": "Renders **trusted HTML** and supports optional smart trim settings."
      },
      "story": {
        "inline": true
      }
    }
  },
  "argTypes": {
    "text": {
      "name": "Content (rich text)",
      "description": "HTML content rendered with `|raw` when trimming is disabled.",
      "defaultValue": "<p><strong>Hello</strong> from rich text.</p>",
      "control": "text"
    },
    "trim_length": {
      "name": "Trim length",
      "description": "Number of characters or words to keep. Set 0 to disable trimming.",
      "defaultValue": 0,
      "control": { "type": "number", "min": 0 }
    },
    "trim_units": {
      "name": "Trim units",
      "description": "Choose whether trim length uses characters or words.",
      "defaultValue": "characters",
      "control": { "type": "select" },
      "options": ["characters", "words"]
    },
    "suffix": {
      "name": "Suffix",
      "description": "Text appended when content is trimmed.",
      "defaultValue": "...",
      "control": "text"
    },
    "strip_html": {
      "name": "Strip HTML",
      "description": "Remove HTML tags before trimming and output.",
      "defaultValue": false,
      "control": "boolean"
    }
  }
} %}

{% story Default with {
  "name": "Default",
  "args": {
    "text": "<p><strong>Hello</strong> from rich text.</p><p class=\"mb-0\">You can include basic HTML like <em>emphasis</em>, <a href=\"#\">links</a>, and lists.</p>",
    "trim_length": 0,
    "trim_units": "characters",
    "suffix": "...",
    "strip_html": false
  }
} %}
{{ include('vartheme_bs5:rich-text') }}
{% endstory %}

{% story TrimByCharacters with {
  "name": "Trim by characters",
  "args": {
    "text": "<p><strong>Hello</strong> from rich text.</p><p class=\"mb-0\">You can include basic HTML like <em>emphasis</em>, <a href=\"#\">links</a>, and lists.</p>",
    "trim_length": 60,
    "trim_units": "characters",
    "suffix": "...",
    "strip_html": true
  }
} %}
{{ include('vartheme_bs5:rich-text') }}
{% endstory %}

{% story TrimByWords with {
  "name": "Trim by words",
  "args": {
    "text": "<p class=\"mb-0\">A longer paragraph for word trimming. It contains multiple words so you can preview how the smart trimmed output behaves.</p>",
    "trim_length": 12,
    "trim_units": "words",
    "suffix": "...",
    "strip_html": true
  }
} %}
{{ include('vartheme_bs5:rich-text') }}
{% endstory %}

{% endstories %}
