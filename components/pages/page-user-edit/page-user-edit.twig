{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the main page.
 * Available config:
 *  - is_front: true | false -> to determine if page is front or not
 */
#}

<div id="page" class="page d-flex flex-column">

  {% if page.header %}
    <header role="banner">
      {% if container_header %}
        <div class="{{ container_header }}">
      {% endif %}
      {{ page.header }}
      {% if container_header %}
        </div>
      {% endif %}
    </header>
  {% endif %}

  <main class="mb-3">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    {% if page.content %}
      <div class="container">
        <div class="row justify-content-center">
          <div id="auth-box" class="user-edit col-10 col-sm-6">
            <div id="top-part">
              {{ include('vartheme_bs5:heading', {
                  html_tag: 'h1',
                  content: 'Edit account'|t,
                }
              , false) }}
            </div>
            <div id="middle-part">
              {{ page.content }}
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </main>

  {% if page.footer %}
    <footer class="footer" role="contentinfo">
      {% if container_footer %}
        <div class="{{ container_footer }}">
      {% endif %}
      {{ page.footer }}
      {% if container_footer %}
        </div>
      {% endif %}
    </footer>
  {% endif %}

</div>
