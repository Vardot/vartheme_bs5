{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the Page User Password component.
 * Available config:
 *  - is_front: true | false -> to determine if page is front or not
 */
#}

{# AI guidance:
 # - Do not alter property descriptions or existing logic unless new
 #   properties are added.
 # - Keep the structure: 1) variables, 2) logical variable manipulations,
 #   3) print the HTML.
 # - Always handle classes as arrays with `merge` (never string
 #   concatenation) to avoid duplicate classes and data type conflicts.
 #}

{# Variables: region container classes passed in from preprocess. #}
{% set container_header = container_header|default('') %}
{% set container_footer = container_footer|default('') %}

{# Logic: build class lists as arrays (merge, never concatenation). #}
{% set page_classes = ['page', 'd-flex', 'flex-column'] %}
{% set main_classes = ['mb-3'] %}
{% set main_container_classes = ['main-container', 'container'] %}
{% set row_classes = ['row', 'justify-content-center'] %}
{% set auth_box_classes = ['user-password', 'col-10', 'col-sm-7', 'col-lg-5', 'col-xl-4'] %}
{% set footer_classes = ['footer'] %}

{# Print the HTML. #}
<div id="page" class="{{ page_classes|join(' ') }}">

  {% if page.header %}
    <header role="banner">
      {% if container_header %}
        <div class="{{ container_header }}">
      {% endif %}
      {{ page.header }}
      {% if container_header %}
        </div>
      {% endif %}
    </header>
  {% endif %}

  <main class="{{ main_classes|join(' ') }}">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div role="main" class="{{ main_container_classes|join(' ') }}">
      <div class="{{ row_classes|join(' ') }}">
        <div id="auth-box" class="{{ auth_box_classes|join(' ') }}">
          <div id="top-part">
            {{ include('vartheme_bs5:heading', {
                html_tag: 'h1',
                content: 'Reset password'|t,
              }
            , false) }}
          </div>
          <div id="middle-part">
            {% if logged_in %}
              {{ include('vartheme_bs5:page-better-login', {without_blocks: logged_in_without_blocks}) }}
            {% else %}
              {{ include('vartheme_bs5:page-better-login', {without_blocks: not_logged_in_without_blocks}) }}
            {% endif %}
            {{ page.content }}
          </div>
          <div id="bottom-part">
          {% if not logged_in %}
            <div class="login-link">
              <a href="{{ path('user.login') }}">{{ include('vartheme_bs5:icon', {icon: 'bi-box-arrow-in-right', rtl: 'bi-box-arrow-in-left', lang_dir: lang_dir}, false) }} {{ 'Login'|t }}</a>
            </div>
          {% endif %}
          {% if not logged_in and not user_settings_register_admin_only %}
            <div class="register-link">
              <a href="{{ path('user.register') }}">{{ include('vartheme_bs5:icon', {icon: 'bi-person-fill'}, false) }} {{ 'Register a new account'|t }}</a>
            </div>
          {% endif %}
            <div class="back-link">
              <a href="{{ url('<front>') }}">{{ include('vartheme_bs5:icon', {icon: 'bi-house-door-fill'}, false) }} {{ 'Back to'|t }}  {{ site_name }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  {% if page.footer %}
    <footer class="{{ footer_classes|join(' ') }}" role="contentinfo">
      {% if container_footer %}
        <div class="{{ container_footer }}">
      {% endif %}
      {{ page.footer }}
      {% if container_footer %}
        </div>
      {% endif %}
    </footer>
  {% endif %}

</div>
