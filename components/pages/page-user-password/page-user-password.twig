{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the main page.
 * Available config:
 *  - is_front: true | false -> to determine if page is front or not
 */
#}

<div id="page" class="page d-flex flex-column">

  {% if page.header %}
    <header role="banner">
      {% if container_header %}
        <div class="{{ container_header }}">
      {% endif %}
      {{ page.header }}
      {% if container_header %}
        </div>
      {% endif %}
    </header>
  {% endif %}

  <main class="mb-3">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div role="main" class="main-container container">
      <div class="row justify-content-center">
        <div id="auth-box" class="user-password col-10 col-sm-7 col-lg-5 col-xl-4">
          <div id="top-part">
            {{ include('vartheme_bs5:heading', {
                html_tag: 'h1',
                content: 'Reset password'|t,
              }
            , false) }}
          </div>
          <div id="middle-part">
            {% if logged_in %}
              {{ include('vartheme_bs5:page-better-login', {without_blocks: logged_in_without_blocks}) }}
            {% else %}
              {{ include('vartheme_bs5:page-better-login', {without_blocks: not_logged_in_without_blocks}) }}
            {% endif %}
            {{ page.content }}
          </div>
          <div id="bottom-part">
          {% if not logged_in %}
            <div class="login-link">
              <a href="{{ path('user.login') }}">{{ include('vartheme_bs5:icon', {icon: 'bi-box-arrow-in-right', rtl: 'bi-box-arrow-in-left', lang_dir: lang_dir}, false) }} {{ 'Login'|t }}</a>
            </div>
          {% endif %}
          {% if not logged_in and not user_settings_register_admin_only %}
            <div class="register-link">
              <a href="{{ path('user.register') }}">{{ include('vartheme_bs5:icon', {icon: 'bi-person-fill'}, false) }} {{ 'Register a new account'|t }}</a>
            </div>
          {% endif %}
            <div class="back-link">
              <a href="{{ url('<front>') }}">{{ include('vartheme_bs5:icon', {icon: 'bi-house-door-fill'}, false) }} {{ 'Back to'|t }}  {{ site_name }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  {% if page.footer %}
    <footer class="footer" role="contentinfo">
      {% if container_footer %}
        <div class="{{ container_footer }}">
      {% endif %}
      {{ page.footer }}
      {% if container_footer %}
        </div>
      {% endif %}
    </footer>
  {% endif %}

</div>
