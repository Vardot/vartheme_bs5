{#
/**
 * @file
 * Vartheme BS5 Starter Kit implementation for the main page.
 * Available config:
 *  - is_front: true | false -> to determine if page is front or not
 */
#}

<div class="page d-flex flex-column">

  {{ include('vartheme_bs5:page-header') }}

  <main class="mb-3">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div role="main" class="main-container container">
      <div class="row justify-content-center">
        <div id="auth-box" class="reset-password col-10 col-sm-7 col-lg-5 col-xl-4">
          <div id="top-part">
            {{ include('vartheme_bs5:heading', {
                html_tag: 'h1',
                content: 'Reset password'|t,
              }
            , false) }}
          </div>
          <div id="middle-part">
            {% if logged_in %}
              {{ include('vartheme_bs5:page-better-login', {without_blocks: logged_in_without_blocks}) }}
            {% else %}
              {{ include('vartheme_bs5:page-better-login', {without_blocks: not_logged_in_without_blocks}) }}
            {% endif %}
            {{ page.content }}
          </div>
          <div id="bottom-part">
            <div class="back-link">
              <a href="{{ url('<front>') }}">{{ include('vartheme_bs5:icon', {icon: 'house-door-fill'}, false) }} {{ 'Back to'|t }}  {{ site_name }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  {{ include('vartheme_bs5:page-footer') }}

</div>
