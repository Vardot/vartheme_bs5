{
  "name": "vartheme_bs5",
  "description": "Starterkit theme for Varbase standard websites. Based on Bootstrap 5 framework using SASS.",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "scripts": {
    "theme:init": "webpack --progress --config  webpack.config.init.js ; node bootstrap.fixer.js ; stylelint \"**/*.css\" --fix",
    "theme:build": "webpack --progress --config webpack.config.build.js ; stylelint \"css/**/*.css\" --fix",
    "theme:full-build": "yarn theme:build ; yarn components:build ; stylelint \"**/*.css\" --fix",
    "theme:watch": "webpack --progress --config webpack.config.dev.js --watch",
    "components:build": "webpack --progress --config webpack.config.components.js ; stylelint \"components/**/*.css\" --fix",
    "bootstrap:fixer": "node bootstrap.fixer.js",
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "cucumber-js --config cucumber.js"
  },
  "license": "GPL-2.0-or-later",
  "keywords": [
    "drupal",
    "webpack",
    "bootstrap",
    "Vartheme",
    "Vartheme BS5",
    "Varbase Theme (Bootstrap 5 - SASS)",
    "frontend"
  ],
  "peerDependencies": {
    "@popperjs/core": "^2.11.8"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "~7",
    "@babel/preset-env": "^7.26.0",
    "@cucumber/cucumber": "^12.0.0",
    "@cucumber/pretty-formatter": "^1.0.1",
    "@fortawesome/fontawesome-free": "~5",
    "@popperjs/core": "~2",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "bootstrap": "~5",
    "bootstrap-borders-utilities": "1.0.2",
    "bootstrap-icons": "~1",
    "bootstrap-ratio-utilities": "~1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "~11.0.0",
    "core-js": "^3.39.0",
    "cspell": "^8.16.1",
    "css-loader": "^7.1.2",
    "dotenv": "^16.4.7",
    "dotenv-safe": "^9.1.0",
    "dotenv-webpack": "^8.1.0",
